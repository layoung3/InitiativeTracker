[Unit]
Description=InitiativeTracker Hub
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=initiativetracker
Group=initiativetracker
WorkingDirectory=/opt/initiativetracker/current
Environment=ASPNETCORE_ENVIRONMENT=Production
ExecStart=/opt/initiativetracker/current/InitiativeTracker.Web

Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/initiativetracker

[Install]
WantedBy=multi-user.target
