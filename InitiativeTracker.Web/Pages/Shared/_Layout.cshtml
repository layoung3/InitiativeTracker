@inject InitiativeTracker.Web.Services.BrandingService Branding
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @Branding.ApplicationName</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/InitiativeTracker.Web.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet" href="~/css/branding.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body data-media-live="@User.Identity?.IsAuthenticated.ToString().ToLowerInvariant()">
    @* Kiosk-only escape hatch. Setup itself stays loopback restricted. *@
    @if (Context.Connection.RemoteIpAddress is System.Net.IPAddress remote &&
         System.Net.IPAddress.IsLoopback(remote) &&
         !Context.Request.Path.StartsWithSegments("/setup"))
    {
        <div class="position-fixed bottom-0 end-0 m-2" style="z-index: 1050;">
            <a href="/setup" class="btn btn-sm btn-dark border border-light opacity-75"
               title="Return to hub setup">Hub Setup</a>
        </div>
    }
    <div class="app-shell">

        <main class="app-main"
              role="main">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/media.js" asp-append-version="true"></script>
</body>
</html>
