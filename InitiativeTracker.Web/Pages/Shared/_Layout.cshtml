@inject InitiativeTracker.Web.Services.BrandingService Branding
@inject InitiativeTracker.Web.Infrastructure.ITrustedBrowserOrigin SecureOrigin
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @Branding.ApplicationName</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/InitiativeTracker.Web.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet" href="~/css/branding.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body data-media-live="@User.Identity?.IsAuthenticated.ToString().ToLowerInvariant()">
    @* Kiosk-only escape hatch. Setup itself stays loopback restricted. *@
    @if (Context.Connection.RemoteIpAddress is System.Net.IPAddress remote &&
         System.Net.IPAddress.IsLoopback(remote) &&
         !Context.Request.Path.StartsWithSegments("/setup"))
    {
        <nav class="position-fixed bottom-0 end-0 m-3" style="z-index: 1050;" aria-label="Physical hub navigation">
            <a href="/setup" class="btn btn-lg btn-dark border border-light shadow"
               style="min-height: 48px; min-width: 120px;"
               title="Return to hub setup">Hub Setup</a>
        </nav>
    }
    @* Only an actual trusted physical HTTPS connection may display the secure
       approval overlay. Legacy HTTP gameplay never obtains physical authority. *@
    @if (SecureOrigin.Enabled && SecureOrigin.Physical(Context))
    {
        <dialog id="physicalApprovalOverlay" aria-labelledby="physicalApprovalTitle"
                style="max-width:min(92vw,600px);width:92vw;background:#111827;color:#f8fafc;border:2px solid #93c5fd;border-radius:16px;padding:1.5rem;box-shadow:0 12px 50px #0009;">
            <h2 id="physicalApprovalTitle" class="h4">Physical approval requested</h2>
            <p>Compare this browser reference to the requesting device before deciding.</p>
            <p id="physicalApprovalPurpose" role="status"></p>
            <p class="h5">Browser reference: <strong id="physicalApprovalReference" class="font-monospace"></strong></p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <button type="button" class="btn btn-success btn-lg flex-fill" id="physicalApproveButton" style="min-height:56px">Approve</button>
                <button type="button" class="btn btn-danger btn-lg flex-fill" id="physicalDenyButton" style="min-height:56px">Deny</button>
            </div>
            <p id="physicalApprovalError" role="alert" class="mt-3"></p>
        </dialog>
    }
    <div class="app-shell">

        <main class="app-main"
              role="main">
                        @if (SecureOrigin.Enabled && User.Identity?.IsAuthenticated == true)
            {
                <nav class="container py-2 small" aria-label="Private feature authorization">
                    <a href="@(SecureOrigin.Origin + "/secure-access")">Secure authorization for private images and character changes</a>
                </nav>
            }
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/media.js" asp-append-version="true"></script>
    @if (SecureOrigin.Enabled && SecureOrigin.Physical(Context))
    {
        <script src="~/js/physical-approval-overlay.js" asp-append-version="true" defer></script>
    }
</body>
</html>
