@page "/setup"
@model InitiativeTracker.Web.Pages.Setup.IndexModel
@{
    ViewData["Title"] = "Tracker Setup";
}
@section Styles {
    <link rel="stylesheet" href="~/css/setup.css" asp-append-version="true" />
}
<div class="setup-dashboard">
    <header class="setup-heading">
        <div><h1>Initiative Tracker</h1><p>Hub setup and quick access</p></div>
        <a href="/display" class="btn btn-primary">Open Display</a>
    </header>
    <div class="setup-grid">
        <section class="card"><div class="card-body">
            <h2>1 · Join private Wi-Fi</h2>
            @if (Model.HotspotJoinQrAvailable)
            {
                <img src="@Model.HotspotJoinQrDataUri" alt="Join hub private Wi-Fi" class="setup-qr" />
                <p>Scan when the private hotspot is active.</p>
            }
            else
            {
                <p class="alert alert-secondary">Private Wi-Fi QR unavailable. Check Network Status.</p>
            }
            <small>Local screen only. QR includes the Wi-Fi password.</small>
        </div></section>
        <section class="card"><div class="card-body">
            <h2>2 · Join the game</h2>
            <img src="@Model.PlayerQrDataUri" alt="Join this game as a player" class="setup-qr" />
            <p>Game code <strong class="font-monospace">@Model.Session.JoinCode</strong></p>
            <a href="/join" class="btn btn-outline-primary">Player Join</a>
        </div></section>
        <section class="card"><div class="card-body">
            <h2>DM access</h2>
            @if (Model.DmLoginUrl.Length > 0)
            { <img src="/setup/dm-qr" alt="Open DM login" class="setup-qr" /> }
            <p>PIN <strong class="font-monospace">@Model.Session.DmPin</strong></p>
            @if (Model.DmLoginUrl.Length > 0)
            { <a href="@Model.DmLoginUrl" class="btn btn-outline-primary">DM Login</a> }
            else { <p>Fresh DM login is blocked until trusted browser HTTPS is configured. Existing gameplay sessions remain available.</p> }
        </div></section>
        <section class="card"><div class="card-body">
            <h2>Connect a display</h2>
            <img src="@Model.DisplayQrDataUri" alt="Connect a display device" class="setup-qr" />
            <p>Scan on a satellite, laptop or display device.</p>
            <a href="@Model.DisplayPairingUrl" class="btn btn-outline-primary">Display Pairing</a>
        </div></section>
    </div>
    <section class="card setup-network"><div class="card-body">
        @if (Model.NetworkQrDataUri.Length > 0)
        { <img src="@Model.NetworkQrDataUri" alt="Open network status on your phone" class="setup-network-qr" /> }
        <div><h2>Network status and Wi-Fi setup</h2>
            @if (Model.NetworkAuthorityCode is not null)
            { <p>Secure network-control code (five minutes): <strong class="font-monospace">@Model.NetworkAuthorityCode</strong></p> }
            <p><strong>@Model.Network?.Connection</strong> · @(Model.Network?.Ipv4 ?? "No Wi-Fi address")</p>
            @if (Model.CoordinationEnabled)
            { <p>N8 administration requires a fresh trusted-HTTPS DM login and this independent physical network-control code. A legacy gameplay cookie is insufficient.</p> }
            else { <p>On the same network, scan to review status or join external Wi-Fi. DM login required.</p> }
            <p class="small text-break mb-0">@Model.NetworkPageUrl</p>
        </div>
        @if (Model.NetworkPageUrl.Length > 0)
        { <a href="@Model.NetworkPageUrl" class="btn btn-outline-primary">Open Network Status</a> }
        else { <p>Secure network administration is blocked until browser HTTPS is ready.</p> }
    </div></section>
</div>
