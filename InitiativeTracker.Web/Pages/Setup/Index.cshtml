@page "/setup"
@model InitiativeTracker.Web.Pages.Setup.IndexModel

@{
    ViewData["Title"] = "Tracker Setup";
}

<div class="container py-4"
     style="max-width: 700px;">

    <h1 class="mb-4">
        Initiative Tracker
    </h1>

    <div class="row g-3">

        <div class="col-md-6">

            <div class="card h-100">

                <div class="card-body">

                    <div class="text-muted mb-2">
                        Player Game Code
                    </div>

                    <div class="display-5
                        fw-bold
                        font-monospace">
                        @Model.Session.JoinCode
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="card h-100">

                <div class="card-body">

                    <div class="text-muted mb-2">
                        DM PIN
                    </div>

                    <div class="display-5
                        fw-bold
                        font-monospace">
                        @Model.Session.DmPin
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card mt-3">

        <div class="card-body">

            <h2 class="h5">
                Display Pairing
            </h2>

            <p class="text-muted">
                Use this link once on a satellite,
                laptop, or other display device.
            </p>

            <input type="text"
                   value="@Model.DisplayPairingUrl"
                   readonly
                   class="form-control
            font-monospace" />

        </div>

    </div>


    <div class="mt-3">

        <a href="/dm/login"
           class="btn btn-primary">
            DM Login
        </a>

    </div>

</div>