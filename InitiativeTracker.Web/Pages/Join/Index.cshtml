@page "/join"
@model InitiativeTracker.Web.Pages.Join.IndexModel

@{
    ViewData["Title"] = "Join Game";
}

<div class="container py-5"
     style="max-width: 480px;">

    <div class="card">

        <div class="card-body p-4">

            <h1 class="h3 mb-3">
                Join Game
            </h1>


            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>
            }


            @if (Model.TokenAccepted)
            {
                <div class="alert alert-success">
                    Game found. Enter your name to join.
                </div>
            }


            <form method="post">

                <input asp-for="JoinToken"
                       type="hidden" />


                @if (!Model.TokenAccepted &&
                     string.IsNullOrWhiteSpace(
                         Model.JoinToken))
                {
                    <div class="mb-3">

                        <label asp-for="JoinCode"
                               class="form-label">
                            Game Code
                        </label>

                        <input asp-for="JoinCode"
                               maxlength="6"
                               autocomplete="off"
                               class="form-control
                        form-control-lg
                        text-uppercase
                        font-monospace
                        text-center"
                               placeholder="ABC123" />

                    </div>
                }


                <div class="mb-3">

                    <label asp-for="PlayerName"
                           class="form-label">
                        Your Name
                    </label>

                    <input asp-for="PlayerName"
                           maxlength="40"
                           autocomplete="off"
                           class="form-control
                    form-control-lg"
                           placeholder="Logan" />

                </div>


                <button type="submit"
                        class="btn
                    btn-primary
                    btn-lg
                    w-100">
                    Join Game
                </button>

            </form>

        </div>

    </div>


    @if (!Model.TokenAccepted)
    {
        <div class="text-center
            text-muted
            small
            mt-3">
            You can also scan the QR code shown by the DM.
        </div>
    }

</div>