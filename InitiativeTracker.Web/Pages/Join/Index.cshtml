@page "/join"
@model InitiativeTracker.Web.Pages.Join.IndexModel

@{
    ViewData["Title"] = "Join Game";
}

<div class="container py-5"
     style="max-width: 480px;">

    <div class="card">

        <div class="card-body p-4">

            <h1 class="h3 mb-3">
                Join Game
            </h1>

            <p class="text-muted">
                Enter the game code shown on the
                initiative tracker.
            </p>

            <form method="post">

                <div class="mb-3">

                    <label asp-for="JoinCode"
                           class="form-label">
                        Game Code
                    </label>

                    <input asp-for="JoinCode"
                           maxlength="6"
                           autocomplete="off"
                           class="form-control
                    form-control-lg
                    text-uppercase
                    font-monospace
                    text-center"
                           placeholder="ABC123" />

                    <span asp-validation-for="JoinCode"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn
                    btn-primary
                    btn-lg
                    w-100">
                    Join
                </button>

            </form>

        </div>

    </div>

</div>