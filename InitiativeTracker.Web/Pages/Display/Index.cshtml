@page "/display"
@model InitiativeTracker.Web.Pages.Display.IndexModel

@{
    ViewData["Title"] = "Initiative";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/condition-badges.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/initiative-display.css"
          asp-append-version="true" />
}

<div class="initiative-display"
     id="initiativeDisplay">

    <template id="displayBrandTemplate"><partial name="_Brand" /></template>

    <div class="display-backdrop"
         aria-hidden="true"><img src="@InitiativeTracker.Web.Services.MediaPaths.CampaignBanner" class="tracker-campaign-backdrop" data-tracker-media alt="" /></div>

    <header class="initiative-header">

        <div class="initiative-header-status"
             id="roundDisplay">

            @if (Model.DisplayState.IsStarted)
            {
                <span class="display-status-label">
                    Round
                </span>

                <strong class="display-status-value">
                    @Model.DisplayState.Round
                </strong>
            }
            else
            {
                <span class="display-status-label">
                    Encounter
                </span>

                <strong class="display-status-value display-status-value--text">
                    Setup
                </strong>
            }

        </div>


        <div class="initiative-title"
             aria-hidden="true">

            <span class="initiative-title-mark"></span>

            <span>
                Initiative
            </span>

            <span class="initiative-title-mark"></span>

        </div>


        <div class="initiative-header-actions">

            <div class="initiative-header-status
                        initiative-header-status--end"
                 id="turnDisplay">

                @if (Model.DisplayState.IsStarted)
                {
                    <span class="display-status-label">
                        Turn
                    </span>

                    <strong class="display-status-value">
                        @if (Model.DisplayState.CurrentTurnNumber > 0)
                        {
                            @Model.DisplayState.CurrentTurnNumber
                            <span class="display-status-divider">/</span>
                            @Model.DisplayState.ActiveCombatantCount
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </strong>
                }

            </div>


            <button type="button"
                    class="display-theme-button display-fullscreen-button"
                    id="displayFullscreenButton"
                    aria-label="Toggle fullscreen"
                    title="Toggle fullscreen">

                <span aria-hidden="true">⛶</span>

            </button>


            <button type="button"
                    class="display-theme-button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#displayAppearancePanel"
                    aria-controls="displayAppearancePanel"
                    aria-label="Display appearance"
                    title="Display appearance">

                <span aria-hidden="true">◐</span>

            </button>

        </div>

    </header>


    <main id="initiativeList"
          class="initiative-list"
          tabindex="0"
          aria-label="Initiative order">

        @if (Model.DisplayState.Combatants.Count == 0)
        {
            <div class="empty-display">

                <partial name="_Brand" />

                <div class="empty-display-title">
                    Waiting for encounter
                </div>

                <div class="empty-display-detail">
                    The initiative order will appear here when combat begins.
                </div>

            </div>
        }
        else
        {
            foreach (var combatant in Model.DisplayState.Combatants)
            {
                <div class="initiative-row
                            @(combatant.IsCurrent ? "is-current" : "")
                            @(!combatant.IsActive ? "is-inactive" : "")"
                     data-combatant-id="@combatant.Id">

                    <div class="turn-indicator"
                         aria-hidden="true">

                        @if (combatant.IsCurrent)
                        {
                            <span>▶</span>
                        }

                    </div>


                    <div class="combatant-name">

                        <img src="@combatant.PortraitUrl" class="tracker-portrait tracker-portrait--combat tracker-display-portrait" data-tracker-media data-portrait-resource="@combatant.PortraitUrl" width="48" height="48" alt="Portrait of @combatant.Name" />

                        <div class="combatant-name-text">
                            @combatant.Name
                        </div>

                    </div>


                    @if (combatant.CurrentHp.HasValue ||
                         combatant.MaxHp.HasValue)
                    {
                        <div class="combatant-hp">

                            <span class="combatant-hp-label">
                                HP
                            </span>

                            <span class="combatant-hp-value">
                                @(combatant.CurrentHp?.ToString() ?? "—")
                                <span class="combatant-hp-divider">/</span>
                                @(combatant.MaxHp?.ToString() ?? "—")
                            </span>

                            @if (combatant.TemporaryHp.HasValue &&
                                 combatant.TemporaryHp.Value > 0)
                            {
                                <span class="combatant-temp-hp">
                                    +@combatant.TemporaryHp Temp
                                </span>
                            }

                        </div>
                    }

                </div>
            }
        }

    </main>


    <div class="display-connection-status"
         id="displayConnectionStatus"
         role="status"
         aria-live="polite">

        <span class="display-connection-dot"
              aria-hidden="true"></span>

        <span id="displayConnectionText">
            Connecting
        </span>

    </div>

</div>


<div class="offcanvas offcanvas-end display-appearance-panel"
     tabindex="-1"
     id="displayAppearancePanel"
     aria-labelledby="displayAppearancePanelLabel">

    <div class="offcanvas-header">

        <div>

            <h2 class="offcanvas-title h5 mb-1"
                id="displayAppearancePanelLabel">
                Display Appearance
            </h2>

            <div class="small text-body-secondary">
                Saved on this display.
            </div>

        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Close">
        </button>

    </div>


    <div class="offcanvas-body">

        <fieldset class="display-theme-fieldset">

            <legend class="display-theme-legend">
                Theme
            </legend>

            <div class="display-theme-grid">

                <label class="display-theme-option"
                       data-theme-preview="dark">

                    <input type="radio"
                           name="displayTheme"
                           value="dark"
                           data-display-theme-option />

                    <span class="display-theme-swatch">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                    <span class="display-theme-name">
                        Dark
                    </span>

                </label>


                <label class="display-theme-option"
                       data-theme-preview="light">

                    <input type="radio"
                           name="displayTheme"
                           value="light"
                           data-display-theme-option />

                    <span class="display-theme-swatch">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                    <span class="display-theme-name">
                        Light
                    </span>

                </label>


                <label class="display-theme-option"
                       data-theme-preview="parchment">

                    <input type="radio"
                           name="displayTheme"
                           value="parchment"
                           data-display-theme-option />

                    <span class="display-theme-swatch">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                    <span class="display-theme-name">
                        Parchment
                    </span>

                </label>


                <label class="display-theme-option"
                       data-theme-preview="arcane">

                    <input type="radio"
                           name="displayTheme"
                           value="arcane"
                           data-display-theme-option />

                    <span class="display-theme-swatch">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                    <span class="display-theme-name">
                        Arcane
                    </span>

                </label>


                <label class="display-theme-option"
                       data-theme-preview="infernal">

                    <input type="radio"
                           name="displayTheme"
                           value="infernal"
                           data-display-theme-option />

                    <span class="display-theme-swatch">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                    <span class="display-theme-name">
                        Infernal
                    </span>

                </label>


                <label class="display-theme-option"
                       data-theme-preview="frost">

                    <input type="radio"
                           name="displayTheme"
                           value="frost"
                           data-display-theme-option />

                    <span class="display-theme-swatch">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                    <span class="display-theme-name">
                        Frost
                    </span>

                </label>


                <label class="display-theme-option"
                       data-theme-preview="forest">

                    <input type="radio"
                           name="displayTheme"
                           value="forest"
                           data-display-theme-option />

                    <span class="display-theme-swatch">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                    <span class="display-theme-name">
                        Forest
                    </span>

                </label>


                <label class="display-theme-option"
                       data-theme-preview="blood-moon">

                    <input type="radio"
                           name="displayTheme"
                           value="blood-moon"
                           data-display-theme-option />

                    <span class="display-theme-swatch">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>

                    <span class="display-theme-name">
                        Blood Moon
                    </span>

                </label>

            </div>

        </fieldset>


        <hr />


        <div class="display-theme-note">
            A future DM control can use the same theme names and broadcast
            them to this display without changing the display markup.
        </div>

    </div>

</div>


@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/initiative-display.js"
            asp-append-version="true"></script>
}
