@page "/display/pair"
@model InitiativeTracker.Web.Pages.Display.PairModel

@{
    ViewData["Title"] = "Pair Display";
}

<div class="container py-3">

    <div class="tracker-waiting card">

        <div class="card-body
            text-center
            p-2">

            <partial name="_Brand" />

            <h1 class="h3 mb-4">
                Pair Display
            </h1>

            <p class="text-muted">
                On the DM device, open
                <strong>Connected Devices</strong>
                and approve this display.
            </p>


            <div class="text-muted mt-4">
                Pairing Code
            </div>

            <div class="display-2
                fw-bold
                font-monospace
                my-2">
                @Model.PairingRequest.PairingCode
            </div>


            <div id="pairingStatus"
                 class="mt-4" role="status" aria-live="polite">

                <div class="spinner-border
                    spinner-border-sm
                    me-2"
                     role="status">
                </div>

                Waiting for DM approval...

            </div>


            <form method="post"
                  asp-page-handler="Restart"
                  class="mt-4 d-none"
                  id="restartPairingForm">

                <button type="submit"
                        class="btn
                    btn-outline-primary">
                    Try Again
                </button>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/display-pairing.js"
            asp-append-version="true">
    </script>

}
