@page "/dm/devices"
@model InitiativeTracker.Web.Pages.Dm.DevicesModel

@{
    ViewData["Title"] = "Connected Devices";
}

<div class="container py-4">

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>
            <h1 class="mb-1">
                Connected Devices
            </h1>

            <div class="text-muted">
                Pair and manage tracker displays.
            </div>
        </div>

        <a href="/dm"
           class="btn btn-outline-secondary">
            Back to DM
        </a>

    </div>


    <div class="card mb-4">

        <div class="card-header">
            Pending Pairing
        </div>

        <div class="list-group
            list-group-flush">

            @if (Model.PendingRequests.Count == 0)
            {
                <div class="list-group-item
                    text-muted">
                    No devices waiting to pair.
                </div>
            }
            else
            {
                foreach (var request
                         in Model.PendingRequests)
                {
                    <div class="list-group-item">

                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            flex-wrap
                            gap-3">

                            <div>

                                <div class="fw-bold">
                                    @request.DeviceName
                                </div>

                                <div class="text-muted">
                                    Pairing code:
                                    <strong class="font-monospace">
                                        @request.PairingCode
                                    </strong>
                                </div>

                            </div>


                            <div class="d-flex gap-2">

                                <form method="post"
                                      asp-page-handler="Approve">

                                    <input type="hidden"
                                           name="id"
                                           value="@request.Id" />

                                    <button type="submit"
                                            class="btn
                                        btn-success">
                                        Approve
                                    </button>

                                </form>


                                <form method="post"
                                      asp-page-handler="Reject">

                                    <input type="hidden"
                                           name="id"
                                           value="@request.Id" />

                                    <button type="submit"
                                            class="btn
                                        btn-outline-danger">
                                        Reject
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>


    <div class="card">

        <div class="card-header">
            Paired Displays
        </div>

        <div class="list-group
            list-group-flush">

            @if (Model.Displays.Count == 0)
            {
                <div class="list-group-item
                    text-muted">
                    No displays paired yet.
                </div>
            }
            else
            {
                foreach (var device
                         in Model.Displays)
                {
                    <div class="list-group-item">

                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            flex-wrap
                            gap-3">

                            <form method="post"
                                  asp-page-handler="Rename"
                                  class="d-flex
                                gap-2
                                align-items-center">

                                <input type="hidden"
                                       name="id"
                                       value="@device.Id" />

                                <input type="text"
                                       name="name"
                                       value="@device.Name"
                                       class="form-control" />

                                <button type="submit"
                                        class="btn
                                    btn-outline-primary">
                                    Rename
                                </button>

                            </form>


                            <form method="post"
                                  asp-page-handler="Forget"
                                  onsubmit="return confirm('Forget this display? It will need to pair again.');">

                                <input type="hidden"
                                       name="id"
                                       value="@device.Id" />

                                <button type="submit"
                                        class="btn
                                    btn-outline-danger">
                                    Forget
                                </button>

                            </form>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>