@page "/dm"
@model InitiativeTracker.Web.Pages.Dm.IndexModel
@using InitiativeTracker.Core.Enums

@{
    ViewData["Title"] = "DM Controls";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">DM Controls</h1>
            <div class="text-muted">
                @if (Model.Encounter.IsStarted)
                {
                    <span>
                        Round @Model.Encounter.Round
                        ·
                        Current:
                        <strong>@Model.Encounter.CurrentCombatant?.Name</strong>
                    </span>
                }
                else
                {
                    <span>Encounter Setup</span>
                }
            </div>
        </div>

        <a href="/display"
           target="_blank"
           class="btn btn-outline-secondary">
            Open Display
        </a>
    </div>

    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    @if (!Model.Encounter.IsStarted)
    {
        <div class="card mb-4">
            <div class="card-header">
                Add Combatant
            </div>

            <div class="card-body">
                <form method="post"
                      asp-page-handler="AddCombatant">

                    <div class="row g-3 align-items-end">

                        <div class="col-md-4">
                            <label asp-for="CombatantName"
                                   class="form-label">
                                Name
                            </label>

                            <input asp-for="CombatantName"
                                   class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="Initiative"
                                   class="form-label">
                                Initiative
                            </label>

                            <input asp-for="Initiative"
                                   type="number"
                                   class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="CurrentHp"
                                   class="form-label">
                                Current HP
                            </label>

                            <input asp-for="CurrentHp"
                                   type="number"
                                   class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <label asp-for="MaxHp"
                                   class="form-label">
                                Max HP
                            </label>

                            <input asp-for="MaxHp"
                                   type="number"
                                   class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Add
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    }

    <div class="card mb-4">

        <div class="card-header d-flex justify-content-between">
            <span>Initiative</span>

            <span>
                @Model.Encounter.ActiveCombatantCount active
                /
                @Model.Encounter.Combatants.Count total
            </span>
        </div>

        <div class="list-group list-group-flush">

            @if (Model.Encounter.Combatants.Count == 0)
            {
                <div class="list-group-item text-muted">
                    No combatants added.
                </div>
            }
            else
            {
                var combatants = Model.Encounter.IsStarted
                    ? Model.Encounter.Combatants
                        .OrderBy(c => c.SortOrder)
                    : Model.Encounter.Combatants
                        .OrderByDescending(c => c.Initiative)
                        .ThenBy(c => c.SortOrder);

                foreach (var combatant in combatants)
                {
                    var isCurrent =
                        Model.Encounter.CurrentCombatantId
                        == combatant.Id;

                    <div class="list-group-item
                        @(isCurrent ? "list-group-item-primary" : "")
                        @(!combatant.IsActive ? "opacity-50" : "")">

                        <div class="d-flex
                            flex-column
                            flex-lg-row
                            justify-content-between
                            gap-3">

                            <div class="d-flex align-items-center gap-2">

                                <div style="width: 1.5rem;">
                                    @if (isCurrent)
                                    {
                                        <span>➜</span>
                                    }
                                </div>

                                <div>
                                    <div class="fw-bold fs-5">
                                        @combatant.Name
                                    </div>

                                    <div class="small text-muted">
                                        Initiative:
                                        @combatant.Initiative

                                        @if (combatant.Status ==
                                             CombatantStatus.Defeated)
                                        {
                                            <span class="badge text-bg-danger ms-2">
                                                Defeated
                                            </span>
                                        }

                                        @if (combatant.Status ==
                                             CombatantStatus.Removed)
                                        {
                                            <span class="badge text-bg-secondary ms-2">
                                                Removed
                                            </span>
                                        }
                                    </div>
                                </div>

                            </div>

                            <div class="d-flex
                                flex-column
                                flex-md-row
                                align-items-md-center
                                gap-2">

                                @if (combatant.CurrentHp.HasValue)
                                {
                                    <div class="d-flex
                                        align-items-center
                                        gap-1">

                                        <form method="post"
                                              asp-page-handler="AdjustHp">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    name="amount"
                                                    value="-5"
                                                    class="btn btn-sm btn-outline-danger">
                                                -5
                                            </button>

                                            <button type="submit"
                                                    name="amount"
                                                    value="-1"
                                                    class="btn btn-sm btn-outline-danger">
                                                -1
                                            </button>

                                        </form>

                                        <span class="fw-bold px-2">
                                            @combatant.CurrentHp
                                            /
                                            @(combatant.MaxHp?.ToString() ?? "—")
                                        </span>

                                        <form method="post"
                                              asp-page-handler="AdjustHp">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    name="amount"
                                                    value="1"
                                                    class="btn btn-sm btn-outline-success">
                                                +1
                                            </button>

                                            <button type="submit"
                                                    name="amount"
                                                    value="5"
                                                    class="btn btn-sm btn-outline-success">
                                                +5
                                            </button>

                                        </form>

                                    </div>
                                }

                                <form method="post"
                                      asp-page-handler="SetHp"
                                      class="d-flex gap-1">

                                    <input type="hidden"
                                           name="id"
                                           value="@combatant.Id" />

                                    <input type="number"
                                           name="currentHp"
                                           value="@combatant.CurrentHp"
                                           class="form-control form-control-sm"
                                           style="width: 5rem;"
                                           min="0" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary">
                                        Set HP
                                    </button>

                                </form>

                                @if (combatant.IsActive)
                                {
                                    <form method="post"
                                          asp-page-handler="Defeat">

                                        <input type="hidden"
                                               name="id"
                                               value="@combatant.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Defeat
                                        </button>

                                    </form>

                                    <form method="post"
                                          asp-page-handler="Remove">

                                        <input type="hidden"
                                               name="id"
                                               value="@combatant.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            Remove
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form method="post"
                                          asp-page-handler="Restore">

                                        <input type="hidden"
                                               name="id"
                                               value="@combatant.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            Restore
                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>

    <div class="d-flex gap-2">

        @if (!Model.Encounter.IsStarted)
        {
            <form method="post"
                  asp-page-handler="StartCombat">

                <button type="submit"
                        class="btn btn-success"
                        disabled="@(Model.Encounter.ActiveCombatantCount == 0)">
                    Start Combat
                </button>

            </form>
        }
        else
        {
            <form method="post"
                  asp-page-handler="NextTurn">

                <button type="submit"
                        class="btn btn-primary">
                    Next Turn
                </button>

            </form>
        }

        <form method="post"
              asp-page-handler="Reset"
              onsubmit="return confirm('Reset the entire encounter?');">

            <button type="submit"
                    class="btn btn-outline-danger">
                Reset
            </button>

        </form>

    </div>

</div>