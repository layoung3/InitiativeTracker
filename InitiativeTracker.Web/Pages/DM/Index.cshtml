@page "/dm"
@model InitiativeTracker.Web.Pages.Dm.IndexModel
@using InitiativeTracker.Core.Enums

@{
    ViewData["Title"] = "DM Controls";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/dm.css"
          asp-append-version="true" />
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">DM Controls</h1>

            <div class="text-muted">
                @if (Model.Encounter.IsStarted)
                {
                    <span>
                        Round @Model.Encounter.Round
                        ·
                        Current:
                        <strong>@Model.Encounter.CurrentCombatant?.Name</strong>
                    </span>
                }
                else
                {
                    <span>Encounter Setup</span>
                }
            </div>
        </div>

        <div class="d-flex gap-2">

            <a href="/dm/join"
               class="btn btn-outline-success">
                Join Players
            </a>

            <a href="/dm/devices"
               class="btn btn-outline-primary">
                Devices
            </a>

            <a href="/display"
               target="_blank"
               class="btn btn-outline-secondary">
                Open Display
            </a>

        </div>
    </div>


    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    @if (!Model.Encounter.IsStarted)
    {
        <div class="card mb-4">

            <div class="card-header
                        d-flex
                        justify-content-between
                        align-items-center">

                <span>
                    Player Characters
                </span>

                <span class="text-muted small">
                    Connected players
                </span>

            </div>


            <div class="list-group
                        list-group-flush">

                @if (Model.ConnectedPlayerCharacters.Count == 0)
                {
                    <div class="list-group-item
                                text-muted">
                        No connected player characters available.
                    </div>
                }
                else
                {
                    foreach (var playerGroup
                        in Model.ConnectedPlayerCharacters
                            .GroupBy(x => new
                            {
                                x.PlayerProfileId,
                                x.PlayerName
                            }))
                    {
                        <div class="list-group-item">

                            <div class="fw-bold mb-2">
                                @playerGroup.Key.PlayerName
                            </div>


                            <div class="d-flex
                                        flex-column
                                        gap-2">

                                @foreach (var character
                                          in playerGroup)
                                {
                                    <div class="d-flex
                                                flex-column
                                                flex-md-row
                                                justify-content-between
                                                align-items-md-center
                                                gap-2">

                                        <div>

                                            <div class="fw-semibold">
                                                @character.CharacterName
                                            </div>

                                            <div class="small
                                                        text-muted">

                                                Level @character.Level
                                                ·
                                                HP @character.CurrentHp
                                                /
                                                @character.MaxHp

                                            </div>

                                        </div>


                                        @if (character.AlreadyAdded)
                                        {
                                            <button type="button"
                                                    class="btn
                                                           btn-sm
                                                           btn-outline-success"
                                                    disabled>
                                                Added
                                            </button>
                                        }
                                        else
                                        {
                                            <form method="post"
                                                  asp-page-handler="AddPlayerCharacter">

                                                <input type="hidden"
                                                       name="characterId"
                                                       value="@character.CharacterId" />

                                                <button type="submit"
                                                        class="btn
                                                               btn-sm
                                                               btn-outline-primary">
                                                    Add to Encounter
                                                </button>

                                            </form>
                                        }

                                    </div>
                                }

                            </div>

                        </div>
                    }
                }

            </div>

        </div>

        <div class="card mb-4">

            <div class="card-header">
                Add Combatant
            </div>

            <div class="card-body">

                <form method="post"
                      asp-page-handler="AddCombatant">

                    <div class="row g-3 align-items-end">

                        <div class="col-md-3">
                            <label asp-for="CombatantName"
                                   class="form-label">
                                Name
                            </label>

                            <input asp-for="CombatantName"
                                   class="form-control" />
                        </div>


                        <div class="col-md-1">
                            <label asp-for="Quantity"
                                   class="form-label">
                                Qty
                            </label>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="1"
                                   max="50"
                                   class="form-control" />
                        </div>


                        <div class="col-md-2">
                            <label asp-for="Initiative"
                                   class="form-label">
                                Initiative
                            </label>

                            <input asp-for="Initiative"
                                   type="number"
                                   class="form-control" />
                        </div>


                        <div class="col-md-2">
                            <label asp-for="CurrentHp"
                                   class="form-label">
                                Current HP
                            </label>

                            <input asp-for="CurrentHp"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="Max HP" />
                        </div>


                        <div class="col-md-2">
                            <label asp-for="MaxHp"
                                   class="form-label">
                                Max HP
                            </label>

                            <input asp-for="MaxHp"
                                   type="number"
                                   min="0"
                                   class="form-control" />
                        </div>


                        <div class="col-md-2">
                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Add
                            </button>
                        </div>

                    </div>

                </form>

            </div>

        </div>
    }


    <div class="card mb-4">

        <div class="card-header d-flex justify-content-between">

            <span>
                Initiative
            </span>

            <span>
                @Model.Encounter.ActiveCombatantCount active
                /
                @Model.Encounter.Combatants.Count total
            </span>

        </div>


        <div id="initiativeList"
             class="list-group list-group-flush">

            @if (Model.Encounter.Combatants.Count == 0)
            {
                <div class="list-group-item text-muted">
                    No combatants added.
                </div>
            }
            else
            {
                var combatants = Model.Encounter.IsStarted
                    ? Model.Encounter.Combatants
                        .OrderBy(c => c.SortOrder)
                    : Model.Encounter.Combatants
                        .OrderByDescending(c => c.Initiative)
                        .ThenBy(c => c.SortOrder);


                foreach (var combatant in combatants)
                {
                    var isCurrent =
                        Model.Encounter.CurrentCombatantId
                        == combatant.Id;


                    <div class="list-group-item
                        initiative-dm-row
                        @(isCurrent ? "list-group-item-primary" : "")
                        @(!combatant.IsActive ? "opacity-50" : "")"
                         data-combatant-id="@combatant.Id">

                        <div class="d-flex
                            flex-column
                            flex-xl-row
                            justify-content-between
                            gap-3">


                            <div class="d-flex align-items-center gap-2">
                                @if (!Model.Encounter.IsStarted)
                                {
                                    <div class="list-group-item">

                                        <div class="d-flex
                                            flex-column
                                            flex-xl-row
                                            gap-2
                                            align-items-xl-end">

                                            <form method="post"
                                                  asp-page-handler="UpdateCombatant"
                                                  class="row
                                                g-2
                                                align-items-end
                                                flex-grow-1">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@combatant.Id" />


                                                <div class="col-md-4">

                                                    <label class="form-label small">
                                                        Name
                                                    </label>

                                                    <input type="text"
                                                           name="name"
                                                           value="@combatant.Name"
                                                           class="form-control
                                                    form-control-sm"
                                                           required />

                                                </div>


                                                <div class="col-md-2">

                                                    <label class="form-label small">
                                                        Initiative
                                                    </label>

                                                    <input type="number"
                                                           name="initiative"
                                                           value="@combatant.Initiative"
                                                           class="form-control
                                                    form-control-sm" />

                                                </div>


                                                <div class="col-md-2">

                                                    <label class="form-label small">
                                                        Current HP
                                                    </label>

                                                    <input type="number"
                                                           name="currentHp"
                                                           value="@combatant.CurrentHp"
                                                           min="0"
                                                           class="form-control
                                                    form-control-sm" />

                                                </div>


                                                <div class="col-md-2">

                                                    <label class="form-label small">
                                                        Max HP
                                                    </label>

                                                    <input type="number"
                                                           name="maxHp"
                                                           value="@combatant.MaxHp"
                                                           min="0"
                                                           class="form-control
                                                    form-control-sm" />

                                                </div>


                                                <div class="col-md-2">

                                                    <button type="submit"
                                                            class="btn
                                                        btn-sm
                                                        btn-outline-primary
                                                        w-100">
                                                        Save
                                                    </button>

                                                </div>

                                            </form>


                                            <form method="post"
                                                  asp-page-handler="DeleteCombatant"
                                                  onsubmit="return confirm('Delete @combatant.Name?');">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@combatant.Id" />

                                                <button type="submit"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-danger">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                        <div class="border-top mt-3 pt-3">

                                            <form method="post"
                                                  asp-page-handler="AssignController"
                                                  class="d-flex
                                                flex-column
                                                flex-sm-row
                                                align-items-sm-center
                                                gap-2">

                                                <input type="hidden"
                                                       name="combatantId"
                                                       value="@combatant.Id" />


                                                <label class="form-label
                                                    mb-sm-0
                                                    text-muted
                                                    small">
                                                    Controlled by
                                                </label>


                                                <select name="playerProfileId"
                                                        class="form-select
                                                    form-select-sm"
                                                        style="max-width: 14rem;">

                                                    @if (!combatant.AssignedPlayerProfileId.HasValue)
                                                    {
                                                        <option value=""
                                                                selected>
                                                            DM
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="">
                                                            DM
                                                        </option>
                                                    }


                                                    @foreach (var player
                                                              in Model.ConnectedPlayers)
                                                    {
                                                        if (combatant.AssignedPlayerProfileId ==
                                                            player.PlayerProfileId)
                                                        {
                                                            <option value="@player.PlayerProfileId"
                                                                    selected>
                                                                @player.PlayerName
                                                            </option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@player.PlayerProfileId">
                                                                @player.PlayerName
                                                            </option>
                                                        }
                                                    }

                                                </select>


                                                <button type="submit"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-secondary">
                                                    Assign
                                                </button>

                                            </form>

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn
                                        btn-sm
                                        btn-link
                                        text-body-secondary
                                        p-1
                                        drag-handle"
                                            title="Drag to reorder"
                                            aria-label="Drag to reorder">
                                        ⋮⋮
                                    </button>


                                    <div class="btn-group btn-group-sm"
                                         role="group"
                                         aria-label="Move combatant">

                                        <form method="post"
                                              asp-page-handler="MoveCombatant">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    name="direction"
                                                    value="-1"
                                                    class="btn btn-outline-secondary"
                                                    title="Move up">
                                                ↑
                                            </button>

                                        </form>


                                        <form method="post"
                                              asp-page-handler="MoveCombatant">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    name="direction"
                                                    value="1"
                                                    class="btn btn-outline-secondary"
                                                    title="Move down">
                                                ↓
                                            </button>

                                        </form>

                                    </div>
                                }


                                <div style="width: 1.5rem;">

                                    @if (isCurrent)
                                    {
                                        <span>➜</span>
                                    }

                                </div>


                                <div>

                                    <div class="fw-bold fs-5">
                                        @combatant.Name
                                    </div>


                                    <div class="small text-muted">

                                        Initiative:
                                        @combatant.Initiative


                                        @if (combatant.Status ==
                                             CombatantStatus.Defeated)
                                        {
                                            <span class="badge
                                                text-bg-danger
                                                ms-2">
                                                Defeated
                                            </span>
                                        }


                                        @if (combatant.Status ==
                                             CombatantStatus.Removed)
                                        {
                                            <span class="badge
                                                text-bg-secondary
                                                ms-2">
                                                Removed
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            @* RIGHT SIDE *@
                            <div class="d-flex
                                flex-column
                                flex-md-row
                                flex-wrap
                                align-items-md-center
                                gap-2">


                                @if (combatant.CurrentHp.HasValue)
                                {
                                    <div class="d-flex
                                        align-items-center
                                        gap-1">

                                        <form method="post"
                                              asp-page-handler="AdjustHp"
                                              class="d-flex gap-1">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />


                                            <button type="submit"
                                                    name="amount"
                                                    value="-5"
                                                    class="btn
                                                btn-sm
                                                btn-outline-danger">
                                                -5
                                            </button>


                                            <button type="submit"
                                                    name="amount"
                                                    value="-1"
                                                    class="btn
                                                btn-sm
                                                btn-outline-danger">
                                                -1
                                            </button>

                                        </form>


                                        <span class="fw-bold px-2">

                                            @combatant.CurrentHp
                                            /
                                            @(combatant.MaxHp?.ToString() ?? "—")

                                        </span>


                                        <form method="post"
                                              asp-page-handler="AdjustHp"
                                              class="d-flex gap-1">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />


                                            <button type="submit"
                                                    name="amount"
                                                    value="1"
                                                    class="btn
                                                btn-sm
                                                btn-outline-success">
                                                +1
                                            </button>


                                            <button type="submit"
                                                    name="amount"
                                                    value="5"
                                                    class="btn
                                                btn-sm
                                                btn-outline-success">
                                                +5
                                            </button>

                                        </form>

                                    </div>
                                }


                                <form method="post"
                                      asp-page-handler="SetHp"
                                      class="d-flex gap-1">

                                    <input type="hidden"
                                           name="id"
                                           value="@combatant.Id" />


                                    <input type="number"
                                           name="currentHp"
                                           value="@combatant.CurrentHp"
                                           class="form-control
                                    form-control-sm"
                                           style="width: 5rem;"
                                           min="0" />


                                    <button type="submit"
                                            class="btn
                                        btn-sm
                                        btn-outline-secondary">
                                        Set HP
                                    </button>

                                </form>


                                @if (combatant.IsActive)
                                {
                                    <form method="post"
                                          asp-page-handler="Defeat">

                                        <input type="hidden"
                                               name="id"
                                               value="@combatant.Id" />


                                        <button type="submit"
                                                class="btn
                                            btn-sm
                                            btn-outline-danger">
                                            Defeat
                                        </button>

                                    </form>


                                    <form method="post"
                                          asp-page-handler="Remove">

                                        <input type="hidden"
                                               name="id"
                                               value="@combatant.Id" />


                                        <button type="submit"
                                                class="btn
                                            btn-sm
                                            btn-outline-secondary">
                                            Remove
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form method="post"
                                          asp-page-handler="Restore">

                                        <input type="hidden"
                                               name="id"
                                               value="@combatant.Id" />


                                        <button type="submit"
                                                class="btn
                                            btn-sm
                                            btn-outline-success">
                                            Restore
                                        </button>

                                    </form>
                                }

                                <form method="post"
                                      asp-page-handler="AssignController"
                                      class="d-flex
                                    align-items-center
                                    gap-1">

                                    <input type="hidden"
                                           name="combatantId"
                                           value="@combatant.Id" />


                                    <span class="small text-muted">
                                        Controller:
                                    </span>


                                    <select name="playerProfileId"
                                            class="form-select
                                        form-select-sm"
                                            style="width: auto;
                                        min-width: 8rem;">

                                        @if (!combatant.AssignedPlayerProfileId.HasValue)
                                        {
                                            <option value=""
                                                    selected>
                                                DM
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="">
                                                DM
                                            </option>
                                        }


                                        @foreach (var player
                                                  in Model.ConnectedPlayers)
                                        {
                                            if (combatant.AssignedPlayerProfileId ==
                                                player.PlayerProfileId)
                                            {
                                                <option value="@player.PlayerProfileId"
                                                        selected>
                                                    @player.PlayerName
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@player.PlayerProfileId">
                                                    @player.PlayerName
                                                </option>
                                            }
                                        }

                                    </select>


                                    <button type="submit"
                                            class="btn
                                        btn-sm
                                        btn-outline-secondary">
                                        Set
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>
                }
            }

        </div>

    </div>


    @* ENCOUNTER CONTROLS *@
    <div class="d-flex flex-wrap gap-2">

        @if (!Model.Encounter.IsStarted)
        {
            <form method="post"
                  asp-page-handler="StartCombat">

                <button type="submit"
                        class="btn btn-success"
                        disabled="@(Model.Encounter.ActiveCombatantCount == 0)">
                    Start Combat
                </button>

            </form>
        }
        else
        {
            <form method="post"
                  asp-page-handler="PreviousTurn">

                <button type="submit"
                        class="btn btn-outline-primary">
                    ← Previous
                </button>

            </form>


            <form method="post"
                  asp-page-handler="NextTurn">

                <button type="submit"
                        class="btn btn-primary">
                    Next Turn →
                </button>

            </form>
        }


        <form method="post"
              asp-page-handler="Undo">

            @if (Model.CanUndo)
            {
                <button id="undoButton"
                        type="submit"
                        class="btn btn-outline-warning">
                    Undo
                </button>
            }
            else
            {
                <button id="undoButton"
                        type="button"
                        class="btn btn-outline-warning"
                        disabled>
                    Undo
                </button>
            }

        </form>


        <form method="post"
              asp-page-handler="Reset"
              onsubmit="return confirm('Reset the entire encounter?');">

            <button type="submit"
                    class="btn btn-outline-danger">
                Reset
            </button>

        </form>

    </div>

    @if (Model.Encounter.IsStarted)
    {
        <form id="reorderForm"
              method="post"
              asp-page-handler="Reorder"
              class="d-none">
        </form>
    }

</div>


@section Scripts {

    @if (Model.Encounter.IsStarted)
    {
        <script src="~/lib/sortablejs/Sortable.min.js"></script>

        <script src="~/js/dm-initiative.js"
                asp-append-version="true">
        </script>
    }

}