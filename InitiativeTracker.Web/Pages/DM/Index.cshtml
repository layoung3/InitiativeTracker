@page "/dm"
@model InitiativeTracker.Web.Pages.Dm.IndexModel
@using InitiativeTracker.Core.Enums
@using InitiativeTracker.Web.Rules.Dnd5e

@{
    ViewData["Title"] = "DM Controls";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/condition-badges.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dm.css"
          asp-append-version="true" />
}

<div class="dm-turn-context" role="status">
    @(Model.Encounter.IsStarted ? $"Round {Model.Encounter.Round} · Current: {Model.Encounter.CurrentCombatant?.Name}" : "Encounter Setup")
</div>

<div class="container-fluid dm-page px-3 px-lg-4 py-3 py-lg-4">

    <header class="dm-header d-flex
        flex-column
        flex-lg-row
        justify-content-between
        align-items-lg-center
        gap-3
        mb-4">

        <div>

            <h1 class="dm-title mb-1">
                DM Controls
            </h1>

            <div class="dm-encounter-summary text-muted">

                @if (Model.Encounter.IsStarted)
                {
                    <span>
                        Round @Model.Encounter.Round
                        ·
                        Current:
                        <strong>
                            @Model.Encounter.CurrentCombatant?.Name
                        </strong>
                    </span>
                }
                else
                {
                    <span>
                        Encounter Setup
                    </span>
                }

            </div>

        </div>


        <div class="dm-header-actions d-flex
            flex-wrap
            gap-2">

            <a href="/dm/join"
               class="btn btn-outline-success">
                Join Players
            </a>

            <a href="/dm/devices"
               class="btn btn-outline-primary">
                Devices
            </a>

            <a href="/dm/players"
               class="btn btn-outline-primary">
                Stored Players
            </a>

            <a href="/display"
               target="_blank"
               class="btn btn-outline-secondary">
                Open Display
            </a>

            <button type="button"
                    class="btn btn-outline-secondary"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#dmAppearancePanel"
                    aria-controls="dmAppearancePanel">
                Appearance
            </button>

        </div>

    </header>


    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    @* ============================================================
       PRE-COMBAT SETUP
       ============================================================ *@

    @if (!Model.Encounter.IsStarted)
    {
        @* Connected Player Characters *@
        <div class="card dm-card mb-4">

            <div class="card-header
                d-flex
                justify-content-between
                align-items-center">

                <span>
                    Player Characters
                </span>

                <span class="text-muted small">
                    Connected players
                </span>

            </div>


            <div class="list-group list-group-flush">

                @if (Model.ConnectedPlayerCharacters.Count == 0)
                {
                    <div class="list-group-item text-muted">
                        No connected player characters available.
                    </div>
                }
                else
                {
                    foreach (var playerGroup
                        in Model.ConnectedPlayerCharacters
                            .GroupBy(x => new
                            {
                                x.PlayerProfileId,
                                x.PlayerName
                            }))
                    {
                        <div class="list-group-item">

                            <div class="fw-bold mb-2">
                                @playerGroup.Key.PlayerName
                            </div>


                            <div class="d-flex
                                flex-column
                                gap-2">

                                @foreach (var character in playerGroup)
                                {
                                    <div class="d-flex
                                        flex-column
                                        flex-md-row
                                        justify-content-between
                                        align-items-md-center
                                        gap-2">

                                        <div>

                                            <div class="fw-semibold">
                                                @character.CharacterName
                                            </div>

                                            <div class="small text-muted">
                                                Level @character.Level
                                                ·
                                                HP @character.CurrentHp
                                                /
                                                @character.MaxHp
                                            </div>

                                        </div>


                                        @if (character.AlreadyAdded)
                                        {
                                            <button type="button"
                                                    class="btn
                                                btn-sm
                                                btn-outline-success"
                                                    disabled>
                                                Added
                                            </button>
                                        }
                                        else
                                        {
                                            <form method="post"
                                                  asp-page-handler="AddPlayerCharacter">
                                                <label><input type="checkbox" name="InitiallyHidden" value="true" /> Hidden</label>
                                                <label><input type="checkbox" name="InitiallyHpHidden" value="true" /> Hide HP</label>

                                                <input type="hidden"
                                                       name="characterId"
                                                       value="@character.CharacterId" />

                                                <button type="submit"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-primary">
                                                    Add to Encounter
                                                </button>

                                            </form>
                                        }

                                    </div>
                                }

                            </div>

                        </div>
                    }
                }

            </div>

        </div>


        @* Add Combatant *@
        <div class="card dm-card mb-4">

            <div class="card-header">
                Add Combatant
            </div>


            <div class="card-body">

                <form method="post"
                      asp-page-handler="AddCombatant">
                    <div class="d-flex gap-3 mb-3">
                        <label><input asp-for="InitiallyHidden" /> Hide from public</label>
                        <label><input asp-for="InitiallyHpHidden" /> Hide HP</label>
                    </div>

                    <div class="row g-3 align-items-end">

                        <div class="col-md-3">

                            <label asp-for="CombatantName"
                                   class="form-label">
                                Name
                            </label>

                            <input asp-for="CombatantName"
                                   class="form-control" />

                        </div>


                        <div class="col-md-1">

                            <label asp-for="Quantity"
                                   class="form-label">
                                Qty
                            </label>

                            <input asp-for="Quantity"
                                   type="number"
                                   min="1"
                                   max="50"
                                   class="form-control" />

                        </div>


                        <div class="col-md-2">

                            <label asp-for="Initiative"
                                   class="form-label">
                                Initiative
                            </label>

                            <input asp-for="Initiative"
                                   type="number"
                                   class="form-control" />

                        </div>


                        <div class="col-md-2">

                            <label asp-for="CurrentHp"
                                   class="form-label">
                                Current HP
                            </label>

                            <input asp-for="CurrentHp"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   placeholder="Max HP" />

                        </div>


                        <div class="col-md-2">

                            <label asp-for="MaxHp"
                                   class="form-label">
                                Max HP
                            </label>

                            <input asp-for="MaxHp"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                        </div>


                        <div class="col-md-2">

                            <button type="submit"
                                    class="btn
                                btn-primary
                                w-100">
                                Add
                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>
    }


    @* ============================================================
       INITIATIVE / COMBATANTS
       ============================================================ *@

    <div class="card dm-card dm-initiative-card mb-4">

        <div class="card-header
            d-flex
            justify-content-between
            align-items-center
            gap-2">

            <span>
                Initiative
            </span>

            <span>
                @Model.Encounter.ActiveCombatantCount active
                /
                @Model.Encounter.Combatants.Count total
            </span>

        </div>


        <div id="initiativeList"
             class="list-group list-group-flush">

            @if (Model.Encounter.Combatants.Count == 0)
            {
                <div class="list-group-item text-muted">
                    No combatants added.
                </div>
            }
            else
            {
                var combatants =
                    Model.Encounter.IsStarted
                        ? Model.Encounter.Combatants
                            .OrderBy(c => c.SortOrder)
                        : Model.Encounter.Combatants
                            .OrderByDescending(c => c.Initiative)
                            .ThenBy(c => c.SortOrder);


                foreach (var combatant in combatants)
                {
                    var isCurrent =
                        Model.Encounter.CurrentCombatantId ==
                        combatant.Id;


                    @* ====================================================
                       PRE-COMBAT ROW
                       ==================================================== *@

                    @if (!Model.Encounter.IsStarted)
                    {
                        <div class="list-group-item dm-combatant-row dm-combatant-row--setup">

                            <div class="d-flex
                                flex-column
                                gap-3">

                                <div class="d-flex
                                    flex-column
                                    flex-xl-row
                                    gap-2
                                    align-items-xl-end">


                                    <form method="post"
                                          asp-page-handler="UpdateCombatant"
                                          class="row
                                        g-2
                                        align-items-end
                                        flex-grow-1">

                                        <input type="hidden"
                                               name="id"
                                               value="@combatant.Id" />


                                        <div class="col-md-4">

                                            <div class="d-flex
                                                justify-content-between
                                                align-items-center
                                                mb-1">

                                                <label class="form-label
                                                    small
                                                    mb-0">
                                                    Name
                                                </label>


                                                <div class="d-flex gap-1">

                                                    @if (combatant.IsHiddenFromPublic)
                                                    {
                                                        <span class="badge text-bg-dark">
                                                            Hidden
                                                        </span>
                                                    }

                                                    @if (combatant.IsHpHiddenFromPublic)
                                                    {
                                                        <span class="badge text-bg-secondary">
                                                            HP Hidden
                                                        </span>
                                                    }

                                                </div>

                                            </div>


                                            <div class="dm-combatant-name-heading">
                                                <input type="text"
                                                       name="name"
                                                       value="@combatant.Name"
                                                       class="form-control form-control-sm"
                                                       required />
                                                @if (combatant.ExhaustionLevel > 0)
                                                {
                                                    <span class="condition-badge dm-exhaustion-badge">Exhaustion @combatant.ExhaustionLevel</span>
                                                }
                                            </div>

                                        </div>


                                        <div class="col-md-2">

                                            <label class="form-label small">
                                                Initiative
                                            </label>

                                            <input type="number"
                                                   name="initiative"
                                                   value="@combatant.Initiative"
                                                   class="form-control
                                            form-control-sm" />

                                        </div>


                                        <div class="col-md-2">

                                            <label class="form-label small">
                                                Current HP
                                            </label>

                                            <input type="number"
                                                   name="currentHp"
                                                   value="@combatant.CurrentHp"
                                                   min="0"
                                                   class="form-control
                                            form-control-sm" />

                                        </div>


                                        <div class="col-md-2">

                                            <label class="form-label small">
                                                Max HP
                                            </label>

                                            <input type="number"
                                                   name="maxHp"
                                                   value="@combatant.MaxHp"
                                                   min="0"
                                                   class="form-control
                                            form-control-sm" />

                                        </div>


                                        <div class="col-md-2">

                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-primary
                                                w-100">
                                                Save
                                            </button>

                                        </div>

                                    </form>


                                    <form method="post"
                                          asp-page-handler="DeleteCombatant"
                                          onsubmit="return confirm('Delete @combatant.Name?');">

                                        <input type="hidden"
                                               name="id"
                                               value="@combatant.Id" />

                                        <button type="submit"
                                                class="btn
                                            btn-sm
                                            btn-outline-danger">
                                            Delete
                                        </button>

                                    </form>

                                </div>


                                @if (combatant.Conditions.Count > 0)
                                {
                                    <div class="condition-badges">

                                        @foreach (var condition
                                                  in combatant.Conditions
                                                      .OrderBy(x => x.Name))
                                        {
                                            <span class="condition-badge
                                                condition-@Dnd5eConditionCatalog.GetStyleKey(condition.Name)"
                                                  title="@condition.Notes">
                                                @condition.Name
                                            </span>
                                        }

                                    </div>
                                }
                                @* Controller Assignment *@
                                <div class="dm-combatant-management border-top
                                    pt-3
                                    d-flex
                                    flex-column
                                    flex-lg-row
                                    justify-content-between
                                    align-items-lg-center
                                    gap-3">

                                    <form method="post"
                                          asp-page-handler="AssignController"
                                          class="d-flex
                                        flex-column
                                        flex-sm-row
                                        align-items-sm-center
                                        gap-2">

                                        <input type="hidden"
                                               name="combatantId"
                                               value="@combatant.Id" />

                                        <label class="form-label
                                            mb-sm-0
                                            text-muted
                                            small">
                                            Controlled by
                                        </label>


                                        <select name="playerProfileId"
                                                class="form-select
                                            form-select-sm
                                            dm-controller-select">

                                            @if (!combatant.AssignedPlayerProfileId.HasValue)
                                            {
                                                <option value=""
                                                        selected>
                                                    DM
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="">
                                                    DM
                                                </option>
                                            }


                                            @foreach (var player
                                                      in Model.ConnectedPlayers)
                                            {
                                                if (combatant.AssignedPlayerProfileId ==
                                                    player.PlayerProfileId)
                                                {
                                                    <option value="@player.PlayerProfileId"
                                                            selected>
                                                        @player.PlayerName
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@player.PlayerProfileId">
                                                        @player.PlayerName
                                                    </option>
                                                }
                                            }

                                        </select>


                                        <button type="submit"
                                                class="btn
                                            btn-sm
                                            btn-outline-secondary">
                                            Assign
                                        </button>

                                    </form>

                                    <a asp-page="/Dm/Index"
                                       asp-route-conditions="@combatant.Id"
                                       class="btn
                                        btn-sm
                                        btn-outline-secondary">
                                        Conditions

                                        @if (combatant.Conditions.Count > 0)
                                        {
                                            <span class="badge
                                                text-bg-secondary
                                                ms-1">
                                                @combatant.Conditions.Count
                                            </span>
                                        }
                                    </a>
                                    <form method="post"
                                          asp-page-handler="SetVisibility" data-visibility-autosave
                                          class="d-flex
                                        flex-wrap
                                        align-items-center
                                        gap-2">

                                        <input type="hidden"
                                               name="combatantId"
                                               value="@combatant.Id" />


                                        <div class="form-check">

                                            <input type="checkbox"
                                                   name="isHiddenFromPublic"
                                                   value="true"
                                                   class="form-check-input"
                                                   id="hidden-@combatant.Id"
                                                   checked="@combatant.IsHiddenFromPublic" />

                                            <label class="form-check-label small"
                                                   for="hidden-@combatant.Id">
                                                Hidden
                                            </label>

                                        </div>


                                        <div class="form-check">

                                            <input type="checkbox"
                                                   name="isHpHiddenFromPublic"
                                                   value="true"
                                                   class="form-check-input"
                                                   id="hideHp-@combatant.Id"
                                                   checked="@combatant.IsHpHiddenFromPublic" />

                                            <label class="form-check-label small"
                                                   for="hideHp-@combatant.Id">
                                                Hide HP
                                            </label>

                                        </div>


                                        <button type="submit"
                                                class="btn
                                            btn-sm
                                            btn-outline-secondary">
                                            Save Visibility
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }
                    else
                    {
                        @* =================================================
                           ACTIVE-COMBAT ROW
                           ================================================= *@

                        <div class="list-group-item
                            initiative-dm-row
                            dm-combatant-row
                            dm-combatant-row--active
                            @(isCurrent ? "is-current" : "")
                            @(!combatant.IsActive ? "is-inactive" : "")"
                             data-combatant-id="@combatant.Id">

                            <div class="d-flex
                                flex-column
                                flex-xl-row
                                justify-content-between
                                gap-3">


                                @* LEFT SIDE *@
                                <div class="dm-combatant-main d-flex
                                    align-items-center
                                    gap-2">


                                    <button type="button"
                                            class="btn
                                        btn-sm
                                        btn-link
                                        text-body-secondary
                                        p-1
                                        drag-handle"
                                            title="Drag to reorder"
                                            aria-label="Drag to reorder">
                                        ⋮⋮
                                    </button>


                                    <div class="btn-group
                                        btn-group-sm"
                                         role="group"
                                         aria-label="Move combatant">

                                        <form method="post"
                                              asp-page-handler="MoveCombatant">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    name="direction"
                                                    value="-1"
                                                    class="btn
                                                btn-outline-secondary"
                                                    title="Move up">
                                                ↑
                                            </button>

                                        </form>


                                        <form method="post"
                                              asp-page-handler="MoveCombatant">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    name="direction"
                                                    value="1"
                                                    class="btn
                                                btn-outline-secondary"
                                                    title="Move down">
                                                ↓
                                            </button>

                                        </form>

                                    </div>


                                    <div class="dm-current-indicator">

                                        @if (isCurrent)
                                        {
                                            <span>
                                                ➜
                                            </span>
                                        }

                                    </div>


                                    <div>

                                        <div class="d-flex
                                            flex-wrap
                                            align-items-center
                                            gap-1">

                                            <div class="dm-combatant-name-heading">
                                                <span class="fw-bold fs-5">@combatant.Name</span>
                                                @if (combatant.ExhaustionLevel > 0)
                                                {
                                                    <span class="condition-badge dm-exhaustion-badge">Exhaustion @combatant.ExhaustionLevel</span>
                                                }
                                            </div>


                                            @if (combatant.IsHiddenFromPublic)
                                            {
                                                <span class="badge text-bg-dark">
                                                    Hidden
                                                </span>
                                            }


                                            @if (combatant.IsHpHiddenFromPublic)
                                            {
                                                <span class="badge text-bg-secondary">
                                                    HP Hidden
                                                </span>
                                            }

                                        </div>


                                        <div class="small text-muted">

                                            Initiative:
                                            @combatant.Initiative


                                            @if (combatant.Status ==
                                                 CombatantStatus.Defeated)
                                            {
                                                <span class="badge
                                                    text-bg-danger
                                                    ms-2">
                                                    Defeated
                                                </span>
                                            }


                                            @if (combatant.Status ==
                                                 CombatantStatus.Removed)
                                            {
                                                <span class="badge
                                                    text-bg-secondary
                                                    ms-2">
                                                    Removed
                                                </span>
                                            }

                                        </div>

                                        @if (combatant.Conditions.Count > 0)
                                        {
                                            <div class="condition-badges mt-1">

                                                @foreach (var condition
                                                          in combatant.Conditions
                                                              .OrderBy(x => x.Name))
                                                {
                                                    <span class="condition-badge
                                                        condition-@Dnd5eConditionCatalog.GetStyleKey(condition.Name)"
                                                          title="@condition.Notes">
                                                        @condition.Name
                                                    </span>
                                                }

                                            </div>
                                        }
                                    </div>

                                </div>


                                @* RIGHT SIDE *@
                                <div class="dm-combatant-combat-controls d-flex
                                    flex-column
                                    flex-md-row
                                    flex-wrap
                                    align-items-md-center
                                    gap-2">


                                    @if (combatant.CurrentHp.HasValue)
                                    {
                                        @* Quick HP Controls *@
                                        <div class="dm-quick-hp d-flex
                                            align-items-center
                                            gap-1">

                                            <form method="post"
                                                  asp-page-handler="AdjustHp"
                                                  class="d-flex gap-1">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@combatant.Id" />


                                                <button type="submit"
                                                        name="amount"
                                                        value="-5"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-danger">
                                                    -5
                                                </button>


                                                <button type="submit"
                                                        name="amount"
                                                        value="-1"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-danger">
                                                    -1
                                                </button>

                                            </form>


                                            <span class="fw-bold px-2">

                                                @combatant.CurrentHp
                                                /
                                                @(combatant.MaxHp?.ToString() ?? "—")

                                            </span>


                                            @if (combatant.TemporaryHp > 0)
                                            {
                                                <span class="badge
                                                    text-bg-info">
                                                    Temp @combatant.TemporaryHp
                                                </span>
                                            }


                                            <form method="post"
                                                  asp-page-handler="AdjustHp"
                                                  class="d-flex gap-1">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@combatant.Id" />


                                                <button type="submit"
                                                        name="amount"
                                                        value="1"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-success">
                                                    +1
                                                </button>


                                                <button type="submit"
                                                        name="amount"
                                                        value="5"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-success">
                                                    +5
                                                </button>

                                            </form>

                                        </div>


                                        @* Exact Current HP *@
                                        <form method="post"
                                              asp-page-handler="SetHp"
                                              class="d-flex gap-1">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <input type="number"
                                                   name="currentHp"
                                                   value="@combatant.CurrentHp"
                                                   class="form-control
                                            form-control-sm
                                            dm-compact-number"
                                                   min="0"
                                                   required />

                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-secondary">
                                                Set HP
                                            </button>

                                        </form>


                                        @* Temporary HP *@
                                        <form method="post"
                                              asp-page-handler="SetTemporaryHp"
                                              class="d-flex gap-1">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <input type="number"
                                                   name="temporaryHp"
                                                   value="@combatant.TemporaryHp"
                                                   min="0"
                                                   class="form-control
                                            form-control-sm
                                            dm-compact-number" />

                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-info">
                                                Temp HP
                                            </button>

                                        </form>
                                    }


                                    @* Combatant Status *@
                                    @if (combatant.IsActive)
                                    {
                                        <form method="post"
                                              asp-page-handler="Defeat">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-danger">
                                                Defeat
                                            </button>

                                        </form>


                                        <form method="post"
                                              asp-page-handler="Remove">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-secondary">
                                                Remove
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post"
                                              asp-page-handler="Restore">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@combatant.Id" />

                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-success">
                                                Restore
                                            </button>

                                        </form>
                                    }



                                </div>

                            </div>

                            @* MANAGEMENT FOOTER *@
                            <div class="dm-combatant-management border-top
                                mt-3
                                pt-3
                                d-flex
                                flex-column
                                flex-lg-row
                                justify-content-between
                                align-items-lg-center
                                gap-3">

                                @* Controller Assignment *@
                                <form method="post"
                                      asp-page-handler="AssignController"
                                      class="d-flex
                                    flex-column
                                    flex-sm-row
                                    align-items-sm-center
                                    gap-2">

                                    <input type="hidden"
                                           name="combatantId"
                                           value="@combatant.Id" />

                                    <label class="form-label
                                        mb-sm-0
                                        text-muted
                                        small">
                                        Controlled by
                                    </label>

                                    <select name="playerProfileId"
                                            class="form-select
                                        form-select-sm
                                        dm-controller-select">

                                        @if (!combatant.AssignedPlayerProfileId.HasValue)
                                        {
                                            <option value=""
                                                    selected>
                                                DM
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="">
                                                DM
                                            </option>
                                        }

                                        @foreach (var player
                                                  in Model.ConnectedPlayers)
                                        {
                                            if (combatant.AssignedPlayerProfileId ==
                                                player.PlayerProfileId)
                                            {
                                                <option value="@player.PlayerProfileId"
                                                        selected>
                                                    @player.PlayerName
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@player.PlayerProfileId">
                                                    @player.PlayerName
                                                </option>
                                            }
                                        }

                                    </select>

                                    <button type="submit"
                                            class="btn
                                        btn-sm
                                        btn-outline-secondary">
                                        Assign
                                    </button>

                                </form>


                                @* Condition Management *@
                                <a asp-page="/Dm/Index"
                                   asp-route-conditions="@combatant.Id"
                                   class="btn
                                    btn-sm
                                    btn-outline-secondary">
                                    Conditions

                                    @if (combatant.Conditions.Count > 0)
                                    {
                                        <span class="badge
                                            text-bg-secondary
                                            ms-1">
                                            @combatant.Conditions.Count
                                        </span>
                                    }
                                </a>
                                @* Public Visibility *@
                                <form method="post"
                                      asp-page-handler="SetVisibility" data-visibility-autosave
                                      class="d-flex
                                    flex-wrap
                                    align-items-center
                                    gap-2">

                                    <input type="hidden"
                                           name="combatantId"
                                           value="@combatant.Id" />

                                    <div class="form-check">

                                        <input type="checkbox"
                                               name="isHiddenFromPublic"
                                               value="true"
                                               class="form-check-input"
                                               id="combat-hidden-@combatant.Id"
                                               checked="@combatant.IsHiddenFromPublic" />

                                        <label class="form-check-label small"
                                               for="combat-hidden-@combatant.Id">
                                            Hidden
                                        </label>

                                    </div>


                                    <div class="form-check">

                                        <input type="checkbox"
                                               name="isHpHiddenFromPublic"
                                               value="true"
                                               class="form-check-input"
                                               id="combat-hide-hp-@combatant.Id"
                                               checked="@combatant.IsHpHiddenFromPublic" />

                                        <label class="form-check-label small"
                                               for="combat-hide-hp-@combatant.Id">
                                            Hide HP
                                        </label>

                                    </div>


                                    <button type="submit"
                                            class="btn
                                        btn-sm
                                        btn-outline-secondary">
                                        Save Visibility
                                    </button>

                                </form>

                            </div>

                        </div>
                    }
                }
            }

        </div>

    </div>


    @* ============================================================
       ENCOUNTER CONTROLS
       ============================================================ *@

    <div class="dm-command-bar"
         role="region"
         aria-label="Encounter controls">

        <div class="dm-command-bar-inner">

            @if (!Model.Encounter.IsStarted)
            {
                <form method="post"
                      asp-page-handler="StartCombat">

                    <button type="submit"
                            class="btn btn-success dm-command-primary"
                            disabled="@(Model.Encounter.ActiveCombatantCount == 0)">
                        Start Combat
                    </button>

                </form>
            }
            else
            {
                <form method="post"
                      asp-page-handler="PreviousTurn">

                    <button type="submit"
                            class="btn btn-outline-primary dm-command-secondary">
                        ← Previous
                    </button>

                </form>


                <form method="post"
                      asp-page-handler="NextTurn">

                    <button type="submit"
                            class="btn btn-primary dm-command-primary">
                        Next Turn →
                    </button>

                </form>
            }


            <form method="post"
                  asp-page-handler="Undo">

                @if (Model.CanUndo)
                {
                    <button id="undoButton"
                            type="submit"
                            class="btn btn-outline-warning">
                        Undo
                    </button>
                }
                else
                {
                    <button id="undoButton"
                            type="button"
                            class="btn btn-outline-warning"
                            disabled>
                        Undo
                    </button>
                }

            </form>


            <form method="post"
                  asp-page-handler="Reset"
                  onsubmit="return confirm('Reset the entire encounter?');">

                <button type="submit"
                        class="btn btn-outline-danger">
                    Reset
                </button>

            </form>

        </div>

    </div>



    @* ============================================================
       APPEARANCE
       ============================================================ *@

    <div class="offcanvas offcanvas-end dm-appearance-panel"
         tabindex="-1"
         id="dmAppearancePanel"
         aria-labelledby="dmAppearancePanelLabel">

        <div class="offcanvas-header">

            <div>

                <h2 class="offcanvas-title h5 mb-1"
                    id="dmAppearancePanelLabel">
                    Appearance
                </h2>

                <div class="small text-body-secondary">
                    Personalize your DM controls and the public display separately.
                </div>

            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Close">
            </button>

        </div>


        <div class="offcanvas-body">

            @* ====================================================
               DM THEME - LOCAL TO THIS BROWSER
               ==================================================== *@

            <section class="dm-theme-section"
                     aria-labelledby="dmPersonalThemeHeading">

                <div class="mb-3">

                    <h3 class="h6 mb-1"
                        id="dmPersonalThemeHeading">
                        My Theme
                    </h3>

                    <div class="small text-body-secondary">
                        Changes only this DM browser and saves on this device.
                    </div>

                </div>


                <div class="dm-theme-grid"
                     aria-label="DM interface theme">

                    <button type="button"
                            class="dm-theme-choice"
                            data-dm-theme-choice="dark"
                            aria-pressed="false">

                        <span class="dm-theme-swatch dm-theme-swatch--dark"
                              aria-hidden="true"></span>

                        <span>Dark</span>

                    </button>


                    <button type="button"
                            class="dm-theme-choice"
                            data-dm-theme-choice="light"
                            aria-pressed="false">

                        <span class="dm-theme-swatch dm-theme-swatch--light"
                              aria-hidden="true"></span>

                        <span>Light</span>

                    </button>


                    <button type="button"
                            class="dm-theme-choice"
                            data-dm-theme-choice="parchment"
                            aria-pressed="false">

                        <span class="dm-theme-swatch dm-theme-swatch--parchment"
                              aria-hidden="true"></span>

                        <span>Parchment</span>

                    </button>


                    <button type="button"
                            class="dm-theme-choice"
                            data-dm-theme-choice="arcane"
                            aria-pressed="false">

                        <span class="dm-theme-swatch dm-theme-swatch--arcane"
                              aria-hidden="true"></span>

                        <span>Arcane</span>

                    </button>


                    <button type="button"
                            class="dm-theme-choice"
                            data-dm-theme-choice="infernal"
                            aria-pressed="false">

                        <span class="dm-theme-swatch dm-theme-swatch--infernal"
                              aria-hidden="true"></span>

                        <span>Infernal</span>

                    </button>


                    <button type="button"
                            class="dm-theme-choice"
                            data-dm-theme-choice="frost"
                            aria-pressed="false">

                        <span class="dm-theme-swatch dm-theme-swatch--frost"
                              aria-hidden="true"></span>

                        <span>Frost</span>

                    </button>


                    <button type="button"
                            class="dm-theme-choice"
                            data-dm-theme-choice="forest"
                            aria-pressed="false">

                        <span class="dm-theme-swatch dm-theme-swatch--forest"
                              aria-hidden="true"></span>

                        <span>Forest</span>

                    </button>


                    <button type="button"
                            class="dm-theme-choice"
                            data-dm-theme-choice="blood-moon"
                            aria-pressed="false">

                        <span class="dm-theme-swatch dm-theme-swatch--blood-moon"
                              aria-hidden="true"></span>

                        <span>Blood Moon</span>

                    </button>

                </div>

            </section>


            <hr class="dm-theme-divider" />


            @* ====================================================
               DISPLAY THEME - BROADCAST TO PUBLIC DISPLAYS
               ==================================================== *@

            <section class="dm-theme-section"
                     aria-labelledby="dmDisplayThemeHeading">

                <div class="mb-3">

                    <h3 class="h6 mb-1"
                        id="dmDisplayThemeHeading">
                        Display Theme
                    </h3>

                    <div class="small text-body-secondary">
                        Changes connected public displays immediately.
                    </div>

                </div>


                <div class="dm-theme-grid">

                    <form method="post"
                          asp-page-handler="SetDisplayTheme">

                        <input type="hidden"
                               name="theme"
                               value="dark" />

                        <button type="submit"
                                class="dm-theme-choice @(Model.CurrentDisplayTheme == "dark" ? "is-active" : "")"
                                aria-pressed="@(Model.CurrentDisplayTheme == "dark" ? "true" : "false")">

                            <span class="dm-theme-swatch dm-theme-swatch--dark"
                                  aria-hidden="true"></span>

                            <span>Dark</span>

                        </button>

                    </form>


                    <form method="post"
                          asp-page-handler="SetDisplayTheme">

                        <input type="hidden"
                               name="theme"
                               value="light" />

                        <button type="submit"
                                class="dm-theme-choice @(Model.CurrentDisplayTheme == "light" ? "is-active" : "")"
                                aria-pressed="@(Model.CurrentDisplayTheme == "light" ? "true" : "false")">

                            <span class="dm-theme-swatch dm-theme-swatch--light"
                                  aria-hidden="true"></span>

                            <span>Light</span>

                        </button>

                    </form>


                    <form method="post"
                          asp-page-handler="SetDisplayTheme">

                        <input type="hidden"
                               name="theme"
                               value="parchment" />

                        <button type="submit"
                                class="dm-theme-choice @(Model.CurrentDisplayTheme == "parchment" ? "is-active" : "")"
                                aria-pressed="@(Model.CurrentDisplayTheme == "parchment" ? "true" : "false")">

                            <span class="dm-theme-swatch dm-theme-swatch--parchment"
                                  aria-hidden="true"></span>

                            <span>Parchment</span>

                        </button>

                    </form>


                    <form method="post"
                          asp-page-handler="SetDisplayTheme">

                        <input type="hidden"
                               name="theme"
                               value="arcane" />

                        <button type="submit"
                                class="dm-theme-choice @(Model.CurrentDisplayTheme == "arcane" ? "is-active" : "")"
                                aria-pressed="@(Model.CurrentDisplayTheme == "arcane" ? "true" : "false")">

                            <span class="dm-theme-swatch dm-theme-swatch--arcane"
                                  aria-hidden="true"></span>

                            <span>Arcane</span>

                        </button>

                    </form>


                    <form method="post"
                          asp-page-handler="SetDisplayTheme">

                        <input type="hidden"
                               name="theme"
                               value="infernal" />

                        <button type="submit"
                                class="dm-theme-choice @(Model.CurrentDisplayTheme == "infernal" ? "is-active" : "")"
                                aria-pressed="@(Model.CurrentDisplayTheme == "infernal" ? "true" : "false")">

                            <span class="dm-theme-swatch dm-theme-swatch--infernal"
                                  aria-hidden="true"></span>

                            <span>Infernal</span>

                        </button>

                    </form>


                    <form method="post"
                          asp-page-handler="SetDisplayTheme">

                        <input type="hidden"
                               name="theme"
                               value="frost" />

                        <button type="submit"
                                class="dm-theme-choice @(Model.CurrentDisplayTheme == "frost" ? "is-active" : "")"
                                aria-pressed="@(Model.CurrentDisplayTheme == "frost" ? "true" : "false")">

                            <span class="dm-theme-swatch dm-theme-swatch--frost"
                                  aria-hidden="true"></span>

                            <span>Frost</span>

                        </button>

                    </form>


                    <form method="post"
                          asp-page-handler="SetDisplayTheme">

                        <input type="hidden"
                               name="theme"
                               value="forest" />

                        <button type="submit"
                                class="dm-theme-choice @(Model.CurrentDisplayTheme == "forest" ? "is-active" : "")"
                                aria-pressed="@(Model.CurrentDisplayTheme == "forest" ? "true" : "false")">

                            <span class="dm-theme-swatch dm-theme-swatch--forest"
                                  aria-hidden="true"></span>

                            <span>Forest</span>

                        </button>

                    </form>


                    <form method="post"
                          asp-page-handler="SetDisplayTheme">

                        <input type="hidden"
                               name="theme"
                               value="blood-moon" />

                        <button type="submit"
                                class="dm-theme-choice @(Model.CurrentDisplayTheme == "blood-moon" ? "is-active" : "")"
                                aria-pressed="@(Model.CurrentDisplayTheme == "blood-moon" ? "true" : "false")">

                            <span class="dm-theme-swatch dm-theme-swatch--blood-moon"
                                  aria-hidden="true"></span>

                            <span>Blood Moon</span>

                        </button>

                    </form>

                </div>


                <div class="small text-body-secondary mt-3">
                    The display can still choose a local theme. A DM selection
                    overrides connected displays when it is sent.
                </div>

            </section>

        </div>

    </div>


    @* ============================================================
       CONDITION MANAGEMENT MODAL
       ============================================================ *@

    @if (Model.ConditionCombatant is not null)
    {
        var conditionCombatant =
            Model.ConditionCombatant;

        <div class="modal fade"
             id="dmConditionsModal"
             tabindex="-1"
             aria-labelledby="dmConditionsModalLabel"
             aria-hidden="true">

            <div class="modal-dialog
                modal-dialog-centered
                modal-dialog-scrollable">

                <div class="modal-content">

                    <div class="modal-header">

                        <div>
                            <h2 class="modal-title fs-5"
                                id="dmConditionsModalLabel">
                                Manage Conditions
                            </h2>

                            <div class="small text-muted">
                                @conditionCombatant.Name
                            </div>
                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        @if (TempData["ConditionError"]
                             is string conditionError)
                        {
                            <div class="alert alert-danger">
                                @conditionError
                            </div>
                        }

                        <div class="fw-semibold mb-2">
                            Standard Conditions
                        </div>

                        <div class="condition-selector-grid">

                            @foreach (var conditionName
                                      in Model.StandardConditions)
                            {
                                var existing =
                                    conditionCombatant
                                        .Conditions
                                        .FirstOrDefault(
                                            x =>
                                                string.Equals(
                                                    x.Name,
                                                    conditionName,
                                                    StringComparison.OrdinalIgnoreCase));

                                var isActive =
                                    existing is not null;

                                var styleKey =
                                    Dnd5eConditionCatalog
                                        .GetStyleKey(
                                            conditionName);

                                <form method="post"
                                      asp-page-handler="ToggleCombatantCondition">

                                    <input type="hidden"
                                           name="combatantId"
                                           value="@conditionCombatant.Id" />

                                    <input type="hidden"
                                           name="conditionName"
                                           value="@conditionName" />

                                    <button type="submit"
                                            class="condition-option
                                        condition-@styleKey
                                        @(isActive ? "is-active" : "")">

                                        <span class="condition-option-marker">
                                            @(isActive ? "✓" : "")
                                        </span>

                                        <span>
                                            @conditionName
                                        </span>

                                    </button>

                                </form>
                            }

                        </div>

                        <hr class="my-4" />

                        <div class="fw-semibold mb-2">
                            Custom Conditions
                        </div>

                        @foreach (var condition
                                  in conditionCombatant
                                      .Conditions
                                      .Where(x => x.IsCustom)
                                      .OrderBy(x => x.Name))
                        {
                            <div class="custom-condition-row mb-2">

                                <div>
                                    <div class="fw-semibold">
                                        @condition.Name
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        condition.Notes))
                                    {
                                        <div class="small text-muted">
                                            @condition.Notes
                                        </div>
                                    }
                                </div>

                                <form method="post"
                                      asp-page-handler="RemoveCombatantCondition">

                                    <input type="hidden"
                                           name="combatantId"
                                           value="@conditionCombatant.Id" />

                                    <input type="hidden"
                                           name="conditionId"
                                           value="@condition.Id" />

                                    <button type="submit"
                                            class="btn
                                        btn-sm
                                        btn-outline-danger">
                                        Remove
                                    </button>

                                </form>

                            </div>
                        }

                        <form method="post"
                              asp-page-handler="AddCustomCombatantCondition"
                              class="mt-3">

                            <input type="hidden"
                                   name="combatantId"
                                   value="@conditionCombatant.Id" />

                            <div class="mb-2">
                                <label for="dmCustomConditionName"
                                       class="form-label">
                                    Name
                                </label>

                                <input type="text"
                                       id="dmCustomConditionName"
                                       name="customConditionName"
                                       maxlength="100"
                                       class="form-control"
                                       placeholder="Custom condition" />
                            </div>

                            <div class="mb-3">
                                <label for="dmCustomConditionNotes"
                                       class="form-label">
                                    Notes
                                </label>

                                <textarea id="dmCustomConditionNotes"
                                          name="customConditionNotes"
                                          maxlength="1000"
                                          rows="2"
                                          class="form-control"
                                          placeholder="Optional notes"></textarea>
                            </div>

                            <button type="submit"
                                    class="btn
                                btn-outline-primary
                                w-100">
                                Add Custom Condition
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>
    }
    @* Hidden form used by SortableJS *@
    @if (Model.Encounter.IsStarted)
    {
        <form id="reorderForm"
              method="post"
              asp-page-handler="Reorder"
              class="d-none">
        </form>
    }

</div>


@section Scripts {

    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <script src="~/js/dm-theme.js"
            asp-append-version="true">
    </script>

    <script src="~/js/dm-live.js"
            asp-append-version="true">
    </script>
    <script src="~/js/dm-conditions.js"
            asp-append-version="true">
    </script>


    @if (Model.Encounter.IsStarted)
    {
        <script src="~/lib/sortablejs/Sortable.min.js"></script>

        <script src="~/js/dm-initiative.js"
                asp-append-version="true">
        </script>
    }

}
