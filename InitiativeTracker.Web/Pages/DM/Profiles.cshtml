@page "/dm/profiles"
@model InitiativeTracker.Web.Pages.Dm.ProfilesModel

@{
    ViewData["Title"] = "Player Profiles";
}

<div class="container py-4"
     style="max-width: 900px;">

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>
            <h1 class="mb-1">
                Player Profiles
            </h1>

            <div class="text-muted">
                Manage saved players and characters.
            </div>
        </div>

        <a href="/dm/devices"
           class="btn btn-outline-secondary">
            Back to Devices
        </a>

    </div>


    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>


    @if (Model.Profiles.Count == 0)
    {
        <div class="alert alert-secondary">
            No player profiles saved.
        </div>
    }


    @foreach (var profile in Model.Profiles)
    {
        <div class="card mb-3">

            <div class="card-header
                d-flex
                justify-content-between
                align-items-center">

                <div>
                    <strong>
                        @profile.PlayerName
                    </strong>

                    @if (profile.IsReferencedByEncounter)
                    {
                        <span class="badge
                            text-bg-warning
                            ms-2">
                            In Use
                        </span>
                    }
                </div>


                <form method="post"
                      asp-page-handler="DeleteProfile"
                      onsubmit="return confirm('Permanently delete this player profile and all of its saved characters?');">

                    <input type="hidden"
                           name="profileId"
                           value="@profile.ProfileId" />

                    <button type="submit"
                            class="btn
                        btn-sm
                        btn-outline-danger"
                            disabled="@profile.IsReferencedByEncounter">
                        Delete Profile
                    </button>

                </form>

            </div>


            <div class="list-group
                list-group-flush">

                @if (profile.Characters.Count == 0)
                {
                    <div class="list-group-item
                        text-muted">
                        No saved characters.
                    </div>
                }
                else
                {
                    @foreach (var character
                              in profile.Characters)
                    {
                        <div class="list-group-item
                            d-flex
                            justify-content-between
                            align-items-center">

                            <div>
                                @character.CharacterName

                                @if (character.IsInEncounter)
                                {
                                    <span class="badge
                                        text-bg-success
                                        ms-2">
                                        In Encounter
                                    </span>
                                }
                            </div>


                            <form method="post"
                                  asp-page-handler="DeleteCharacter"
                                  onsubmit="return confirm('Permanently delete this character?');">

                                <input type="hidden"
                                       name="characterId"
                                       value="@character.CharacterId" />

                                <button type="submit"
                                        class="btn
                                    btn-sm
                                    btn-outline-danger"
                                        disabled="@character.IsInEncounter">
                                    Delete
                                </button>

                            </form>

                        </div>
                    }
                }

            </div>

        </div>
    }

</div>