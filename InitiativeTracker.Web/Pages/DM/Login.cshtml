@page "/dm/login"
@model InitiativeTracker.Web.Pages.Dm.LoginModel

@{
    ViewData["Title"] = "DM Login";
}

<div class="container py-5"
     style="max-width: 480px;">

    <div class="card">

        <div class="card-body p-4">

            <h1 class="h3 mb-3">
                DM Access
            </h1>

            @if (!Model.CanSubmitPin)
            {
                <p role="status">DM PIN submission is blocked here. Use the configured trusted browser HTTPS endpoint. Agent mutual TLS does not provide browser trust.</p>
                @if (Model.SecureLoginUrl is { } secureUrl)
                { <a href="@secureUrl" class="btn btn-primary">Open secure DM login</a> }
                else
                { <p>Trusted browser HTTPS is not ready. Keep existing gameplay sessions; approved TLS commissioning is required before fresh N8 administration.</p> }
            }
            else
            {
                <p>Enter the DM PIN shown on the hub. N8 network administration also requires a fresh physical network-control code.</p>
                @if (!Request.IsHttps)
                { <p role="status">Legacy gameplay compatibility: this HTTP login is unencrypted and cannot authorize N8 administration. Enabling N8 blocks HTTP PIN submission, including loopback.</p> }
            <form method="post">

                <div class="mb-3">

                    <label asp-for="Pin"
                           class="form-label">
                        DM PIN
                    </label>

                    <input asp-for="Pin"
                           type="password"
                           inputmode="numeric"
                           maxlength="6"
                           autocomplete="off"
                           class="form-control
                    form-control-lg" />

                    <span asp-validation-for="Pin"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn
                    btn-primary
                    w-100">
                    Continue
                </button>

            </form>
            }

        </div>

    </div>

</div>
