@page "/dm/login"
@model InitiativeTracker.Web.Pages.Dm.LoginModel

@{
    ViewData["Title"] = "DM Login";
}

<div class="container py-5"
     style="max-width: 480px;">

    <div class="card">

        <div class="card-body p-4">

            <h1 class="h3 mb-3">
                DM Access
            </h1>

            <p class="text-muted">
                Enter the DM PIN shown on the hub.
            </p>

            <form method="post">

                <div class="mb-3">

                    <label asp-for="Pin"
                           class="form-label">
                        DM PIN
                    </label>

                    <input asp-for="Pin"
                           type="password"
                           inputmode="numeric"
                           maxlength="6"
                           autocomplete="off"
                           class="form-control
                    form-control-lg" />

                    <span asp-validation-for="Pin"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn
                    btn-primary
                    w-100">
                    Continue
                </button>

            </form>

        </div>

    </div>

</div>