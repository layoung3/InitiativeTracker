@page "/dm/join"
@model InitiativeTracker.Web.Pages.Dm.JoinModel

@{
    ViewData["Title"] = "Join Game";
}

<div class="container py-4"
     style="max-width: 800px;">

    <div class="d-flex
        flex-column
        flex-sm-row
        justify-content-between
        align-items-sm-center
        gap-3
        mb-4">

        <div>

            <h1 class="mb-1">
                Join Game
            </h1>

            <div class="text-muted">
                Players can scan the QR code or enter the game code.
            </div>

        </div>


        <a href="/dm"
           class="btn btn-outline-secondary">
            Back to DM
        </a>

    </div>


    <div class="card">

        <div class="card-body
            text-center
            p-4
            p-md-5">


            <img src="/join/qr"
                 alt="Player join QR code"
                 class="img-fluid mb-4"
                 style="width: min(360px, 80vw);" />


            <div class="text-muted mb-2">
                Game Code
            </div>


            <div class="display-3
                fw-bold
                font-monospace
                mb-3">
                @Model.Session.JoinCode
            </div>


            <div class="text-muted mb-4">
                Scan with your phone camera or open the hub
                address below and enter the game code.
            </div>


            <div class="border rounded p-3 text-start">

                <div class="small
                    text-body-secondary
                    mb-1">
                    Hub address
                </div>

                <div class="font-monospace
                    fw-semibold
                    user-select-all
                    text-break">
                    @Model.HubAddress
                </div>

                <div class="small
                    text-body-secondary
                    mt-2">
                    Phones and tablets must be on the same local
                    network as the InitiativeTracker hub.
                </div>

            </div>


            <details class="mt-3 text-start">

                <summary class="small text-body-secondary">
                    Direct invitation link
                </summary>

                <div class="font-monospace
                    small
                    user-select-all
                    text-break
                    mt-2">
                    @Model.PlayerJoinUrl
                </div>

            </details>

        </div>

    </div>

</div>
