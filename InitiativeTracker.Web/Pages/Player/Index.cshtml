@page "/player"
@inject InitiativeTracker.Web.Infrastructure.ITrustedBrowserOrigin SecureOrigin
@model InitiativeTracker.Web.Pages.Player.IndexModel

@{
    ViewData["Title"] = "Player";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/player.css"
          asp-append-version="true" />
}

<div class="container py-3 py-lg-4 player-page">
    <img src="@InitiativeTracker.Web.Services.MediaPaths.CampaignBanner" class="tracker-banner tracker-campaign-banner mb-3" data-tracker-media alt="Campaign banner" />

    <div class="card player-shell-card">

        <div class="card-body p-3 p-md-4">

            <div class="player-page-header mb-4">
                <img src="@InitiativeTracker.Web.Services.MediaPaths.ProfilePortrait(Model.PlayerProfileId)" class="tracker-portrait" data-tracker-media alt="Your player portrait" width="64" height="64" />

                <div>

                    <div class="player-page-eyebrow">
                        Connected as
                    </div>

                    <h1 class="h3 mb-0">
                        @Model.Player.Name
                    </h1>

                </div>


                <div class="player-header-actions">
                    <a href="/appearance/profile/@Model.PlayerProfileId" class="btn btn-outline-secondary">Player portrait</a>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#playerAccountPanel"
                            aria-controls="playerAccountPanel">
                        Account
                    </button>

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#playerAppearancePanel"
                            aria-controls="playerAppearancePanel">
                        Appearance
                    </button>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(
                     Model.NewRecoveryKey))
            {
                <div class="alert alert-warning">

                    <div class="fw-bold mb-1">
                        New recovery key
                    </div>

                    <div class="mb-2">
                        Save this somewhere safe. Your previous
                        recovery key no longer works.
                    </div>

                    <div class="player-recovery-key">
                        @Model.NewRecoveryKey
                    </div>

                </div>
            }


            @if (TempData["AccountError"] is string accountError)
            {
                <div class="alert alert-danger">
                    @accountError
                </div>
            }


            @if (Model.Characters.Count == 0)
            {
                <div class="alert alert-secondary">
                    You do not have any characters yet.
                </div>
            }


            @foreach (var character in Model.Characters)
            {
                var combatant =
                    Model.Encounter.Combatants
                        .SingleOrDefault(
                            x =>
                                x.PlayerCharacterId ==
                                character.Id);

                var isControlled =
                    combatant is not null &&
                    combatant.AssignedPlayerProfileId ==
                        Model.PlayerProfileId;

                var isCurrent =
                    combatant is not null &&
                    Model.Encounter.CurrentCombatantId ==
                        combatant.Id;

                var displayCurrentHp =
                    combatant?.CurrentHp ??
                    character.CurrentHp;

                var displayMaxHp =
                    combatant?.MaxHp ??
                    character.MaxHp;

                var displayTemporaryHp =
                    combatant?.TemporaryHp ??
                    character.TemporaryHp;

                var hpPercent =
                    displayMaxHp > 0
                        ? Math.Clamp(
                            (int)Math.Round(
                                displayCurrentHp * 100.0 /
                                displayMaxHp),
                            0,
                            100)
                        : 0;


                <div class="card mb-3 player-character-card @(isCurrent && isControlled ? "is-current" : "")">

                    <div class="card-body">

                        @* ====================================================
                           CHARACTER SUMMARY
                           ==================================================== *@

                        <div class="d-flex
                                    flex-column
                                    flex-sm-row
                                    justify-content-between
                                    gap-3">

                            <div class="d-flex
                                        align-items-center
                                        gap-3">

                                <img src="@InitiativeTracker.Web.Services.MediaPaths.CharacterPortrait(character.Id)" class="tracker-portrait" data-tracker-media alt="Portrait of @character.Name" width="64" height="64" />


                                <div>

                                    <div class="d-flex
                                                flex-wrap
                                                align-items-center
                                                gap-2">

                                        <h2 class="h4 mb-0">
                                            @character.Name
                                        </h2>


                                        @if (combatant is null && !Model.Encounter.IsStarted)
                                        {
                                            <form method="post" asp-page-handler="AddCharacter">
                                                <input type="hidden" name="characterId" value="@character.Id" />
                                                <button class="btn btn-primary" type="submit">Add to encounter</button>
                                            </form>
                                        }
                                        @if ((combatant?.ExhaustionLevel ?? character.ExhaustionLevel) > 0)
                                        {
                                            <span class="badge text-bg-warning">Exhaustion @(combatant?.ExhaustionLevel ?? character.ExhaustionLevel)</span>
                                        }
                                        @if (isCurrent &&
                                             isControlled)
                                        {
                                            <span class="badge
                                                         text-bg-primary">
                                                Your Turn
                                            </span>
                                        }
                                        else if (combatant is not null &&
                                                 Model.Encounter.IsStarted)
                                        {
                                            <span class="badge
                                                         text-bg-success">
                                                In Encounter
                                            </span>
                                        }

                                    </div>


                                    <div class="text-muted small mt-1">

                                        Level @character.Level

                                        <span class="mx-1">
                                            ·
                                        </span>

                                        HP
                                        @displayCurrentHp
                                        /
                                        @displayMaxHp

                                        @if (displayTemporaryHp > 0)
                                        {
                                            <span class="badge
                                                         text-bg-info
                                                         ms-1">
                                                +@displayTemporaryHp Temp
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <div class="player-character-actions">

                                <a asp-page="/Player/Character"
                                   asp-route-id="@character.Id"
                                   class="btn
                                          btn-outline-primary">
                                    Character Sheet
                                </a>

                            </div>

                        </div>


                        @* HP BAR *@
                        @if (displayMaxHp > 0)
                        {
                            <div class="progress
                                        player-hp-progress
                                        mt-3"
                                 role="progressbar"
                                 aria-label="Character health"
                                 aria-valuenow="@displayCurrentHp"
                                 aria-valuemin="0"
                                 aria-valuemax="@displayMaxHp">

                                <div class="progress-bar"
                                     style="width: @hpPercent%;">
                                </div>

                            </div>
                        }


                        @* ====================================================
                           PRE-COMBAT INITIATIVE
                           ==================================================== *@

                        @if (combatant is not null &&
                             !Model.Encounter.IsStarted)
                        {
                            <div class="player-encounter-panel
                                        mt-3
                                        pt-3">

                                <form method="post"
                                      asp-page-handler="SetInitiative"
                                      class="row
                                             g-2
                                             align-items-end">

                                    <input type="hidden"
                                           name="characterId"
                                           value="@character.Id" />


                                    <div class="col">

                                        <label class="form-label small">
                                            Initiative
                                        </label>

                                        <input type="number"
                                               name="initiative"
                                               value="@combatant.Initiative"
                                               class="form-control" />

                                    </div>


                                    <div class="col-auto">

                                        <button type="submit"
                                                class="btn
                                                       btn-primary">
                                            Set Initiative
                                        </button>

                                    </div>

                                </form>

                            </div>
                        }


                        @* ====================================================
                           ACTIVE ENCOUNTER
                           ==================================================== *@

                        @if (combatant is not null &&
                             Model.Encounter.IsStarted)
                        {
                            <div class="player-encounter-panel
                                        mt-3
                                        pt-3">

                                @if (!isControlled)
                                {
                                    <div class="text-muted small">
                                        This character is currently controlled
                                        by the DM or another player.
                                    </div>
                                }
                                else
                                {
                                    @if (combatant.CurrentHp.HasValue)
                                    {
                                        <div class="d-flex
                                                    flex-column
                                                    flex-lg-row
                                                    justify-content-between
                                                    align-items-lg-center
                                                    gap-3">

                                            @* QUICK HP *@
                                            <div>

                                                <div class="small
                                                            text-muted
                                                            mb-1">
                                                    Quick HP
                                                </div>

                                                <div class="d-flex
                                                            flex-wrap
                                                            align-items-center
                                                            gap-1">

                                                    @foreach (var amount
                                                              in new[] { -5, -1, 1, 5 })
                                                    {
                                                        <form method="post"
                                                              asp-page-handler="AdjustHp">

                                                            <input type="hidden"
                                                                   name="combatantId"
                                                                   value="@combatant.Id" />

                                                            <button type="submit"
                                                                    name="amount"
                                                                    value="@amount"
                                                                    class="btn
                                                                           btn-sm
                                                                           @(amount < 0
                                                                               ? "btn-outline-danger"
                                                                               : "btn-outline-success")">

                                                                @(amount > 0
                                                                    ? $"+{amount}"
                                                                    : amount.ToString())

                                                            </button>

                                                        </form>
                                                    }

                                                </div>

                                            </div>


                                            @if (isCurrent)
                                            {
                                                <form method="post"
                                                      asp-page-handler="EndTurn">

                                                    <button type="submit"
                                                            class="btn
                                                                   btn-primary">
                                                        End Turn →
                                                    </button>

                                                </form>
                                            }

                                        </div>
                                    }
                                }

                            </div>
                        }

                    </div>

                </div>
            }

            @if (Model.TemporaryControlledCombatants.Count > 0)
            {
                <div class="mt-4">

                    <h2 class="h5 mb-3">
                        Temporary Controls
                    </h2>


                    @foreach (var combatant in Model.TemporaryControlledCombatants)
                    {
                        <div class="card mb-2">

                            <div class="card-body">

                                <div class="d-flex
                                    justify-content-between
                                    align-items-center">

                                    <div>

                                        <div class="fw-bold">
                                            @combatant.Name
                                        </div>

                                        <div class="small text-muted">

                                            HP
                                            @(combatant.CurrentHp?.ToString() ?? "—")
                                            /
                                            @(combatant.MaxHp?.ToString() ?? "—")

                                            @if (Model.Encounter.IsStarted)
                                            {
                                                <span>
                                                    · Initiative
                                                    @combatant.Initiative
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>

                                @{
                                    var isCurrent =
                                        Model.Encounter.CurrentCombatantId ==
                                        combatant.Id;
                                }


                                @if (isCurrent)
                                {
                                    <div class="alert
                                                alert-primary
                                                fw-bold
                                                mt-3">
                                        Your Turn
                                    </div>
                                }


                                @if (combatant.CurrentHp.HasValue)
                                {
                                    <div class="mt-3">

                                        <div class="d-flex
                                                    justify-content-between
                                                    align-items-center
                                                    mb-2">

                                            <strong>
                                                HP
                                            </strong>

                                            <span class="fw-bold">
                                                @combatant.CurrentHp
                                                /
                                                @(combatant.MaxHp?.ToString() ?? "—")
                                            </span>

                                        </div>


                                        @if (combatant.TemporaryHp > 0)
                                        {
                                            <div class="mb-2">

                                                <span class="badge text-bg-info">
                                                    Temp @combatant.TemporaryHp
                                                </span>

                                            </div>
                                        }


                                        <div class="d-flex
                                                    flex-wrap
                                                    gap-1">

                                            @foreach (var amount in new[] { -5, -1, 1, 5 })
                                            {
                                                <form method="post"
                                                      asp-page-handler="AdjustHp">

                                                    <input type="hidden"
                                                           name="combatantId"
                                                           value="@combatant.Id" />

                                                    <button type="submit"
                                                            name="amount"
                                                            value="@amount"
                                                            class="btn
                                                                   @(amount < 0
                                                                       ? "btn-outline-danger"
                                                                       : "btn-outline-success")">
                                                        @(amount > 0
                                                            ? $"+{amount}"
                                                            : amount.ToString())
                                                    </button>

                                                </form>
                                            }

                                        </div>
                                        <div class="row g-2 mt-2">

                                            <div class="col-sm-6">

                                                <form method="post"
                                                      asp-page-handler="SetHp">

                                                    <input type="hidden"
                                                           name="combatantId"
                                                           value="@combatant.Id" />

                                                    <label class="form-label small">
                                                        Current HP
                                                    </label>

                                                    <div class="input-group">

                                                        <input type="number"
                                                               name="currentHp"
                                                               value="@combatant.CurrentHp"
                                                               min="0"
                                                               class="form-control" />

                                                        <button type="submit"
                                                                class="btn btn-outline-secondary">
                                                            Set
                                                        </button>

                                                    </div>

                                                </form>

                                            </div>


                                            <div class="col-sm-6">

                                                <form method="post"
                                                      asp-page-handler="SetTemporaryHp">

                                                    <input type="hidden"
                                                           name="combatantId"
                                                           value="@combatant.Id" />

                                                    <label class="form-label small">
                                                        Temporary HP
                                                    </label>

                                                    <div class="input-group">

                                                        <input type="number"
                                                               name="temporaryHp"
                                                               value="@combatant.TemporaryHp"
                                                               min="0"
                                                               class="form-control" />

                                                        <button type="submit"
                                                                class="btn btn-outline-info">
                                                            Set
                                                        </button>

                                                    </div>

                                                </form>

                                            </div>

                                        </div>

                                    </div>
                                }


                                @if (isCurrent)
                                {
                                    <form method="post"
                                          asp-page-handler="EndTurn"
                                          class="mt-3">

                                        <button type="submit"
                                                class="btn
                                                       btn-primary
                                                       w-100">
                                            End Turn →
                                        </button>

                                    </form>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

            <div class="card mt-4 player-create-card">

                <div class="card-body">

                    <h2 class="h5">
                        Create Character
                    </h2>

                    <form method="post"
                          asp-page-handler="CreateCharacter"
                          class="player-create-form">

                        <input type="text"
                               name="name"
                               class="form-control"
                               placeholder="Character name"
                               required />

                        <button type="submit"
                                class="btn btn-outline-primary">
                            Create
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="offcanvas offcanvas-end player-account-panel"
     tabindex="-1"
     id="playerAccountPanel"
     aria-labelledby="playerAccountPanelLabel">

    <div class="offcanvas-header">

        <div>

            <h2 class="offcanvas-title h5 mb-1"
                id="playerAccountPanelLabel">
                Player Account
            </h2>

            <div class="small text-body-secondary">
                Recovery and linked devices for this hub.
            </div>

        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Close">
        </button>

    </div>


    <div class="offcanvas-body">

        <section class="mb-4">

            <h3 class="h6 mb-1">
                Recovery Key
            </h3>

            <p class="small text-body-secondary">
                If you lose your key but still have any linked
                device, generate a new one here. The old key
                stops working immediately.
            </p>

            <form method="post"
                  asp-page-handler="RegenerateRecoveryKey"
                  onsubmit="return confirm('Generate a new recovery key? Your previous key will stop working immediately.');">

                <button type="submit"
                        class="btn
                               btn-outline-warning
                               w-100">
                    Generate New Recovery Key
                </button>

            </form>

        </section>


        <hr />


        <section class="mb-4">

            <div class="d-flex
                        justify-content-between
                        align-items-center
                        gap-2
                        mb-2">

                <h3 class="h6 mb-0">
                    Linked Devices
                </h3>

                <span class="badge text-bg-secondary">
                    @Model.LinkedDevices.Count
                </span>

            </div>

            <div class="small text-body-secondary mb-3">
                Each browser has its own revocable credential.
            </div>


            <div class="d-flex flex-column gap-2">

                @foreach (var device
                          in Model.LinkedDevices)
                {
                    var isCurrent =
                        device.Id ==
                        Model.CurrentDeviceCredentialId;

                    <div class="player-device-card">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    gap-2
                                    mb-2">

                            <div>

                                <div class="fw-semibold">
                                    @device.Name
                                </div>

                                <div class="small
                                            text-body-secondary">
                                    Last seen
                                    @device.LastSeenAtUtc.ToString("u")
                                </div>

                            </div>


                            @if (isCurrent)
                            {
                                <span class="badge text-bg-primary">
                                    This device
                                </span>
                            }

                        </div>


                        <form method="post"
                              asp-page-handler="RenameDevice"
                              class="d-flex gap-2 mb-2">

                            <input type="hidden"
                                   name="credentialId"
                                   value="@device.Id" />

                            <input type="text"
                                   name="deviceName"
                                   value="@device.Name"
                                   maxlength="100"
                                   class="form-control
                                          form-control-sm"
                                   aria-label="Device name" />

                            <button type="submit"
                                    class="btn
                                           btn-sm
                                           btn-outline-secondary">
                                Rename
                            </button>

                        </form>


                        @if (!isCurrent)
                        {
                            <form method="post"
                                  asp-page-handler="RevokeDevice"
                                  onsubmit="return confirm('Revoke this device? It will need the recovery key to link again.');">

                                <input type="hidden"
                                       name="credentialId"
                                       value="@device.Id" />

                                <button type="submit"
                                        class="btn
                                               btn-sm
                                               btn-outline-danger
                                               w-100">
                                    Revoke Device
                                </button>

                            </form>
                        }

                    </div>
                }

            </div>

        </section>


        <hr />


        @if (SecureOrigin.TrustedRequest(Context))
        {
            <section class="mb-4">
                <h3 class="h6">Remembered Browser Approvals</h3>
                <p class="small text-body-secondary">
                    Review or revoke optional 30-day approval for this game's browser sessions.
                </p>
                <a href="/secure-access/devices" class="btn btn-outline-secondary w-100">
                    Manage Remembered Browsers
                </a>
            </section>
            <hr />
        }

        <section>

            <h3 class="h6">
                This Device
            </h3>

            <form method="post"
                  asp-page-handler="SignOut"
                  class="mb-2">

                <button type="submit"
                        class="btn
                               btn-outline-secondary
                               w-100">
                    Sign Out of This Game
                </button>

            </form>

            <div class="small text-body-secondary mb-3">
                Signing out keeps this browser linked, so you can
                quickly continue as this player next time.
            </div>


            <form method="post"
                  asp-page-handler="ForgetThisDevice"
                  onsubmit="return confirm('Forget this device? You will need your recovery key to link it again.');">

                <button type="submit"
                        class="btn
                               btn-outline-danger
                               w-100">
                    Forget This Device
                </button>

            </form>

        </section>

    </div>

</div>


<partial name="_PlayerAppearance" />

@section Scripts {

    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <script src="~/js/player-theme.js"
            asp-append-version="true"></script>

    <script src="~/js/player-presence.js"
            asp-append-version="true"></script>

    <script src="~/js/player.js"
            asp-append-version="true"></script>

}
