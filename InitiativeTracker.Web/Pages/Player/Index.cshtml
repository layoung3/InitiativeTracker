@page "/player"
@model InitiativeTracker.Web.Pages.Player.IndexModel

@{
    ViewData["Title"] = "Player";
}

<div class="container py-5"
     style="max-width: 600px;">

    <div class="card">

        <div class="card-body p-5">

            <div class="text-center mb-4">

                <div class="text-muted mb-2">
                    Connected as
                </div>

                <h1 class="h3 mb-0">
                    @Model.Player.Name
                </h1>

            </div>


            @if (Model.Characters.Count == 0)
            {
                <div class="alert alert-secondary">
                    You do not have any characters yet.
                </div>
            }


            @foreach (var character in Model.Characters)
            {
                var combatant =
                    Model.Encounter.Combatants
                        .SingleOrDefault(
                            x =>
                                x.PlayerCharacterId ==
                                character.Id);

                var isControlled =
                    combatant is not null &&
                    combatant.AssignedPlayerProfileId ==
                        Model.PlayerProfileId;

                var isCurrent =
                    combatant is not null &&
                    Model.Encounter.CurrentCombatantId ==
                        combatant.Id;

                <div class="card mb-3">

                    <div class="card-body">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start">

                            <div>

                                <h2 class="h4 mb-1">
                                    @character.Name
                                </h2>

                                <div class="text-muted">
                                    Level @character.Level
                                    ·
                                    HP @character.CurrentHp / @character.MaxHp
                                </div>

                            </div>

                        </div>


                        @if (combatant is not null &&
                             !Model.Encounter.IsStarted)
                        {
                            <hr />

                            <form method="post"
                                  asp-page-handler="SetInitiative"
                                  class="row
                                         g-2
                                         align-items-end">

                                <input type="hidden"
                                       name="characterId"
                                       value="@character.Id" />

                                <div class="col">

                                    <label class="form-label">
                                        Initiative
                                    </label>

                                    <input type="number"
                                           name="initiative"
                                           value="@combatant.Initiative"
                                           class="form-control" />

                                </div>

                                <div class="col-auto">

                                    <button type="submit"
                                            class="btn btn-primary">
                                        Set Initiative
                                    </button>

                                </div>

                            </form>
                        }
                        else if (combatant is not null)
                        {
                            <hr />


                            @if (isCurrent)
                            {
                                <div class="alert
                                            alert-primary
                                            fw-bold">
                                    Your Turn
                                </div>
                            }
                            else
                            {
                                <div class="alert
                                            alert-success
                                            py-2">
                                    In current encounter
                                </div>
                            }


                            @if (!isControlled)
                            {
                                <div class="text-muted small">
                                    Currently controlled by another player or the DM.
                                </div>
                            }
                            else
                            {
                                @if (combatant.CurrentHp.HasValue)
                                {
                                    <div class="mb-3">

                                        <div class="d-flex
                                                    justify-content-between
                                                    align-items-center
                                                    mb-2">

                                            <strong>
                                                HP
                                            </strong>

                                            <span class="fs-5 fw-bold">
                                                @combatant.CurrentHp
                                                /
                                                @(combatant.MaxHp?.ToString() ?? "—")
                                            </span>

                                        </div>


                                        @if (combatant.TemporaryHp > 0)
                                        {
                                            <div class="mb-2">
                                                <span class="badge text-bg-info">
                                                    Temporary HP:
                                                    @combatant.TemporaryHp
                                                </span>
                                            </div>
                                        }


                                        <div class="d-flex
                                                    flex-wrap
                                                    gap-1
                                                    mb-3">

                                            <form method="post"
                                                  asp-page-handler="AdjustHp">

                                                <input type="hidden"
                                                       name="combatantId"
                                                       value="@combatant.Id" />

                                                <button type="submit"
                                                        name="amount"
                                                        value="-5"
                                                        class="btn
                                                               btn-outline-danger">
                                                    -5
                                                </button>

                                            </form>


                                            <form method="post"
                                                  asp-page-handler="AdjustHp">

                                                <input type="hidden"
                                                       name="combatantId"
                                                       value="@combatant.Id" />

                                                <button type="submit"
                                                        name="amount"
                                                        value="-1"
                                                        class="btn
                                                               btn-outline-danger">
                                                    -1
                                                </button>

                                            </form>


                                            <form method="post"
                                                  asp-page-handler="AdjustHp">

                                                <input type="hidden"
                                                       name="combatantId"
                                                       value="@combatant.Id" />

                                                <button type="submit"
                                                        name="amount"
                                                        value="1"
                                                        class="btn
                                                               btn-outline-success">
                                                    +1
                                                </button>

                                            </form>


                                            <form method="post"
                                                  asp-page-handler="AdjustHp">

                                                <input type="hidden"
                                                       name="combatantId"
                                                       value="@combatant.Id" />

                                                <button type="submit"
                                                        name="amount"
                                                        value="5"
                                                        class="btn
                                                               btn-outline-success">
                                                    +5
                                                </button>

                                            </form>

                                        </div>


                                        <div class="row g-2">

                                            <div class="col-sm-6">

                                                <form method="post"
                                                      asp-page-handler="SetHp">

                                                    <input type="hidden"
                                                           name="combatantId"
                                                           value="@combatant.Id" />

                                                    <label class="form-label small">
                                                        Current HP
                                                    </label>

                                                    <div class="input-group">

                                                        <input type="number"
                                                               name="currentHp"
                                                               value="@combatant.CurrentHp"
                                                               min="0"
                                                               class="form-control" />

                                                        <button type="submit"
                                                                class="btn
                                                                       btn-outline-secondary">
                                                            Set
                                                        </button>

                                                    </div>

                                                </form>

                                            </div>


                                            <div class="col-sm-6">

                                                <form method="post"
                                                      asp-page-handler="SetTemporaryHp">

                                                    <input type="hidden"
                                                           name="combatantId"
                                                           value="@combatant.Id" />

                                                    <label class="form-label small">
                                                        Temporary HP
                                                    </label>

                                                    <div class="input-group">

                                                        <input type="number"
                                                               name="temporaryHp"
                                                               value="@combatant.TemporaryHp"
                                                               min="0"
                                                               class="form-control" />

                                                        <button type="submit"
                                                                class="btn
                                                                       btn-outline-info">
                                                            Set
                                                        </button>

                                                    </div>

                                                </form>

                                            </div>

                                        </div>

                                    </div>
                                }


                                @if (isCurrent)
                                {
                                    <form method="post"
                                          asp-page-handler="EndTurn">

                                        <button type="submit"
                                                class="btn
                                                       btn-primary
                                                       btn-lg
                                                       w-100">
                                            End Turn →
                                        </button>

                                    </form>
                                }
                            }
                        }

                    </div>

                </div>
            }

            @if (Model.TemporaryControlledCombatants.Count > 0)
            {
                <div class="mt-4">

                    <h2 class="h5 mb-3">
                        Temporary Controls
                    </h2>


                    @foreach (var combatant in Model.TemporaryControlledCombatants)
                    {
                        <div class="card mb-2">

                            <div class="card-body">

                                <div class="d-flex
                                    justify-content-between
                                    align-items-center">

                                    <div>

                                        <div class="fw-bold">
                                            @combatant.Name
                                        </div>

                                        <div class="small text-muted">

                                            HP
                                            @(combatant.CurrentHp?.ToString() ?? "—")
                                            /
                                            @(combatant.MaxHp?.ToString() ?? "—")

                                            @if (Model.Encounter.IsStarted)
                                            {
                                                <span>
                                                    · Initiative
                                                    @combatant.Initiative
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>

                                @{
                                    var isCurrent =
                                        Model.Encounter.CurrentCombatantId ==
                                        combatant.Id;
                                }


                                @if (isCurrent)
                                {
                                    <div class="alert
                                                alert-primary
                                                fw-bold
                                                mt-3">
                                        Your Turn
                                    </div>
                                }


                                @if (combatant.CurrentHp.HasValue)
                                {
                                    <div class="mt-3">

                                        <div class="d-flex
                                                    justify-content-between
                                                    align-items-center
                                                    mb-2">

                                            <strong>
                                                HP
                                            </strong>

                                            <span class="fw-bold">
                                                @combatant.CurrentHp
                                                /
                                                @(combatant.MaxHp?.ToString() ?? "—")
                                            </span>

                                        </div>


                                        @if (combatant.TemporaryHp > 0)
                                        {
                                            <div class="mb-2">

                                                <span class="badge text-bg-info">
                                                    Temp @combatant.TemporaryHp
                                                </span>

                                            </div>
                                        }


                                        <div class="d-flex
                                                    flex-wrap
                                                    gap-1">

                                            @foreach (var amount in new[] { -5, -1, 1, 5 })
                                            {
                                                <form method="post"
                                                      asp-page-handler="AdjustHp">

                                                    <input type="hidden"
                                                           name="combatantId"
                                                           value="@combatant.Id" />

                                                    <button type="submit"
                                                            name="amount"
                                                            value="@amount"
                                                            class="btn
                                                                   @(amount < 0
                                                                       ? "btn-outline-danger"
                                                                       : "btn-outline-success")">
                                                        @(amount > 0
                                                            ? $"+{amount}"
                                                            : amount.ToString())
                                                    </button>

                                                </form>
                                            }

                                        </div>
                                        <div class="row g-2 mt-2">

                                            <div class="col-sm-6">

                                                <form method="post"
                                                      asp-page-handler="SetHp">

                                                    <input type="hidden"
                                                           name="combatantId"
                                                           value="@combatant.Id" />

                                                    <label class="form-label small">
                                                        Current HP
                                                    </label>

                                                    <div class="input-group">

                                                        <input type="number"
                                                               name="currentHp"
                                                               value="@combatant.CurrentHp"
                                                               min="0"
                                                               class="form-control" />

                                                        <button type="submit"
                                                                class="btn btn-outline-secondary">
                                                            Set
                                                        </button>

                                                    </div>

                                                </form>

                                            </div>


                                            <div class="col-sm-6">

                                                <form method="post"
                                                      asp-page-handler="SetTemporaryHp">

                                                    <input type="hidden"
                                                           name="combatantId"
                                                           value="@combatant.Id" />

                                                    <label class="form-label small">
                                                        Temporary HP
                                                    </label>

                                                    <div class="input-group">

                                                        <input type="number"
                                                               name="temporaryHp"
                                                               value="@combatant.TemporaryHp"
                                                               min="0"
                                                               class="form-control" />

                                                        <button type="submit"
                                                                class="btn btn-outline-info">
                                                            Set
                                                        </button>

                                                    </div>

                                                </form>

                                            </div>

                                        </div>

                                    </div>
                                }


                                @if (isCurrent)
                                {
                                    <form method="post"
                                          asp-page-handler="EndTurn"
                                          class="mt-3">

                                        <button type="submit"
                                                class="btn
                                                       btn-primary
                                                       w-100">
                                            End Turn →
                                        </button>

                                    </form>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

            <div class="card mt-4">

                <div class="card-body">

                    <h2 class="h5">
                        Create Character
                    </h2>

                    <form method="post"
                          asp-page-handler="CreateCharacter"
                          class="d-flex gap-2">

                        <input type="text"
                               name="name"
                               class="form-control"
                               placeholder="Character name"
                               required />

                        <button type="submit"
                                class="btn btn-outline-primary">
                            Create
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

    <script src="~/js/player.js"
            asp-append-version="true"></script>

}