<div class="offcanvas offcanvas-end player-appearance-panel"
     tabindex="-1"
     id="playerAppearancePanel"
     aria-labelledby="playerAppearancePanelLabel">

    <div class="offcanvas-header">

        <div>

            <h2 class="offcanvas-title h5 mb-1"
                id="playerAppearancePanelLabel">
                Appearance
            </h2>

            <div class="small text-body-secondary">
                Saved on this browser and used across your player pages.
            </div>

        </div>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Close">
        </button>

    </div>


    <div class="offcanvas-body">

        <fieldset class="player-theme-fieldset">

            <legend class="player-theme-legend">
                My Theme
            </legend>

            <div class="player-theme-grid">

                <button type="button"
                        class="player-theme-choice"
                        data-player-theme-choice="dark"
                        aria-pressed="false">

                    <span class="player-theme-swatch player-theme-swatch--dark"
                          aria-hidden="true"></span>

                    <span>Dark</span>

                </button>


                <button type="button"
                        class="player-theme-choice"
                        data-player-theme-choice="light"
                        aria-pressed="false">

                    <span class="player-theme-swatch player-theme-swatch--light"
                          aria-hidden="true"></span>

                    <span>Light</span>

                </button>


                <button type="button"
                        class="player-theme-choice"
                        data-player-theme-choice="parchment"
                        aria-pressed="false">

                    <span class="player-theme-swatch player-theme-swatch--parchment"
                          aria-hidden="true"></span>

                    <span>Parchment</span>

                </button>


                <button type="button"
                        class="player-theme-choice"
                        data-player-theme-choice="arcane"
                        aria-pressed="false">

                    <span class="player-theme-swatch player-theme-swatch--arcane"
                          aria-hidden="true"></span>

                    <span>Arcane</span>

                </button>


                <button type="button"
                        class="player-theme-choice"
                        data-player-theme-choice="infernal"
                        aria-pressed="false">

                    <span class="player-theme-swatch player-theme-swatch--infernal"
                          aria-hidden="true"></span>

                    <span>Infernal</span>

                </button>


                <button type="button"
                        class="player-theme-choice"
                        data-player-theme-choice="frost"
                        aria-pressed="false">

                    <span class="player-theme-swatch player-theme-swatch--frost"
                          aria-hidden="true"></span>

                    <span>Frost</span>

                </button>


                <button type="button"
                        class="player-theme-choice"
                        data-player-theme-choice="forest"
                        aria-pressed="false">

                    <span class="player-theme-swatch player-theme-swatch--forest"
                          aria-hidden="true"></span>

                    <span>Forest</span>

                </button>


                <button type="button"
                        class="player-theme-choice"
                        data-player-theme-choice="blood-moon"
                        aria-pressed="false">

                    <span class="player-theme-swatch player-theme-swatch--blood-moon"
                          aria-hidden="true"></span>

                    <span>Blood Moon</span>

                </button>

            </div>

        </fieldset>


        <div class="player-theme-note">
            This changes only your player interface. It does not affect
            the DM or public display.
        </div>

    </div>

</div>
