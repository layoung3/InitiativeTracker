@page "/player/character/{id:guid}"
@model InitiativeTracker.Web.Pages.Player.CharacterModel
@using InitiativeTracker.Web.Data.Enums
@using InitiativeTracker.Web.Rules.Dnd5e

@{
    ViewData["Title"] = Model.Character.Name;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/condition-badges.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/player-character.css"
          asp-append-version="true" />
}


<div class="container py-3 py-lg-4 character-sheet">

    @* ============================================================
       HEADER
       ============================================================ *@

    <div class="card mb-3 character-header">

        <div class="card-body">

            <div class="d-flex
                flex-column
                flex-md-row
                align-items-md-center
                gap-3">


                @* Portrait *@
                <div class="character-portrait-placeholder">

                    <span>
                        @Model.Character.Name.Substring(0, 1).ToUpper()
                    </span>

                </div>


                @* Character identity *@
                <div class="flex-grow-1">

                    <h1 class="h2 mb-1">
                        @Model.Character.Name
                    </h1>

                    <div class="d-flex
                        flex-wrap
                        align-items-center
                        gap-2
                        text-muted">

                        <span>
                            Level @Model.Character.Level
                        </span>

                        <span>·</span>

                        <span>
                            Speed @Model.Character.MovementSpeed ft.
                        </span>

                        <span>·</span>

                        <span>
                            Proficiency +@Model.Character.ProficiencyBonus
                        </span>

                    </div>

                </div>


                <div class="d-flex
                    flex-wrap
                    gap-2">

                    <a href="/player"
                       class="btn
                        btn-outline-secondary">
                        ← Characters
                    </a>

                    @*
                        We'll enable this in the next
                        checkpoint.
                    *@
                    <a asp-page="/Player/EditCharacter"
                       asp-route-id="@Model.Character.Id"
                       class="btn btn-outline-primary">
                        Edit Character
                    </a>

                </div>

            </div>

        </div>

    </div>



    @* ============================================================
       MOBILE / DESKTOP MAIN GRID
       ============================================================ *@

    <div class="row g-3">


        @* ========================================================
           ABILITY SCORES
           ======================================================== *@

        <div class="col-12
            col-lg-3
            order-2
            order-lg-1">

            <div class="card mb-3">

                <div class="card-header">
                    Ability Scores
                </div>


                <div class="card-body">

                    <div class="row
                        row-cols-3
                        row-cols-lg-2
                        g-2">


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    STR
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Strength)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Strength
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    DEX
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Dexterity)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Dexterity
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    CON
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Constitution)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Constitution
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    INT
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Intelligence)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Intelligence
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    WIS
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Wisdom)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Wisdom
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    CHA
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Charisma)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Charisma
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="card">

                <div class="card-header">
                    Saving Throws
                </div>


                <div class="list-group
                    list-group-flush">

                    <div class="list-group-item
                        saving-throw-row">

                        <div class="d-flex
                            align-items-center
                            gap-2">

                            @if (Model.Character.StrengthSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">
                                    ●
                                </span>
                            }
                            else
                            {
                                <span class="save-proficiency
                                    text-muted"
                                      title="Not proficient">
                                    ○
                                </span>
                            }

                            <span class="fw-semibold">
                                Strength
                            </span>

                            <span class="text-muted
                                small">
                                STR
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Strength,
                                    Model.Character.StrengthSaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.DexteritySaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Dexterity
                            </span>

                            <span class="text-muted small">
                                DEX
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Dexterity,
                                    Model.Character.DexteritySaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.ConstitutionSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Constitution
                            </span>

                            <span class="text-muted small">
                                CON
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Constitution,
                                    Model.Character.ConstitutionSaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.IntelligenceSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Intelligence
                            </span>

                            <span class="text-muted small">
                                INT
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Intelligence,
                                    Model.Character.IntelligenceSaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.WisdomSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Wisdom
                            </span>

                            <span class="text-muted small">
                                WIS
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Wisdom,
                                    Model.Character.WisdomSaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.CharismaSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Charisma
                            </span>

                            <span class="text-muted small">
                                CHA
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Charisma,
                                    Model.Character.CharismaSaveProficient))
                        </strong>

                    </div>

                </div>

            </div>

        </div>



        @* ========================================================
           MAIN CHARACTER INFORMATION
           ======================================================== *@

        <div class="col-12
            col-lg-6
            order-1
            order-lg-2">

            @* Combat / vitals *@
            <div class="card mb-3">

                <div class="card-header
                    d-flex
                    justify-content-between
                    align-items-center">

                    <span>
                        Combat
                    </span>

                    @if (Model.EncounterCombatant is not null)
                    {
                        <span class="badge
                            text-bg-success">
                            In Encounter
                        </span>
                    }

                </div>


                <div class="card-body">

                    <div class="combat-summary-grid">

                        @* ========================================================
                           HIT POINTS
                           ======================================================== *@

                        @if (Model.CanChangeLiveHp)
                        {
                            <button type="button"
                                    class="combat-stat-tile
                                combat-stat-action
                                combat-hp-tile
                                @(Model.OpenEditor == "hp"
                                    ? ""
                                    : "collapsed")"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#hpEditor"
                                    aria-expanded="@(Model.OpenEditor == "hp"
                                                                                                                                                                                                                                            ? "true"
                                                                                                                                                                                                                                            : "false")"
                                    aria-controls="hpEditor">

                                <span class="combat-stat-value">
                                    @Model.DisplayCurrentHp
                                    <span class="combat-stat-divider">/</span>
                                    @Model.DisplayMaxHp
                                </span>

                                <span class="combat-stat-label">
                                    Hit Points
                                </span>

                            </button>
                        }
                        else
                        {
                            <div class="combat-stat-tile
                                combat-hp-tile">

                                <span class="combat-stat-value">
                                    @Model.DisplayCurrentHp
                                    <span class="combat-stat-divider">/</span>
                                    @Model.DisplayMaxHp
                                </span>

                                <span class="combat-stat-label">
                                    Hit Points
                                </span>

                            </div>
                        }


                        @* ========================================================
                           TEMPORARY HP
                           ======================================================== *@

                        @if (Model.CanChangeLiveHp)
                        {
                            <button type="button"
                                    class="combat-stat-tile
                                combat-stat-action
                                combat-temp-hp
                                @(Model.OpenEditor == "temp"
                                    ? ""
                                    : "collapsed")"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#temporaryHpEditor"
                                    aria-expanded="@(Model.OpenEditor == "temp"
                                                                                                                                                                                                                                    ? "true"
                                                                                                                                                                                                                                    : "false")"
                                    aria-controls="temporaryHpEditor">

                                <span class="combat-stat-value">
                                    @Model.DisplayTemporaryHp
                                </span>

                                <span class="combat-stat-label">
                                    Temp HP
                                </span>

                            </button>
                        }
                        else
                        {
                            <div class="combat-stat-tile
                                combat-temp-hp">

                                <span class="combat-stat-value">
                                    @Model.DisplayTemporaryHp
                                </span>

                                <span class="combat-stat-label">
                                    Temp HP
                                </span>

                            </div>
                        }

                        @* AC *@
                        <div class="combat-stat-tile">

                            <div class="combat-stat-value">
                                @Model.Character.ArmorClass
                            </div>

                            <div class="combat-stat-label">
                                Armor Class
                            </div>

                        </div>


                        @* ========================================================
                           INSPIRATION
                           ======================================================== *@

                        <form method="post"
                              asp-page-handler="ToggleInspiration"
                              asp-route-id="@Model.Character.Id"
                              class="combat-inspiration-form">

                            <button type="submit"
                                    class="combat-stat-tile
                                combat-stat-action
                                inspiration-stat
                                @(Model.Character.Inspiration
                                    ? "is-active"
                                    : "")"
                                    title="Toggle Inspiration"
                                    aria-label="Toggle Inspiration">

                                <span class="inspiration-star">

                                    <svg class="inspiration-star-icon"
                                         viewBox="0 0 24 24"
                                         role="img"
                                         aria-hidden="true">

                                        <polygon points="
                                        12,2.5
                                        14.9,8.4
                                        21.5,9.3
                                        16.7,13.9
                                        17.8,20.5
                                        12,17.4
                                        6.2,20.5
                                        7.3,13.9
                                        2.5,9.3
                                        9.1,8.4"
                                                 fill="@(Model.Character.Inspiration ? "currentColor" : "none")"
                                                 stroke="currentColor"
                                                 stroke-width="1.75"
                                                 stroke-linejoin="round" />

                                    </svg>

                                </span>

                                <span class="combat-stat-label">
                                    Inspiration
                                </span>

                            </button>

                        </form>

                    </div>


                    @* ============================================================
                       HP EDITOR
                       ============================================================ *@

                    @if (Model.CanChangeLiveHp)
                    {
                        <div id="combatEditors">
                            <div class="collapse
                                @(Model.OpenEditor == "hp"
                                    ? "show"
                                    : "")
                                mt-3"
                                 id="hpEditor"
                                 data-bs-parent="#combatEditors">

                                <div class="combat-editor">

                                    <div class="d-flex
                                        flex-column
                                        flex-sm-row
                                        justify-content-between
                                        gap-3">

                                        <div>

                                            <div class="small
                                                fw-semibold
                                                mb-2">
                                                Adjust Hit Points
                                            </div>


                                            <div class="d-flex
                                                flex-wrap
                                                gap-1">

                                                @foreach (var amount
                                                          in new[]
                                                          {
                                                          -5, -1, 1, 5
                                                          })
                                                {
                                                    <form method="post"
                                                          asp-page-handler="AdjustHp"
                                                          asp-route-id="@Model.Character.Id">

                                                        <button type="submit"
                                                                name="amount"
                                                                value="@amount"
                                                                class="btn
                                                            @(amount < 0
                                                                ? "btn-outline-danger"
                                                                : "btn-outline-success")">

                                                            @(amount > 0
                                                                ? $"+{amount}"
                                                                : amount.ToString())

                                                        </button>

                                                    </form>
                                                }

                                            </div>

                                        </div>


                                        <form method="post"
                                              asp-page-handler="SetHp"
                                              asp-route-id="@Model.Character.Id">

                                            <label class="form-label small">
                                                Set Current HP
                                            </label>


                                            <div class="input-group">

                                                <input type="number"
                                                       name="currentHp"
                                                       value="@Model.DisplayCurrentHp"
                                                       min="0"
                                                       class="form-control"
                                                       style="max-width: 7rem;" />

                                                <button type="submit"
                                                        class="btn
                                                    btn-outline-secondary">
                                                    Set
                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>


                            @* ========================================================
                           TEMP HP EDITOR
                           ======================================================== *@

                            <div class="collapse
                                @(Model.OpenEditor == "temp"
                                    ? "show"
                                    : "")
                                mt-3"
                                 id="temporaryHpEditor"
                                 data-bs-parent="#combatEditors">

                                <div class="combat-editor">

                                    <form method="post"
                                          asp-page-handler="SetTemporaryHp"
                                          asp-route-id="@Model.Character.Id">

                                        <label class="form-label small">
                                            Set Temporary HP
                                        </label>


                                        <div class="input-group"
                                             style="max-width: 14rem;">

                                            <input type="number"
                                                   name="temporaryHp"
                                                   value="@Model.DisplayTemporaryHp"
                                                   min="0"
                                                   class="form-control" />

                                            <button type="submit"
                                                    class="btn
                                                btn-outline-info">
                                                Set
                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>
                        </div>
                    }


                    @if (!Model.CanChangeLiveHp)
                    {
                        <div class="small
                            text-muted
                            mt-2">
                            Combat controls are currently assigned to
                            another player or the DM.
                        </div>
                    }


                    @* ============================================================
                       EXHAUSTION
                       ============================================================ *@

                    <div class="combat-state-row">

                        <div>

                            <div class="fw-semibold">
                                Exhaustion
                            </div>

                            <div class="small text-muted">
                                Level @Model.Character.ExhaustionLevel
                            </div>

                        </div>


                        <form method="post"
                              asp-page-handler="SetExhaustion"
                              asp-route-id="@Model.Character.Id"
                              class="exhaustion-control">

                            <button type="submit"
                                    name="exhaustionLevel"
                                    value="0"
                                    class="exhaustion-clear
                                @(Model.Character.ExhaustionLevel == 0
                                    ? "is-active"
                                    : "")"
                                    title="Clear exhaustion">
                                None
                            </button>


                            @for (var level = 1;
                                  level <= 6;
                                  level++)
                            {
                                <button type="submit"
                                        name="exhaustionLevel"
                                        value="@level"
                                        class="exhaustion-pip
                                    @(level <= Model.Character.ExhaustionLevel
                                        ? "is-active"
                                        : "")"
                                        title="Set exhaustion to level @level"
                                        aria-label="Set exhaustion to level @level">

                                    <span>
                                        @level
                                    </span>

                                </button>
                            }

                        </form>

                    </div>


                    @* ============================================================
                       CONDITIONS
                       ============================================================ *@

                    <div class="combat-state-row">

                        <div class="flex-grow-1">

                            <div class="fw-semibold mb-2">
                                Conditions
                            </div>


                            @if (Model.ActiveConditions.Count == 0)
                            {
                                <div class="small text-muted">
                                    No active conditions
                                </div>
                            }
                            else
                            {
                                <div class="condition-badges">

                                    @foreach (var condition
                                              in Model.ActiveConditions)
                                    {
                                        <span class="condition-badge
                                            condition-@Dnd5eConditionCatalog.GetStyleKey(condition.Name)"
                                              title="@condition.Notes">

                                            @condition.Name

                                        </span>
                                    }

                                </div>
                            }

                        </div>


                        @if (Model.CanChangeConditions)
                        {
                            <button type="button"
                                    class="btn
                                btn-sm
                                btn-outline-secondary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#conditionsModal">
                                Manage
                            </button>
                        }

                    </div>

                </div>

            </div>

            @* ========================================================
               ATTACKS / SPELLS
               ======================================================== *@

            @{
                var spellsTabActive =
                    string.Equals(
                        Model.OpenTab,
                        "spells",
                        StringComparison.OrdinalIgnoreCase);
            }

            <div class="card mb-3">

                <div class="card-header
                    pb-0">

                    <ul class="nav
                        nav-tabs
                        card-header-tabs"
                        role="tablist">

                        <li class="nav-item"
                            role="presentation">

                            <button class="nav-link @(spellsTabActive ? "" : "active")"
                                    id="attacks-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#attacks-panel"
                                    type="button"
                                    role="tab"
                                    aria-controls="attacks-panel"
                                    aria-selected="@(spellsTabActive ? "false" : "true")">
                                Attacks
                            </button>

                        </li>


                        <li class="nav-item"
                            role="presentation">

                            <button class="nav-link @(spellsTabActive ? "active" : "")"
                                    id="spells-tab"
                                    data-bs-toggle="tab"
                                    data-bs-target="#spells-panel"
                                    type="button"
                                    role="tab"
                                    aria-controls="spells-panel"
                                    aria-selected="@(spellsTabActive ? "true" : "false")">
                                Spells
                            </button>

                        </li>

                    </ul>

                </div>


                <div class="tab-content">

                    @* ====================================================
                       ATTACKS
                       ==================================================== *@

                    <div class="tab-pane
                        fade
                        @(spellsTabActive ? "" : "show active")"
                         id="attacks-panel"
                         role="tabpanel"
                         aria-labelledby="attacks-tab"
                         tabindex="0">

                        <div class="d-flex
                            justify-content-end
                            p-2
                            border-bottom">

                            <button type="button"
                                    class="btn
                                btn-sm
                                btn-outline-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#characterAttackModal"
                                    data-attack-config="">
                                + Add Attack
                            </button>

                        </div>


                        @if (Model.Attacks.Count == 0)
                        {
                            <div class="card-body
                                text-muted">

                                No attacks available.

                                <div class="small mt-1">
                                    Equip and configure a weapon in
                                    Inventory, or add a custom attack.
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="list-group
                                list-group-flush">

                                @foreach (var attack in Model.Attacks)
                                {
                                    <div class="list-group-item
                                        attack-row">

                                        @* Attack identity *@
                                        <div class="attack-identity">

                                            <div class="d-flex
                                                flex-wrap
                                                align-items-center
                                                gap-2">

                                                <div class="fw-semibold">
                                                    @attack.Name
                                                </div>


                                                @if (attack.SourceType ==
                                                     Dnd5eAttackSourceType.Custom)
                                                {
                                                    <button type="button"
                                                            class="btn
                                                        btn-sm
                                                        btn-link
                                                        p-0"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#characterAttackModal"
                                                            data-attack-config="@Model.GetCharacterAttackConfigurationJson(
                                                                                                                                                                                                                                                                                                attack.SourceId)">
                                                        Edit
                                                    </button>
                                                }

                                            </div>


                                            <div class="small
                                                text-muted">

                                                @Model.GetAbilityAbbreviation(
                                                    attack.AttackAbility)

                                                @if (attack.NormalRange.HasValue)
                                                {
                                                    <span>
                                                        ·
                                                        @attack.NormalRange

                                                        @if (attack.LongRange.HasValue)
                                                        {
                                                            <text>
                                                                /@attack.LongRange
                                                            </text>
                                                        }

                                                        ft.
                                                    </span>
                                                }

                                            </div>

                                        </div>


                                        @* To hit *@
                                        <div class="attack-hit">

                                            <div class="attack-hit-value">
                                                @Model.FormatBonus(
                                                    attack.ToHitBonus)
                                            </div>

                                            <div class="attack-hit-label">
                                                To Hit
                                            </div>

                                        </div>


                                        @* Damage *@
                                        <div class="attack-damage">

                                            @if (attack.DamageComponents.Count == 0)
                                            {
                                                <span class="text-muted">
                                                    —
                                                </span>
                                            }
                                            else
                                            {
                                                @foreach (var damage
                                                          in attack.DamageComponents)
                                                {
                                                    <div class="attack-damage-line">

                                                        <span class="fw-semibold">
                                                            @Model.FormatDamage(
                                                                damage.DamageExpression,
                                                                damage.FlatBonus)
                                                        </span>

                                                        <span class="text-muted">
                                                            @damage.DamageType
                                                        </span>

                                                    </div>


                                                    @if (damage.IsPrimary &&
                                                         !string.IsNullOrWhiteSpace(
                                                             damage.VersatileDamageExpression))
                                                    {
                                                        <div class="small
                                                            text-muted">

                                                            Versatile:
                                                            @Model.FormatDamage(
                                                                damage.VersatileDamageExpression,
                                                                damage.FlatBonus)
                                                            @damage.DamageType

                                                        </div>
                                                    }
                                                }
                                            }

                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </div>


                    @* ====================================================
                       SPELLS
                       ==================================================== *@

                    <div class="tab-pane
                        fade
                        @(spellsTabActive ? "show active" : "")"
                         id="spells-panel"
                         role="tabpanel"
                         aria-labelledby="spells-tab"
                         tabindex="0">

                        @if (TempData["SpellError"]
                             is string spellError)
                        {
                            <div class="alert
                                alert-danger
                                rounded-0
                                border-start-0
                                border-end-0
                                border-top-0
                                mb-0">
                                @spellError
                            </div>
                        }


                        @if (Model.Spellcasting is null)
                        {
                            <div class="card-body">

                                <div class="text-muted mb-3">
                                    Spellcasting has not been configured.
                                </div>


                                <button type="button"
                                        class="btn
                                    btn-sm
                                    btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#spellcastingModal">
                                    Configure Spellcasting
                                </button>

                            </div>
                        }
                        else
                        {
                            <div class="spellcasting-summary">

                                <div class="spellcasting-stat">

                                    <span class="spellcasting-stat-value">
                                        @Model.GetAbilityAbbreviation(
                                            Model.SpellcastingSummary!.Ability)
                                    </span>

                                    <span class="spellcasting-stat-label">
                                        Ability
                                    </span>

                                </div>


                                <div class="spellcasting-stat">

                                    <span class="spellcasting-stat-value">
                                        @Model.FormatBonus(
                                            Model.SpellcastingSummary.SpellAttackBonus)
                                    </span>

                                    <span class="spellcasting-stat-label">
                                        Spell Attack
                                    </span>

                                </div>


                                <div class="spellcasting-stat">

                                    <span class="spellcasting-stat-value">
                                        @Model.SpellcastingSummary.SpellSaveDc
                                    </span>

                                    <span class="spellcasting-stat-label">
                                        Save DC
                                    </span>

                                </div>


                                <div class="spellcasting-summary-actions">

                                    <button type="button"
                                            class="btn
                                        btn-sm
                                        btn-outline-primary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#spellcastingModal">
                                        Configure
                                    </button>


                                    @if (Model.SpellSlotsByLevel.Count > 0)
                                    {
                                        <form method="post"
                                              asp-page-handler="RestoreAllSpellSlots"
                                              asp-route-id="@Model.Character.Id"
                                              data-preserve-inventory-scroll="true">

                                            <button type="submit"
                                                    class="btn
                                                btn-sm
                                                btn-outline-secondary">
                                                Restore All
                                            </button>

                                        </form>
                                    }

                                </div>

                            </div>


                            @if (Model.ActiveConcentrationSpell is not null)
                            {
                                var concentrationConfig =
                                    Model.GetSpellConfigurationJson(
                                        Model.ActiveConcentrationSpell.Id);

                                <div class="spell-concentration-banner">

                                    <div class="spell-concentration-current">
                                        <span class="spell-concentration-label">
                                            Concentrating
                                        </span>

                                        <button type="button"
                                                class="btn
                                            btn-link
                                            spell-concentration-name"
                                                data-bs-toggle="modal"
                                                data-bs-target="#spellDetailsModal"
                                                data-spell-config="@concentrationConfig">
                                            @Model.ActiveConcentrationSpell.Name
                                        </button>
                                    </div>

                                    <form method="post"
                                          asp-page-handler="EndConcentration"
                                          asp-route-id="@Model.Character.Id"
                                          data-preserve-inventory-scroll="true">

                                        <button type="submit"
                                                class="btn
                                            btn-sm
                                            btn-outline-secondary">
                                            End
                                        </button>

                                    </form>

                                </div>
                            }


                            <div class="spell-toolbar">

                                <div class="form-check
                                    form-switch
                                    mb-0">

                                    <input type="checkbox"
                                           class="form-check-input"
                                           role="switch"
                                           id="preparedSpellsOnly" />

                                    <label class="form-check-label"
                                           for="preparedSpellsOnly">
                                        Prepared Only
                                    </label>

                                </div>


                                <button type="button"
                                        class="btn
                                    btn-sm
                                    btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#spellModal"
                                        data-spell-config="">
                                    + Add Spell
                                </button>

                            </div>


                            @foreach (var level
                                      in Model.GetVisibleSpellLevels())
                            {
                                var slot =
                                    level == 0
                                        ? null
                                        : Model.GetSpellSlot(
                                            level);

                                var levelSpells =
                                    Model.Spells
                                        .Where(
                                            x =>
                                                x.Level ==
                                                level)
                                        .OrderBy(
                                            x => x.SortOrder)
                                        .ThenBy(
                                            x => x.Name)
                                        .ToList();


                                var spellLevelCollapseId = $"spell-level-{level}";

                                <div class="spell-level-section">

                                    <div class="spell-level-header">

                                        <button type="button"
                                                class="spell-level-toggle"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@spellLevelCollapseId"
                                                aria-expanded="true"
                                                aria-controls="@spellLevelCollapseId">

                                            <span class="spell-level-chevron"
                                                  aria-hidden="true">
                                                ▾
                                            </span>

                                            <span class="fw-semibold">
                                                @Model.GetSpellLevelLabel(
                                                    level)
                                            </span>

                                            @if (levelSpells.Count > 0)
                                            {
                                                <span class="spell-level-count">
                                                    @levelSpells.Count
                                                </span>
                                            }

                                        </button>


                                        @*
                                         * Keep slot controls OUTSIDE the collapse
                                         * toggle so they remain usable even when
                                         * this spell level is collapsed.
                                         *@
                                        @if (slot is not null)
                                        {
                                            <div class="spell-slot-control">

                                                <form method="post"
                                                      asp-page-handler="AdjustSpellSlot"
                                                      asp-route-id="@Model.Character.Id"
                                                      data-preserve-inventory-scroll="true">

                                                    <input type="hidden"
                                                           name="level"
                                                           value="@level" />

                                                    <button type="submit"
                                                            name="amount"
                                                            value="-1"
                                                            class="btn
                                                        btn-sm
                                                        btn-outline-secondary
                                                        spell-slot-button"
                                                            disabled="@(slot.RemainingSlots <= 0)"
                                                            title="Use one spell slot">
                                                        −
                                                    </button>

                                                </form>


                                                <span class="spell-slot-count">
                                                    Slots
                                                    <strong>
                                                        @slot.RemainingSlots/@slot.MaximumSlots
                                                    </strong>
                                                </span>


                                                <form method="post"
                                                      asp-page-handler="AdjustSpellSlot"
                                                      asp-route-id="@Model.Character.Id"
                                                      data-preserve-inventory-scroll="true">

                                                    <input type="hidden"
                                                           name="level"
                                                           value="@level" />

                                                    <button type="submit"
                                                            name="amount"
                                                            value="1"
                                                            class="btn
                                                        btn-sm
                                                        btn-outline-secondary
                                                        spell-slot-button"
                                                            disabled="@(slot.RemainingSlots >= slot.MaximumSlots)"
                                                            title="Restore one spell slot">
                                                        +
                                                    </button>

                                                </form>

                                            </div>
                                        }

                                    </div>


                                    <div id="@spellLevelCollapseId"
                                         class="collapse show"
                                         data-spell-level="@level">

                                        @if (levelSpells.Count == 0)
                                        {
                                            <div class="spell-level-empty">
                                                No spells added.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="list-group
                                                list-group-flush">

                                                @foreach (var spell
                                                          in levelSpells)
                                                {
                                                    var spellConfigJson =
                                                        Model.GetSpellConfigurationJson(
                                                            spell.Id);

                                                    var spellComponents =
                                                        Model.GetSpellComponents(
                                                            spell);

                                                    var spellResolution =
                                                        Model.GetSpellResolution(
                                                            spell);

                                                    var spellRangeArea =
                                                        Model.GetSpellRangeArea(
                                                            spell);

                                                    <div class="list-group-item
                                                        spell-row
                                                        @(spell.IsPrepared
                                                            ? ""
                                                            : "spell-unprepared")"
                                                         data-spell-row
                                                         data-spell-prepared="@spell.IsPrepared.ToString().ToLowerInvariant()">

                                                        <div class="spell-primary">

                                                            <form method="post"
                                                                  asp-page-handler="ToggleSpellPrepared"
                                                                  asp-route-id="@Model.Character.Id"
                                                                  data-preserve-inventory-scroll="true"
                                                                  class="spell-prepared-form">

                                                                <input type="hidden"
                                                                       name="spellId"
                                                                       value="@spell.Id" />

                                                                <button type="submit"
                                                                        class="spell-prepared-toggle
                                                                    @(spell.IsPrepared
                                                                        ? "is-prepared"
                                                                        : "")"
                                                                        title="@(spell.IsPrepared
                                                                                                                                                ? "Mark unprepared"
                                                                                                                                                : "Mark prepared")"
                                                                        aria-label="@(spell.IsPrepared
                                                                                                                                                ? $"Mark {spell.Name} unprepared"
                                                                                                                                                : $"Mark {spell.Name} prepared")">

                                                                    @(spell.IsPrepared
                                                                        ? "✓"
                                                                        : "○")

                                                                </button>

                                                            </form>


                                                            <button type="button"
                                                                    class="btn
                                                                btn-link
                                                                spell-name-button"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#spellDetailsModal"
                                                                    data-spell-config="@spellConfigJson">
                                                                @spell.Name
                                                            </button>


                                                            @if (spellComponents != "—")
                                                            {
                                                                <span class="spell-components-inline">
                                                                    (@spellComponents)
                                                                </span>
                                                            }


                                                            @if (spell.RequiresConcentration)
                                                            {
                                                                <span class="spell-marker"
                                                                      title="Concentration">
                                                                    C
                                                                </span>
                                                            }


                                                            @if (spell.IsRitual)
                                                            {
                                                                <span class="spell-marker"
                                                                      title="Ritual">
                                                                    R
                                                                </span>
                                                            }

                                                        </div>


                                                        <div class="spell-quick-info">

                                                            @if (!string.IsNullOrWhiteSpace(
                                                                    spell.CastingTime))
                                                            {
                                                                <span>
                                                                    @spell.CastingTime
                                                                </span>
                                                            }


                                                            @if (spellResolution != "—")
                                                            {
                                                                <span>
                                                                    @spellResolution
                                                                </span>
                                                            }


                                                            @if (spellRangeArea != "—")
                                                            {
                                                                <span>
                                                                    @spellRangeArea
                                                                </span>
                                                            }


                                                            @if (!string.IsNullOrWhiteSpace(
                                                                    spell.Duration))
                                                            {
                                                                <span>
                                                                    @spell.Duration
                                                                </span>
                                                            }

                                                        </div>


                                                        <div class="spell-effect-actions">

                                                            <div class="spell-effect-info">

                                                                @if (spell.EffectComponents.Count == 0)
                                                                {
                                                                    <span class="text-muted">
                                                                        —
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    @foreach (var effect
                                                                              in spell.EffectComponents
                                                                                  .OrderBy(
                                                                                      x => x.SortOrder))
                                                                    {
                                                                        <div>
                                                                            @Model.FormatSpellEffect(
                                                                                effect)
                                                                        </div>
                                                                    }
                                                                }

                                                            </div>


                                                            <button type="button"
                                                                    class="btn
                                                                btn-sm
                                                                btn-outline-primary
                                                                spell-cast-button"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#spellCastModal"
                                                                    data-spell-config="@spellConfigJson">
                                                                Cast
                                                            </button>

                                                        </div>

                                                    </div>
                                                }

                                            </div>


                                            <div class="spell-level-empty
                                                d-none"
                                                 data-spell-filter-empty>
                                                No prepared spells.
                                            </div>
                                        }

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>

            </div>


            @* ========================================================
               INVENTORY
               ======================================================== *@

            <div class="card">

                <div class="card-header
                    d-flex
                    justify-content-between
                    align-items-center">

                    <span>
                        Inventory
                    </span>


                    <button type="button"
                            class="btn
                        btn-sm
                        btn-outline-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#addInventoryItemModal">
                        + Add Item
                    </button>

                </div>


                @if (TempData["InventoryError"]
                     is string inventoryError)
                {
                    <div class="alert
                        alert-danger
                        rounded-0
                        border-start-0
                        border-end-0
                        border-top-0
                        mb-0">
                        @inventoryError
                    </div>
                }


                @if (Model.InventoryItems.Count == 0)
                {
                    <div class="card-body text-muted">

                        No items in inventory.

                    </div>
                }
                else
                {
                    <div class="list-group
                        list-group-flush">

                        @foreach (var itemGroup
                                  in Model.InventoryItems
                                      .GroupBy(
                                          x => x.ItemType)
                                      .OrderBy(
                                          x =>
                                              Model.GetInventoryTypeSortOrder(
                                                  x.Key)))
                        {
                            var collapseId =
                                $"inventory-{itemGroup.Key}";


                            <div class="list-group-item
                                p-0
                                bg-body-tertiary">

                                <button type="button"
                                        class="inventory-section-toggle"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="true"
                                        aria-controls="@collapseId">

                                    <span>
                                        @Model.GetInventoryTypeLabel(
                                            itemGroup.Key)
                                    </span>

                                    <span class="inventory-section-chevron"
                                          aria-hidden="true">
                                        ▾
                                    </span>

                                </button>

                            </div>


                            <div id="@collapseId"
                                 class="collapse show"
                                 data-inventory-section="@itemGroup.Key">

                                @foreach (var item
                                          in itemGroup
                                              .OrderByDescending(
                                                  x => x.IsEquipped)
                                              .ThenBy(
                                                  x => x.Name))
                                {
                                    <div class="list-group-item">

                                        <div class="d-flex
                                            flex-column
                                            flex-md-row
                                            justify-content-between
                                            gap-3">


                                            <div class="flex-grow-1">

                                                <div class="d-flex
                                                    flex-wrap
                                                    align-items-center
                                                    gap-2">

                                                    <span class="fw-semibold">
                                                        @item.Name
                                                    </span>


                                                    @if (item.IsEquipped &&
                                                         Model.CanEquipInventoryItem(
                                                             item.ItemType))
                                                    {
                                                        <span class="badge
                                                            text-bg-success">
                                                            Equipped
                                                        </span>
                                                    }

                                                    @if (item.ItemType ==
                                                         CharacterItemType.Weapon &&
                                                         Model.WeaponsByItemId.ContainsKey(
                                                             item.Id))
                                                    {
                                                        <span class="badge
                                                            text-bg-primary">
                                                            Configured
                                                        </span>
                                                    }

                                                </div>


                                                @if (!string.IsNullOrWhiteSpace(
                                                    item.Notes))
                                                {
                                                    <div class="small
                                                        text-muted
                                                        mt-1">
                                                        @item.Notes
                                                    </div>
                                                }

                                            </div>


                                            <div class="d-flex
                                                flex-wrap
                                                align-items-center
                                                gap-2">


                                                @* Quantity *@
                                                <form method="post"
                                                      asp-page-handler="AdjustInventoryItemQuantity"
                                                      asp-route-id="@Model.Character.Id"
                                                      data-preserve-inventory-scroll="true">

                                                    <input type="hidden"
                                                           name="itemId"
                                                           value="@item.Id" />


                                                    <div class="input-group
                                                        input-group-sm">

                                                        <button type="submit"
                                                                name="amount"
                                                                value="-1"
                                                                class="btn
                                                            btn-outline-secondary"
                                                                disabled="@(item.Quantity <= 1)">
                                                            −
                                                        </button>


                                                        <span class="input-group-text">
                                                            @item.Quantity
                                                        </span>


                                                        <button type="submit"
                                                                name="amount"
                                                                value="1"
                                                                class="btn
                                                            btn-outline-secondary">
                                                            +
                                                        </button>

                                                    </div>

                                                </form>


                                                @* Equip / Unequip *@
                                                @if (Model.CanEquipInventoryItem(
                                                    item.ItemType))
                                                {
                                                    <form method="post"
                                                          asp-page-handler="ToggleInventoryItemEquipped"
                                                          asp-route-id="@Model.Character.Id"
                                                          data-preserve-inventory-scroll="true">

                                                        <input type="hidden"
                                                               name="itemId"
                                                               value="@item.Id" />


                                                        <button type="submit"
                                                                class="btn
                                                            btn-sm
                                                            @(item.IsEquipped
                                                                ? "btn-outline-secondary"
                                                                : "btn-outline-success")">

                                                            @(item.IsEquipped
                                                                ? "Unequip"
                                                                : "Equip")

                                                        </button>

                                                    </form>
                                                }

                                                @if (item.ItemType == CharacterItemType.Weapon)
                                                {
                                                    <button type="button"
                                                            class="btn
                                                        btn-sm
                                                        btn-outline-primary"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#weaponConfigurationModal"
                                                            data-weapon-item-id="@item.Id"
                                                            data-weapon-item-name="@item.Name"
                                                            data-weapon-config="@Model.GetWeaponConfigurationJson(item.Id)">
                                                        Configure Weapon
                                                    </button>
                                                }

                                                @* Edit *@
                                                <button type="button"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editInventoryItemModal"
                                                        data-item-id="@item.Id"
                                                        data-item-name="@item.Name"
                                                        data-item-type="@item.ItemType"
                                                        data-item-quantity="@item.Quantity"
                                                        data-item-equipped="@(item.IsEquipped ? "true" : "false")"
                                                        data-item-notes="@item.Notes">
                                                    Edit
                                                </button>


                                                @* Delete *@
                                                <form method="post"
                                                      asp-page-handler="DeleteInventoryItem"
                                                      asp-route-id="@Model.Character.Id"
                                                      data-preserve-inventory-scroll="true"
                                                      onsubmit="return confirm('Remove @item.Name from inventory?');">

                                                    <input type="hidden"
                                                           name="itemId"
                                                           value="@item.Id" />


                                                    <button type="submit"
                                                            class="btn
                                                        btn-sm
                                                        btn-outline-danger">
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>
                        }

                    </div>
                }

            </div>

        </div>



        @* ========================================================
           CHARACTER DETAILS
           ======================================================== *@

        <div class="col-12
            col-lg-3
            order-3
            order-lg-3">

            <div class="card mb-3">

                <div class="card-header
                    d-flex
                    justify-content-between
                    align-items-center">

                    <span>
                        Skills
                    </span>

                    <span class="small text-muted">
                        Bonus
                    </span>

                </div>


                <div class="list-group
                    list-group-flush
                    skill-list">

                    @foreach (var skill
                              in Model.Skills
                                  .OrderBy(
                                      x =>
                                          Model.GetSkillName(
                                              x.Skill)))
                    {
                        var bonus =
                            Model.GetSkillBonus(
                                skill);


                        <div class="list-group-item
                            skill-row">

                            <div class="d-flex
                                align-items-center
                                gap-2
                                min-width-0">

                                <div class="skill-proficiency">

                                    @switch (skill.ProficiencyLevel)
                                    {
                                        case SkillProficiencyLevel.Expertise:

                                            <span title="Expertise">
                                                ◆
                                            </span>

                                            break;


                                        case SkillProficiencyLevel.Proficient:

                                            <span title="Proficient">
                                                ●
                                            </span>

                                            break;


                                        default:

                                            <span class="text-muted"
                                                  title="Not proficient">
                                                ○
                                            </span>

                                            break;
                                    }

                                </div>


                                <div>

                                    <div class="fw-semibold
                                        skill-name">
                                        @Model.GetSkillName(
                                            skill.Skill)
                                    </div>

                                    <div class="small
                                        text-muted">

                                        @Model.GetSkillAbilityName(
                                            skill.Skill)


                                        @if (skill.AdditionalBonus != 0)
                                        {
                                            <span>
                                                ·
                                                @(skill.AdditionalBonus > 0
                                                    ? $"+{skill.AdditionalBonus}"
                                                    : skill.AdditionalBonus.ToString())
                                                bonus
                                            </span>
                                        }


                                        @if (skill.OverrideBonus.HasValue)
                                        {
                                            <span>
                                                · Override
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <div class="skill-bonus">
                                @Model.FormatBonus(
                                    bonus)
                            </div>

                        </div>
                    }

                </div>


                <div class="card-footer
                    small
                    text-muted">

                    <span class="me-3">
                        ○ None
                    </span>

                    <span class="me-3">
                        ● Proficient
                    </span>

                    <span>
                        ◆ Expertise
                    </span>

                </div>

            </div>

            <div class="card mb-3">

                <div class="card-header">
                    Character Details
                </div>


                <div class="card-body">

                    <dl class="mb-0 character-details">

                        <dt>
                            Level
                        </dt>

                        <dd>
                            @Model.Character.Level
                        </dd>

                        <dt>
                            Movement Speed
                        </dt>

                        <dd>
                            @Model.Character.MovementSpeed ft.
                        </dd>

                        <dt>
                            Proficiency Bonus
                        </dt>

                        <dd>
                            +@Model.Character.ProficiencyBonus
