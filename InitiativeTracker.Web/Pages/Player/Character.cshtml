     aria-labelledby="characterAttackModalLabel"
     aria-hidden="true">

    <div class="modal-dialog
        modal-lg
        modal-dialog-scrollable
        modal-fullscreen-sm-down">

        <form method="post"
              asp-page-handler="SaveCharacterAttack"
              asp-route-id="@Model.Character.Id"
              id="characterAttackForm"
              class="modal-content">


            <input type="hidden"
                   id="characterAttackId"
                   name="attackId" />


            <div class="modal-header">

                <div>

                    <h2 class="modal-title fs-5"
                        id="characterAttackModalLabel">
                        Add Attack
