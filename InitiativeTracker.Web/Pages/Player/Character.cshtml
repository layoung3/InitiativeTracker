@page "/player/character/{id:guid}"
@model InitiativeTracker.Web.Pages.Player.CharacterModel
@using InitiativeTracker.Web.Data.Enums

@{
    ViewData["Title"] = Model.Character.Name;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/player-character.css"
          asp-append-version="true" />
}


<div class="container py-3 py-lg-4 character-sheet">

    @* ============================================================
       HEADER
       ============================================================ *@

    <div class="card mb-3 character-header">

        <div class="card-body">

            <div class="d-flex
                flex-column
                flex-md-row
                align-items-md-center
                gap-3">


                @* Portrait *@
                <div class="character-portrait-placeholder">

                    <span>
                        @Model.Character.Name.Substring(0, 1).ToUpper()
                    </span>

                </div>


                @* Character identity *@
                <div class="flex-grow-1">

                    <h1 class="h2 mb-1">
                        @Model.Character.Name
                    </h1>

                    <div class="d-flex
                        flex-wrap
                        align-items-center
                        gap-2
                        text-muted">

                        <span>
                            Level @Model.Character.Level
                        </span>

                        <span>·</span>

                        <span>
                            Speed @Model.Character.MovementSpeed ft.
                        </span>

                        <span>·</span>

                        <span>
                            Proficiency +@Model.Character.ProficiencyBonus
                        </span>

                    </div>

                </div>


                <div class="d-flex
                    flex-wrap
                    gap-2">

                    <a href="/player"
                       class="btn
                        btn-outline-secondary">
                        ← Characters
                    </a>

                    @*
                        We'll enable this in the next
                        checkpoint.
                    *@
                    <a asp-page="/Player/EditCharacter"
                       asp-route-id="@Model.Character.Id"
                       class="btn btn-outline-primary">
                        Edit Character
                    </a>

                </div>

            </div>

        </div>

    </div>



    @* ============================================================
       MOBILE / DESKTOP MAIN GRID
       ============================================================ *@

    <div class="row g-3">


        @* ========================================================
           ABILITY SCORES
           ======================================================== *@

        <div class="col-12
            col-lg-3
            order-2
            order-lg-1">

            <div class="card mb-3">

                <div class="card-header">
                    Ability Scores
                </div>


                <div class="card-body">

                    <div class="row
                        row-cols-3
                        row-cols-lg-2
                        g-2">


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    STR
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Strength)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Strength
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    DEX
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Dexterity)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Dexterity
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    CON
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Constitution)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Constitution
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    INT
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Intelligence)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Intelligence
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    WIS
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Wisdom)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Wisdom
                                </div>

                            </div>

                        </div>


                        <div class="col">

                            <div class="ability-score">

                                <div class="ability-name">
                                    CHA
                                </div>

                                <div class="ability-modifier">
                                    @Model.FormatModifier(
                                        Model.Character.Charisma)
                                </div>

                                <div class="ability-value">
                                    @Model.Character.Charisma
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="card">

                <div class="card-header">
                    Saving Throws
                </div>


                <div class="list-group
                    list-group-flush">

                    <div class="list-group-item
                        saving-throw-row">

                        <div class="d-flex
                            align-items-center
                            gap-2">

                            @if (Model.Character.StrengthSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">
                                    ●
                                </span>
                            }
                            else
                            {
                                <span class="save-proficiency
                                    text-muted"
                                      title="Not proficient">
                                    ○
                                </span>
                            }

                            <span class="fw-semibold">
                                Strength
                            </span>

                            <span class="text-muted
                                small">
                                STR
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Strength,
                                    Model.Character.StrengthSaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.DexteritySaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Dexterity
                            </span>

                            <span class="text-muted small">
                                DEX
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Dexterity,
                                    Model.Character.DexteritySaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.ConstitutionSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Constitution
                            </span>

                            <span class="text-muted small">
                                CON
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Constitution,
                                    Model.Character.ConstitutionSaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.IntelligenceSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Intelligence
                            </span>

                            <span class="text-muted small">
                                INT
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Intelligence,
                                    Model.Character.IntelligenceSaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.WisdomSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Wisdom
                            </span>

                            <span class="text-muted small">
                                WIS
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Wisdom,
                                    Model.Character.WisdomSaveProficient))
                        </strong>

                    </div>


                    <div class="list-group-item saving-throw-row">

                        <div class="d-flex align-items-center gap-2">

                            @if (Model.Character.CharismaSaveProficient)
                            {
                                <span class="save-proficiency"
                                      title="Proficient">●</span>
                            }
                            else
                            {
                                <span class="save-proficiency text-muted"
                                      title="Not proficient">○</span>
                            }

                            <span class="fw-semibold">
                                Charisma
                            </span>

                            <span class="text-muted small">
                                CHA
                            </span>

                        </div>

                        <strong>
                            @Model.FormatBonus(
                                Model.GetSavingThrowBonus(
                                    Model.Character.Charisma,
                                    Model.Character.CharismaSaveProficient))
                        </strong>

                    </div>

                </div>

            </div>

        </div>



        @* ========================================================
           MAIN CHARACTER INFORMATION
           ======================================================== *@

        <div class="col-12
            col-lg-6
            order-1
            order-lg-2">

            @* Combat / vitals *@
            <div class="card mb-3">

                <div class="card-header
                    d-flex
                    justify-content-between
                    align-items-center">

                    <span>
                        Combat
                    </span>

                    @if (Model.EncounterCombatant is not null)
                    {
                        <span class="badge
                            text-bg-success">
                            In Encounter
                        </span>
                    }

                </div>


                <div class="card-body">

                    <div class="combat-summary-grid">

                        @* ========================================================
                           HIT POINTS
                           ======================================================== *@

                        @if (Model.CanChangeLiveHp)
                        {
                            <button type="button"
                                    class="combat-stat-tile
                                combat-stat-action
                                combat-hp-tile
                                @(Model.OpenEditor == "hp"
                                    ? ""
                                    : "collapsed")"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#hpEditor"
                                    aria-expanded="@(Model.OpenEditor == "hp"
                                                                            ? "true"
                                                                            : "false")"
                                    aria-controls="hpEditor">

                                <span class="combat-stat-value">
                                    @Model.DisplayCurrentHp
                                    <span class="combat-stat-divider">/</span>
                                    @Model.DisplayMaxHp
                                </span>

                                <span class="combat-stat-label">
                                    Hit Points
                                </span>

                            </button>
                        }
                        else
                        {
                            <div class="combat-stat-tile
                                combat-hp-tile">

                                <span class="combat-stat-value">
                                    @Model.DisplayCurrentHp
                                    <span class="combat-stat-divider">/</span>
                                    @Model.DisplayMaxHp
                                </span>

                                <span class="combat-stat-label">
                                    Hit Points
                                </span>

                            </div>
                        }


                        @* ========================================================
                           TEMPORARY HP
                           ======================================================== *@

                        @if (Model.CanChangeLiveHp)
                        {
                            <button type="button"
                                    class="combat-stat-tile
                                combat-stat-action
                                combat-temp-hp
                                @(Model.OpenEditor == "temp"
                                    ? ""
                                    : "collapsed")"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#temporaryHpEditor"
                                    aria-expanded="@(Model.OpenEditor == "temp"
                                                                    ? "true"
                                                                    : "false")"
                                    aria-controls="temporaryHpEditor">

                                <span class="combat-stat-value">
                                    @Model.DisplayTemporaryHp
                                </span>

                                <span class="combat-stat-label">
                                    Temp HP
                                </span>

                            </button>
                        }
                        else
                        {
                            <div class="combat-stat-tile
                                combat-temp-hp">

                                <span class="combat-stat-value">
                                    @Model.DisplayTemporaryHp
                                </span>

                                <span class="combat-stat-label">
                                    Temp HP
                                </span>

                            </div>
                        }


                        @* ========================================================
                           INSPIRATION
                           ======================================================== *@

                        <form method="post"
                              asp-page-handler="ToggleInspiration"
                              asp-route-id="@Model.Character.Id"
                              class="combat-inspiration-form">

                            <button type="submit"
                                    class="combat-stat-tile
                                combat-stat-action
                                inspiration-stat
                                @(Model.Character.Inspiration
                                    ? "is-active"
                                    : "")"
                                    title="Toggle Inspiration"
                                    aria-label="Toggle Inspiration">

                                <span class="inspiration-star">

                                    <svg class="inspiration-star-icon"
                                         viewBox="0 0 24 24"
                                         role="img"
                                         aria-hidden="true">

                                        <polygon points="
                                        12,2.5
                                        14.9,8.4
                                        21.5,9.3
                                        16.7,13.9
                                        17.8,20.5
                                        12,17.4
                                        6.2,20.5
                                        7.3,13.9
                                        2.5,9.3
                                        9.1,8.4"
                                                 fill="@(Model.Character.Inspiration ? "currentColor" : "none")"
                                                 stroke="currentColor"
                                                 stroke-width="1.75"
                                                 stroke-linejoin="round" />

                                    </svg>

                                </span>

                                <span class="combat-stat-label">
                                    Inspiration
                                </span>

                            </button>

                        </form>

                    </div>


                    @* ============================================================
                       HP EDITOR
                       ============================================================ *@

                    @if (Model.CanChangeLiveHp)
                    {
                        <div id="combatEditors">
                            <div class="collapse
                                @(Model.OpenEditor == "hp"
                                    ? "show"
                                    : "")
                                mt-3"
                                 id="hpEditor"
                                 data-bs-parent="#combatEditors">

                                <div class="combat-editor">

                                    <div class="d-flex
                                        flex-column
                                        flex-sm-row
                                        justify-content-between
                                        gap-3">

                                        <div>

                                            <div class="small
                                                fw-semibold
                                                mb-2">
                                                Adjust Hit Points
                                            </div>


                                            <div class="d-flex
                                                flex-wrap
                                                gap-1">

                                                @foreach (var amount
                                                          in new[]
                                                          {
                                                          -5, -1, 1, 5
                                                          })
                                                {
                                                    <form method="post"
                                                          asp-page-handler="AdjustHp"
                                                          asp-route-id="@Model.Character.Id">

                                                        <button type="submit"
                                                                name="amount"
                                                                value="@amount"
                                                                class="btn
                                                            @(amount < 0
                                                                ? "btn-outline-danger"
                                                                : "btn-outline-success")">

                                                            @(amount > 0
                                                                ? $"+{amount}"
                                                                : amount.ToString())

                                                        </button>

                                                    </form>
                                                }

                                            </div>

                                        </div>


                                        <form method="post"
                                              asp-page-handler="SetHp"
                                              asp-route-id="@Model.Character.Id">

                                            <label class="form-label small">
                                                Set Current HP
                                            </label>


                                            <div class="input-group">

                                                <input type="number"
                                                       name="currentHp"
                                                       value="@Model.DisplayCurrentHp"
                                                       min="0"
                                                       class="form-control"
                                                       style="max-width: 7rem;" />

                                                <button type="submit"
                                                        class="btn
                                                    btn-outline-secondary">
                                                    Set
                                                </button>

                                            </div>

                                        </form>

                                    </div>

                                </div>

                            </div>


                            @* ========================================================
                           TEMP HP EDITOR
                           ======================================================== *@

                            <div class="collapse
                                @(Model.OpenEditor == "temp"
                                    ? "show"
                                    : "")
                                mt-3"
                                 id="temporaryHpEditor"
                                 data-bs-parent="#combatEditors">

                                <div class="combat-editor">

                                    <form method="post"
                                          asp-page-handler="SetTemporaryHp"
                                          asp-route-id="@Model.Character.Id">

                                        <label class="form-label small">
                                            Set Temporary HP
                                        </label>


                                        <div class="input-group"
                                             style="max-width: 14rem;">

                                            <input type="number"
                                                   name="temporaryHp"
                                                   value="@Model.DisplayTemporaryHp"
                                                   min="0"
                                                   class="form-control" />

                                            <button type="submit"
                                                    class="btn
                                                btn-outline-info">
                                                Set
                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>
                        </div>
                    }


                    @if (!Model.CanChangeLiveHp)
                    {
                        <div class="small
                            text-muted
                            mt-2">
                            Combat controls are currently assigned to
                            another player or the DM.
                        </div>
                    }


                    @* ============================================================
                       EXHAUSTION
                       ============================================================ *@

                    <div class="combat-state-row">

                        <div>

                            <div class="fw-semibold">
                                Exhaustion
                            </div>

                            <div class="small text-muted">
                                Level @Model.Character.ExhaustionLevel
                            </div>

                        </div>


                        <form method="post"
                              asp-page-handler="SetExhaustion"
                              asp-route-id="@Model.Character.Id"
                              class="exhaustion-control">

                            <button type="submit"
                                    name="exhaustionLevel"
                                    value="0"
                                    class="exhaustion-clear
                                @(Model.Character.ExhaustionLevel == 0
                                    ? "is-active"
                                    : "")"
                                    title="Clear exhaustion">
                                None
                            </button>


                            @for (var level = 1;
                                  level <= 6;
                                  level++)
                            {
                                <button type="submit"
                                        name="exhaustionLevel"
                                        value="@level"
                                        class="exhaustion-pip
                                    @(level <= Model.Character.ExhaustionLevel
                                        ? "is-active"
                                        : "")"
                                        title="Set exhaustion to level @level"
                                        aria-label="Set exhaustion to level @level">

                                    <span>
                                        @level
                                    </span>

                                </button>
                            }

                        </form>

                    </div>


                    @* ============================================================
                       CONDITIONS
                       ============================================================ *@

                    <div class="combat-state-row">

                        <div>

                            <div class="fw-semibold">
                                Conditions
                            </div>

                            <div class="small text-muted">
                                No active conditions
                            </div>

                        </div>


                        <button type="button"
                                class="btn
                            btn-sm
                            btn-outline-secondary"
                                disabled>
                            Manage
                        </button>

                    </div>

                </div>

            </div>



            @* Inventory placeholder *@
            <div class="card">

                <div class="card-header
                    d-flex
                    justify-content-between
                    align-items-center">

                    <span>
                        Inventory
                    </span>

                    <span class="badge
                        text-bg-secondary">
                        Coming next
                    </span>

                </div>


                <div class="card-body text-muted">

                    Character equipment, carried items,
                    currency, quantities, and notes will
                    live here.

                </div>

            </div>

        </div>



        @* ========================================================
           CHARACTER DETAILS
           ======================================================== *@

        <div class="col-12
            col-lg-3
            order-3
            order-lg-3">

            <div class="card mb-3">

                <div class="card-header
                    d-flex
                    justify-content-between
                    align-items-center">

                    <span>
                        Skills
                    </span>

                    <span class="small text-muted">
                        Bonus
                    </span>

                </div>


                <div class="list-group
                    list-group-flush
                    skill-list">

                    @foreach (var skill
                              in Model.Skills
                                  .OrderBy(
                                      x =>
                                          Model.GetSkillName(
                                              x.Skill)))
                    {
                        var bonus =
                            Model.GetSkillBonus(
                                skill);


                        <div class="list-group-item
                            skill-row">

                            <div class="d-flex
                                align-items-center
                                gap-2
                                min-width-0">

                                <div class="skill-proficiency">

                                    @switch (skill.ProficiencyLevel)
                                    {
                                        case SkillProficiencyLevel.Expertise:

                                            <span title="Expertise">
                                                ◆
                                            </span>

                                            break;


                                        case SkillProficiencyLevel.Proficient:

                                            <span title="Proficient">
                                                ●
                                            </span>

                                            break;


                                        default:

                                            <span class="text-muted"
                                                  title="Not proficient">
                                                ○
                                            </span>

                                            break;
                                    }

                                </div>


                                <div>

                                    <div class="fw-semibold
                                        skill-name">
                                        @Model.GetSkillName(
                                            skill.Skill)
                                    </div>

                                    <div class="small
                                        text-muted">

                                        @Model.GetSkillAbilityName(
                                            skill.Skill)


                                        @if (skill.AdditionalBonus != 0)
                                        {
                                            <span>
                                                ·
                                                @(skill.AdditionalBonus > 0
                                                    ? $"+{skill.AdditionalBonus}"
                                                    : skill.AdditionalBonus.ToString())
                                                bonus
                                            </span>
                                        }


                                        @if (skill.OverrideBonus.HasValue)
                                        {
                                            <span>
                                                · Override
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>


                            <div class="skill-bonus">
                                @Model.FormatBonus(
                                    bonus)
                            </div>

                        </div>
                    }

                </div>


                <div class="card-footer
                    small
                    text-muted">

                    <span class="me-3">
                        ○ None
                    </span>

                    <span class="me-3">
                        ● Proficient
                    </span>

                    <span>
                        ◆ Expertise
                    </span>

                </div>

            </div>

            <div class="card mb-3">

                <div class="card-header">
                    Character Details
                </div>


                <div class="card-body">

                    <dl class="mb-0 character-details">

                        <dt>
                            Level
                        </dt>

                        <dd>
                            @Model.Character.Level
                        </dd>

                        <dt>
                            Movement Speed
                        </dt>

                        <dd>
                            @Model.Character.MovementSpeed ft.
                        </dd>

                        <dt>
                            Proficiency Bonus
                        </dt>

                        <dd>
                            +@Model.Character.ProficiencyBonus
                        </dd>

                    </dl>

                </div>

            </div>



            <div class="card">

                <div class="card-header">
                    Party
                </div>


                <div class="card-body text-muted">

                    Shared party information and party
                    inventory will appear here later.

                </div>

            </div>

        </div>

    </div>

</div>

@if (Model.EncounterCombatant is not null &&
     Model.IsEncounterStarted &&
     Model.IsControlled)
{
    <div class="character-combat-bar">

        <div class="container
            character-combat-bar-content">

            @if (Model.IsCurrent)
            {
                <div>

                    <div class="fw-bold">
                        Your Turn
                    </div>

                    <div class="small text-muted">
                        Round @Model.EncounterRound
                    </div>

                </div>


                <form method="post"
                      asp-page-handler="EndTurn"
                      asp-route-id="@Model.Character.Id">

                    <button type="submit"
                            class="btn
                        btn-primary">
                        End Turn →
                    </button>

                </form>
            }
            else
            {
                <div>

                    <div class="fw-semibold">
                        In Combat
                    </div>

                    <div class="small text-muted">
                        Round @Model.EncounterRound
                        · Waiting for your turn
                    </div>

                </div>
            }

        </div>

    </div>
}

