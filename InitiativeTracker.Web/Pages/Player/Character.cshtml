                <div>

                    <h2 class="modal-title fs-5"
                        id="spellModalLabel">
                        Add Spell
                    </h2>

                    <div class="small text-muted">
                        @Model.Character.Name
                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
