<div class="modal fade"
     id="spellcastingModal"
     tabindex="-1"
     aria-labelledby="spellcastingModalLabel"
     aria-hidden="true">

    <div class="modal-dialog
        modal-lg
        modal-dialog-scrollable
        modal-fullscreen-sm-down">

        <form method="post"
              asp-page-handler="SaveSpellcasting"
              asp-route-id="@Model.Character.Id"
              class="modal-content"
              data-preserve-inventory-scroll="true">

            <div class="modal-header">

                <div>

                    <h2 class="modal-title fs-5"
                        id="spellcastingModalLabel">
                        Configure Spellcasting
                    </h2>

                    <div class="small text-muted">
                        @Model.Character.Name
                    </div>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <div class="row g-3 mb-4">

                    <div class="col-12 col-sm-4">

                        <label for="spellcastingAbility"
                               class="form-label">
                            Spellcasting Ability
                        </label>

                        <select id="spellcastingAbility"
                                name="spellcastingAbility"
                                class="form-select">

                            @foreach (var ability
                                      in Enum.GetValues<CharacterAbilityType>())
                            {
                                <option value="@ability"
                                        selected="@(Model.Spellcasting?.SpellcastingAbility == ability)">
                                    @ability
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-6 col-sm-4">

                        <label for="additionalSpellAttackBonus"
                               class="form-label">
                            Attack Bonus
                        </label>

                        <input type="number"
                               id="additionalSpellAttackBonus"
                               name="additionalSpellAttackBonus"
                               value="@(Model.Spellcasting?.AdditionalSpellAttackBonus ?? 0)"
                               class="form-control" />

                    </div>


                    <div class="col-6 col-sm-4">

                        <label for="additionalSpellSaveDcBonus"
                               class="form-label">
                            Save DC Bonus
                        </label>

                        <input type="number"
                               id="additionalSpellSaveDcBonus"
                               name="additionalSpellSaveDcBonus"
                               value="@(Model.Spellcasting?.AdditionalSpellSaveDcBonus ?? 0)"
                               class="form-control" />

                    </div>

                </div>


                <div class="fw-semibold mb-1">
                    Maximum Spell Slots
                </div>

                <div class="small text-muted mb-3">
                    Leave a level at 0 if this character
                    has no slots of that level.
                </div>


                <div class="spell-slot-config-grid">

                    @for (var level = 1;
                          level <= 9;
                          level++)
                    {
                        var slot =
                            Model.GetSpellSlot(
                                level);

                        var index =
                            level - 1;


                        <div>

                            <label class="form-label
                                small">
                                @Model.GetSpellLevelLabel(
                                    level)
                            </label>

                            <input type="hidden"
                                   name="spellSlots[@index].Level"
                                   value="@level" />

                            <input type="number"
                                   name="spellSlots[@index].MaximumSlots"
                                   min="0"
                                   value="@(slot?.MaximumSlots ?? 0)"
                                   class="form-control
                            form-control-sm" />

                        </div>
                    }

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn
                    btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>


                <button type="submit"
                        class="btn
                    btn-primary">
                    Save Spellcasting
                </button>

            </div>

        </form>

    </div>

</div>

