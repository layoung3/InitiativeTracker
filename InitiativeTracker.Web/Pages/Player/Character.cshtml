            </div>


            <div class="modal-body">

                <div class="row g-3 mb-4">

                    <div class="col-8">

                        <label for="spellName"
                               class="form-label">
                            Name
                        </label>

                        <input type="text"
                               id="spellName"
                               name="spellName"
                               maxlength="150"
                               class="form-control"
                               required />

                    </div>


                    <div class="col-4">

                        <label for="spellLevel"
                               class="form-label">
                            Level
                        </label>

                        <select id="spellLevel"
                                name="spellLevel"
                                class="form-select">

                            <option value="0">
                                Cantrip
                            </option>

                            @for (var level = 1;
                                  level <= 9;
                                  level++)
                            {
                                <option value="@level">
                                    @level
                                </option>
                            }

                        </select>

                    </div>


                    <div class="col-6">

                        <label for="spellSchool"
                               class="form-label">
                            School
                        </label>

                        <input type="text"
                               id="spellSchool"
                               name="school"
                               maxlength="50"
                               class="form-control"
                               placeholder="Evocation" />

                    </div>


                    <div class="col-6
                        d-flex
                        align-items-end">

                        <div class="form-check mb-2">

                            <input type="checkbox"
                                   id="spellPrepared"
                                   name="isPrepared"
                                   value="true"
                                   class="form-check-input"
                                   checked />

                            <label for="spellPrepared"
                                   class="form-check-label">
