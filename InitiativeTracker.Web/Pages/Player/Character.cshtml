                               id="spellCastingTime"
                               name="castingTime"
                               maxlength="100"
                               class="form-control"
                               placeholder="Action, Bonus Action, Reaction..." />

                    </div>


                    <div class="col-6 col-sm-3">

                        <label for="spellRange"
                               class="form-label">
                            Range
                        </label>

                        <input type="text"
                               id="spellRange"
                               name="range"
                               maxlength="100"
                               class="form-control"
                               placeholder="120 ft." />

                    </div>


                    <div class="col-6 col-sm-3">

                        <label for="spellArea"
                               class="form-label">
                            Area
                        </label>

                        <input type="text"
                               id="spellArea"
                               name="area"
                               maxlength="100"
                               class="form-control"
                               placeholder="20-ft radius" />

                    </div>


                    <div class="col-12 col-sm-6">

                        <label for="spellDuration"
                               class="form-label">
                            Duration
                        </label>

                        <input type="text"
                               id="spellDuration"
                               name="duration"
                               maxlength="100"
                               class="form-control"
                               placeholder="Instantaneous, 1 minute..." />

                    </div>


                    <div class="col-12 col-sm-6">

                        <label for="spellSavingThrow"
                               class="form-label">
                            Saving Throw
                        </label>

                        <select id="spellSavingThrow"
                                name="savingThrowAbility"
                                class="form-select">

                            <option value="">
                                None
                            </option>

                            @foreach (var ability
                                      in Enum.GetValues<CharacterAbilityType>())
                            {
                                <option value="@ability">
                                    @Model.GetAbilityAbbreviation(
                                        ability)
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="row g-2 mb-4">

                    <div class="col-auto">
                        <div class="form-check">
                            <input type="checkbox"
                                   id="spellVerbal"
                                   name="hasVerbalComponent"
                                   value="true"
                                   class="form-check-input" />
                            <label for="spellVerbal"
                                   class="form-check-label">V</label>
                        </div>
                    </div>

                    <div class="col-auto">
                        <div class="form-check">
                            <input type="checkbox"
                                   id="spellSomatic"
                                   name="hasSomaticComponent"
                                   value="true"
                                   class="form-check-input" />
                            <label for="spellSomatic"
                                   class="form-check-label">S</label>
                        </div>
                    </div>

                    <div class="col-auto">
                        <div class="form-check">
                            <input type="checkbox"
                                   id="spellMaterial"
                                   name="hasMaterialComponent"
                                   value="true"
                                   class="form-check-input" />
                            <label for="spellMaterial"
                                   class="form-check-label">M</label>
                        </div>
                    </div>

                    <div class="col-auto ms-sm-3">
                        <div class="form-check">
                            <input type="checkbox"
                                   id="spellConcentration"
                                   name="requiresConcentration"
                                   value="true"
                                   class="form-check-input" />
                            <label for="spellConcentration"
                                   class="form-check-label">
                                Concentration
                            </label>
                        </div>
                    </div>

                    <div class="col-auto">
                        <div class="form-check">
                            <input type="checkbox"
                                   id="spellRitual"
                                   name="isRitual"
                                   value="true"
                                   class="form-check-input" />
                            <label for="spellRitual"
                                   class="form-check-label">
                                Ritual
                            </label>
                        </div>
                    </div>

                    <div class="col-auto">
                        <div class="form-check">
                            <input type="checkbox"
                                   id="spellAttackRoll"
                                   name="hasSpellAttackRoll"
                                   value="true"
                                   class="form-check-input" />
                            <label for="spellAttackRoll"
                                   class="form-check-label">
                                Spell Attack
                            </label>
                        </div>
                    </div>

                </div>


                <div class="mb-4"
                     id="spellMaterialDescriptionContainer">

                    <label for="spellMaterialDescription"
                           class="form-label">
                        Material Component
                    </label>

                    <input type="text"
                           id="spellMaterialDescription"
                           name="materialDescription"
                           maxlength="500"
                           class="form-control" />

                </div>


                <div class="d-flex
                    justify-content-between
                    align-items-center
                    mb-2">

                    <div>
                        <div class="fw-semibold">
                            Effects
                        </div>
                        <div class="small text-muted">
                            Damage and healing shown on the compact spell row.
                        </div>
                    </div>

                    <button type="button"
                            id="addSpellEffect"
                            class="btn
                        btn-sm
                        btn-outline-secondary">
                        + Add Effect
                    </button>

                </div>


                <div id="spellEffects"
                     class="d-flex
                    flex-column
                    gap-3
                    mb-4">
                </div>


                <div>

                    <label for="spellNotes"
                           class="form-label">
                        Notes
                    </label>

                    <textarea id="spellNotes"
                              name="spellNotes"
                              maxlength="2000"
                              rows="4"
                              class="form-control"></textarea>

                </div>

            </div>


            <div class="modal-footer">

                <button type="submit"
                        id="deleteSpell"
                        asp-page-handler="DeleteSpell"
                        asp-route-id="@Model.Character.Id"
                        class="btn
                    btn-outline-danger
                    me-auto"
                        onclick="return confirm('Delete this spell?');">
                    Delete
                </button>


                <button type="button"
                        class="btn
                    btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>


                <button type="submit"
                        class="btn
                    btn-primary">
                    Save Spell
                </button>

            </div>

        </form>

    </div>

</div>

