@page "/secure-access"
@model InitiativeTracker.Web.Pages.SecureAccess.IndexModel
@inject InitiativeTracker.Web.Services.BrandingService Branding
@{
    ViewData["Title"] = "Security & Trusted Devices";
}
@section Styles {
    <link rel="stylesheet" href="~/css/security-dashboard.css" asp-append-version="true" />
}
<div class="security-dashboard container">
    <header class="security-heading">
        <div>
            <div class="mb-2"><partial name="_Brand" /></div>
            <h1 class="h3 mb-1">Security &amp; Trusted Devices</h1>
            <p class="text-body-secondary mb-0">Manage browser sessions and remembered approvals for this game.</p>
        </div>
        <div class="security-heading-actions">
            @if (Model.IsPhysical)
            {
                <a class="btn btn-outline-primary" href="/secure-access/physical">Pending hub approvals</a>
            }
            @if (Model.IsDm)
            {
                <a class="btn btn-primary" href="/dm">Back to DM Controls</a>
                <a class="btn btn-outline-secondary" href="/dm/devices">Connected Devices</a>
            }
            else if (Model.IsPhysical)
            {
                <a class="btn btn-outline-secondary" href="/setup">Hub Setup</a>
            }
        </div>
    </header>

    <div class="security-metrics" aria-label="Security summary">
        <div class="card"><div class="card-body"><strong>@Model.Sessions.Count</strong><span>Active sessions</span></div></div>
        <div class="card"><div class="card-body"><strong>@Model.RememberedDevices.Count</strong><span>Remembered browsers</span></div></div>
        <div class="card"><div class="card-body"><strong>@(Model.IsDm ? (Model.IsPhysical ? "DM + Hub" : "DM") : "Hub")</strong><span>Management access</span></div></div>
    </div>

    <nav class="security-tabs" aria-label="Security sections">
        <a href="#activeSessions">Active sessions</a>
        <a href="#rememberedBrowsers">Remembered browsers</a>
        @if (Model.IsDm) { <a href="#pendingApprovals">Pending approvals</a> }
    </nav>

    <section id="activeSessions" class="card mb-3" aria-labelledby="sessionsHeading">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h2 id="sessionsHeading" class="h5 mb-0">Active sessions</h2>
                <span class="small text-body-secondary">Select a row for details and actions</span>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 security-table">
                    <thead><tr><th>Person / role</th><th>Device</th><th>Browser</th><th>Expires</th></tr></thead>
                    <tbody>
                        @if (Model.Sessions.Count == 0)
                        {
                            <tr><td colspan="4" class="text-body-secondary py-4">No active secure sessions.</td></tr>
                        }
                        @foreach (var item in Model.Sessions)
                        {
                            <tr><td colspan="4" class="security-detail-cell">
                                <details class="security-detail-row">
                                    <summary class="security-grid-row" aria-label="Manage session for @item.Owner on @item.Device">
                                        <span><strong>@item.Owner</strong><small>@item.Role @if (item.IsCurrent) { <span>· This session</span> }</small></span>
                                        <span>@item.Device</span>
                                        <span class="font-monospace">@item.BrowserReference…</span>
                                        <span>@item.Expires.ToLocalTime().ToString("g")</span>
                                    </summary>
                                    <div class="security-expanded">
                                        <p class="small text-body-secondary mb-2">
                                            This @item.Role session has @(item.Remembered ? "a remembered browser approval" : "no remembered browser approval").
                                            Revoking it ends the session and cancels its matching remembered trust.
                                        </p>
                                        <form method="post" asp-page-handler="Revoke"
                                              onsubmit="return confirm('Revoke this exact browser session?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="btn btn-outline-danger" type="submit">Revoke session</button>
                                        </form>
                                    </div>
                                </details>
                            </td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section id="rememberedBrowsers" class="card mb-3" aria-labelledby="rememberedHeading">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h2 id="rememberedHeading" class="h5 mb-0">Remembered browsers</h2>
                <span class="small text-body-secondary">Optional · never permanent · 30 days maximum</span>
            </div>
            <p class="small text-body-secondary">
                Without remembering, a secure session lasts up to 12 hours. A remembered approval lasts
                up to 30 days, and ends earlier if the game or identity changes or approval is revoked.
            </p>
            <div class="table-responsive">
                <table class="table align-middle mb-0 security-table">
                    <thead><tr><th>Person / role</th><th>Device label</th><th>Browser</th><th>Trust expires</th></tr></thead>
                    <tbody>
                        @if (Model.RememberedDevices.Count == 0)
                        {
                            <tr><td colspan="4" class="text-body-secondary py-4">No browsers are remembered.</td></tr>
                        }
                        @foreach (var item in Model.RememberedDevices)
                        {
                            <tr><td colspan="4" class="security-detail-cell">
                                <details class="security-detail-row">
                                    <summary class="security-grid-row" aria-label="Manage remembered browser for @item.Owner on @item.Device">
                                        <span><strong>@item.Owner</strong><small>@item.Role @if (item.IsCurrent) { <span>· This browser</span> }</small></span>
                                        <span>@item.Device</span>
                                        <span class="font-monospace">@item.BrowserReference…</span>
                                        <span>@item.Expires.ToLocalTime().ToString("g")</span>
                                    </summary>
                                    <div class="security-expanded">
                                        <p class="small text-body-secondary mb-2">
                                            Forgetting this approval also revokes matching active sessions; the device will need authorization again.
                                        </p>
                                        <form method="post" asp-page-handler="Forget"
                                              onsubmit="return confirm('Forget this browser and revoke its secure sessions?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button class="btn btn-outline-danger" type="submit">Forget remembered browser</button>
                                        </form>
                                    </div>
                                </details>
                            </td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    @if (Model.IsDm)
    {
        <section id="pendingApprovals" class="card mb-3">
            <div class="card-body">
                <h2 class="h5">Pending member approvals</h2>
                <p class="small text-body-secondary">Confirm the exact browser reference and player/display identity before approving.</p>
                @if (Model.Requests.Count == 0)
                {
                    <p class="small text-body-secondary mb-0">No pending player or display requests.</p>
                }
                @foreach (var request in Model.Requests)
                {
                    <div class="security-pending-row">
                        <div><strong>@request.Identity.Role</strong><span class="font-monospace">@request.Reference</span>
                            <small>Profile @request.Identity.Profile · Display @request.Identity.Display</small></div>
                        <form method="post" asp-page-handler="Approve">
                            <input type="hidden" name="id" value="@request.Id" />
                            <button class="btn btn-outline-primary" type="submit">Approve exact request</button>
                        </form>
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.IsPhysical)
    {
        <details class="card mb-3 security-advanced">
            <summary class="card-body">Advanced authorization recovery</summary>
            <div class="card-body pt-0">
                <p class="small text-body-secondary">The manual proof flow is retained for hub recovery. Use ordinary sign-in for normal players and DMs.</p>
                <a class="btn btn-outline-secondary" href="/secure-access/manual">Open manual authorization</a>
            </div>
        </details>
    }
</div>
