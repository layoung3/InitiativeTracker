#!/usr/bin/env python3
"""N6.10D: rotate the *inactive* recovery AP password; no Wi-Fi activation.

Only accepts a single JSON object from stdin. A failed reload restores both files.
"""
import configparser
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

PROFILE_DIR = Path('/etc/NetworkManager/system-connections')
SECRET = Path('/etc/initiativetracker/network/recovery-wifi.password')
RECOVERY = 'InitiativeTracker-Recovery'
JOURNAL_DIR = Path('/var/lib/initiativetracker-network')


def valid_password(value):
    return (isinstance(value, str) and 8 <= len(value.encode('utf-8')) <= 63
            and all(32 <= ord(c) < 127 for c in value))


def check_journal(name):
    path = JOURNAL_DIR / name
    if path.is_symlink():
        raise RuntimeError('unsafe journal')
    if not path.exists():
        return
    data = json.loads(path.read_text(encoding='utf-8'))
    if not isinstance(data, dict) or data.get('state') in ('pending', 'switching', 'recovering'):
        raise RuntimeError('network transition active or unknown')


def find_profile():
    matches = []
    for path in PROFILE_DIR.glob('*.nmconnection'):
        if path.is_symlink() or not path.is_file():
            continue
        c = configparser.ConfigParser(interpolation=None, strict=False)
        c.optionxform = str
        try:
            c.read(path, encoding='utf-8')
            if c.get('connection', 'id', fallback='') == RECOVERY and c.get('wifi', 'mode', fallback='') == 'ap':
                matches.append((path, c))
        except (configparser.Error, UnicodeError):
            continue
    if len(matches) != 1:
        raise RuntimeError('recovery hotspot keyfile not uniquely found')
    path, conf = matches[0]
    st = path.stat()
    if st.st_uid != 0 or st.st_mode & 0o077:
        raise RuntimeError('unsafe NetworkManager profile permissions')
    return path, conf


def replace_private(path, content):
    fd, temp = tempfile.mkstemp(prefix='.it-rotate-', dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'wb') as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def reload_nm(profile):
    p = subprocess.run(['/usr/bin/nmcli', 'connection', 'load', str(profile)],
                       capture_output=True, timeout=15)
    if p.returncode != 0:
        raise RuntimeError('NetworkManager profile reload failed')


def rotate(password, *, is_active, profile, conf, secret):
    if is_active == RECOVERY:
        raise RuntimeError('disable hotspot before rotating password')
    if not valid_password(password):
        raise ValueError('invalid WPA password')
    old_profile = profile.read_bytes()
    old_secret = secret.read_bytes()
    conf['wifi-security']['psk'] = password
    import io
    stream = io.StringIO()
    conf.write(stream, space_around_delimiters=False)
    new_profile = stream.getvalue().encode('utf-8')
    try:
        replace_private(profile, new_profile)
        replace_private(secret, (password + '\n').encode('utf-8'))
        reload_nm(profile)
    except Exception:
        # Restore both on any error. If restoration itself fails, leave a clear
        # failure and require manual administrator repair before using the AP.
        replace_private(profile, old_profile)
        replace_private(secret, old_secret)
        reload_nm(profile)
        raise


def main():
    if os.geteuid() != 0:
        raise PermissionError('root required')
    raw = sys.stdin.buffer.read(1025)
    if len(raw) > 1024:
        raise ValueError('oversized password request')
    data = json.loads(raw)
    if not isinstance(data, dict) or set(data) != {'password'}:
        raise ValueError('invalid request')
    password = data['password']
    if not valid_password(password):
        raise ValueError('invalid password')
    if SECRET.is_symlink() or not SECRET.is_file():
        raise RuntimeError('unsafe secret file')
    st = SECRET.stat()
    if st.st_uid != 0 or st.st_mode & 0o077:
        raise RuntimeError('unsafe secret file permissions')
    check_journal('transition.json')
    check_journal('return-transition.json')
    active = subprocess.run(['/usr/bin/nmcli', '-g', 'GENERAL.CONNECTION', 'device', 'show', 'wlan0'],
                            capture_output=True, text=True, timeout=8, check=True).stdout.strip()
    if not active or active in ('--', 'unknown', RECOVERY):
        raise RuntimeError('requires an active external Wi-Fi connection')
    profile, config = find_profile()
    rotate(password, is_active=active, profile=profile, conf=config, secret=SECRET)
    print('HOTSPOT_PASSWORD_UPDATED=true')


if __name__ == '__main__':
    try:
        main()
    except Exception as exc:
        # Never reveal a secret, pathname containing credentials, or nmcli stderr.
        print('HOTSPOT_PASSWORD_UPDATE_FAILED=' + type(exc).__name__, file=sys.stderr)
        sys.exit(1)
