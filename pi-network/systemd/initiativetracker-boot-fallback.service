[Unit]
Description=InitiativeTracker boot offline fallback (gated)
After=NetworkManager.service
Wants=NetworkManager.service
[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/initiativetracker/initiativetracker-boot-fallback tick
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/initiativetracker-network
