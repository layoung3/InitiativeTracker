[Unit]
Description=InitiativeTracker restricted root network broker
Requires=initiativetracker-network-bridge.socket
After=NetworkManager.service

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/local/libexec/initiativetracker/initiativetracker-network-socketd
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/initiativetracker-network
RestrictAddressFamilies=AF_UNIX
TimeoutStartSec=60s
