[Unit]
Description=InitiativeTracker supervised return-to-saved-Wi-Fi rollback
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/initiativetracker/initiativetracker-network-return tick
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/initiativetracker-network
