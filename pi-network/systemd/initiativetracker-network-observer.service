[Unit]
Description=InitiativeTracker persistent network timing observer (no network writes)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/initiativetracker/initiativetracker-network-observer observe
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/initiativetracker-network
