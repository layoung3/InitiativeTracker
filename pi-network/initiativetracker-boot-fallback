#!/usr/bin/python3 -I
"""N6.7: opt-in automatic hotspot fallback when wlan0 has NO active connection.
Never switches AWAY from an active connection; does not touch recovery transition journal.
Runs every 10s under systemd; live changes require dedicated root-owned gate.
"""
import argparse, errno, fcntl, json, os, subprocess, sys, tempfile, uuid
from contextlib import ExitStack
from pathlib import Path

ROOT=Path('/var/lib/initiativetracker-network')
GATE=Path('/etc/initiativetracker/network/boot-fallback.enabled')
RECOVERY='InitiativeTracker-Recovery'
DEVICE='wlan0'
MIN_UPTIME=60
MIN_OFFLINE=0
MIN_SCAN_GAP=10


def nm(*args, timeout=25):
    p=subprocess.run(['/usr/bin/nmcli',*args],capture_output=True,text=True,timeout=timeout)
    if p.returncode: raise RuntimeError('nmcli failed: '+p.stderr.strip()[:300])
    return p.stdout

def gate():
    if GATE.is_symlink() or not GATE.is_file(): return False
    s=GATE.stat()
    return s.st_uid==0 and s.st_mode & 0o777==0o600 and GATE.read_text().strip()=='ENABLE_BOOT_FALLBACK=yes'

def active():
    v=nm('-g','GENERAL.CONNECTION','device','show',DEVICE).strip().splitlines()
    return v[0].strip() if v else ''

def device_state():
    return nm('-g','GENERAL.STATE','device','show',DEVICE).strip()

def activated(profile, device):
    # GENERAL.CONNECTION can already name a profile during association/authentication.
    return bool(profile and profile not in ('--','unknown') and device.startswith('100 '))


def uptime(): return float(Path('/proc/uptime').read_text().split()[0])
def boot_id(): return Path('/proc/sys/kernel/random/boot_id').read_text().strip()

def pending():
    for name, terminal in (('transition.json', ('completed', 'recovered')),
                           ('return-transition.json', ('confirmed', 'rolled_back', 'failed'))):
        p=ROOT/name
        if p.is_symlink(): return True
        if not p.exists(): continue
        try:
            if not p.is_file() or p.stat().st_size>16384: return True
            d=json.loads(p.read_text())
            if not isinstance(d,dict) or d.get('state') not in terminal: return True
        except Exception: return True
    return False

def save(s):
    fd,name=tempfile.mkstemp(prefix='.boot-fallback-',dir=ROOT)
    try:
        os.fchmod(fd,0o600)
        with os.fdopen(fd,'w') as f:
            json.dump(s,f,sort_keys=True);f.write('\n');f.flush();os.fsync(f.fileno())
        os.replace(name,ROOT/'boot-fallback.json')
    finally:
        if os.path.exists(name): os.unlink(name)

def load(boot):
    p=ROOT/'boot-fallback.json'
    if p.is_symlink(): raise ValueError('state symlink')
    if not p.exists(): return {'boot':boot,'offline_since':None,'scans':[],'last_action':None}
    if not p.is_file() or p.stat().st_size>16384: raise ValueError('invalid state')
    x=json.loads(p.read_text())
    if not isinstance(x,dict) or x.get('boot')!=boot:
        return {'boot':boot,'offline_since':None,'scans':[],'last_action':None}
    return x

def decision(active_profile,device,transition,up,offline_since,scans):
    if transition:return 'HOLD','recovery_transition_pending'
    if active_profile and active_profile not in ('--','unknown'):
        return 'HOLD','active_connection'
    if not device.startswith('30 '): return 'HOLD','device_not_disconnected'
    if offline_since is None or up-offline_since<MIN_OFFLINE:return 'WAIT','offline_grace'
    if len(scans)<2:return 'SCAN','need_independent_scans'
    if scans[-1]-scans[-2]<MIN_SCAN_GAP:return 'WAIT','scan_spacing'
    if up<MIN_UPTIME:return 'WAIT','startup_grace'
    return 'HOTSPOT','offline_confirmed'

def saved_visible():
    """Eligible external profiles keyed by UUID, never by ambiguous display name."""
    import importlib.machinery, importlib.util
    path=Path(__file__).with_name('initiativetracker-network-discovery')
    loader=importlib.machinery.SourceFileLoader('it_boot_discovery', str(path))
    spec=importlib.util.spec_from_loader('it_boot_discovery',loader)
    mod=importlib.util.module_from_spec(spec);loader.exec_module(mod)
    visible=mod.scan_cached(nm('-t','-f','SSID,SIGNAL','device','wifi','list',
                              'ifname',DEVICE,'--rescan','no'))
    matches=[]
    for line in nm('-t','-f','UUID,TYPE','connection','show').splitlines():
        fields=mod.split_nmcli(line)
        if len(fields)!=2 or fields[1] not in ('wifi','802-11-wireless'): continue
        ident=str(uuid.UUID(fields[0]))
        def field(key): return nm('-g',key,'connection','show','uuid',ident).strip()
        if field('802-11-wireless.mode') not in ('infrastructure',''): continue
        if field('connection.interface-name') not in ('', '--', DEVICE): continue
        if field('connection.autoconnect') != 'yes': continue
        # A single unescaped field needs only its output newline removed. SSID
        # spaces, colons and backslashes are significant, unlike metadata fields.
        ssid=nm('--escape','no','-g','802-11-wireless.ssid',
                'connection','show','uuid',ident).removesuffix('\n')
        if ssid not in visible: continue
        matches.append((int(field('connection.autoconnect-priority')),ident))
    return [ident for _,ident in sorted(matches, reverse=True)]


def attempt_saved(st):
    # One bounded attempt per eligible UUID per boot. An unusable visible SSID
    # must not postpone private access forever. Never interrupt an active link.
    attempted=st.setdefault('attempted',[])
    for ident in saved_visible():
        if ident in attempted: continue
        if pending() or active() not in ('','--','unknown'): return True
        if not device_state().startswith('30 '): return True
        attempted.append(ident);save(st)
        try:
            nm('--wait','15','connection','up','uuid',ident,'ifname',DEVICE,timeout=20)
        except (RuntimeError, subprocess.TimeoutExpired):
            pass
        if active() not in ('','--','unknown'): return True
        # Let the timer recheck device readiness between bounded attempts.
        return True
    return False


def go(action):
    if os.geteuid()!=0:raise PermissionError('requires sudo')
    if ROOT.is_symlink() or not ROOT.is_dir():raise ValueError('state directory missing')
    with ExitStack() as stack:
        # Match the independent controllers' locks, in a fixed order.
        for name in ('boot-fallback.lock', 'control.lock', 'return-transition.lock'):
            lock=stack.enter_context((ROOT/name).open('a+b'))
            try:
                fcntl.flock(lock,fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError as error:
                if error.errno not in (errno.EAGAIN,errno.EWOULDBLOCK): raise
                # The controller owns this tick; ExitStack releases earlier locks.
                # Defer without reading/writing policy state or calling nmcli.
                print('RECOMMENDATION=HOLD')
                print('REASON=controller_lock_busy')
                print('BUSY_LOCK='+name)
                print('EXECUTED_NETWORK_ACTION=NONE',flush=True)
                return
        up=uptime(); st=load(boot_id()); a=active(); dev=device_state(); pend=pending()
        if a and a not in ('--','unknown'):
            st['offline_since']=None;st['scans']=[]
            if activated(a,dev): st['settled']=True
        elif st['offline_since'] is None:st['offline_since']=up
        outcome,reason=decision(a,dev,pend,up,st['offline_since'],st['scans'])
        live=gate()
        print('N67_MODE='+('LIVE_ARMED' if live else 'DRY_RUN'))
        print('ACTIVE_PROFILE='+a)
        print('TRANSITION_PENDING='+str(pend).lower())
        print('RECOMMENDATION='+outcome)
        print('REASON='+reason)
        print('EXECUTED_NETWORK_ACTION=NONE',flush=True) if action=='status' or not live else None
        if action=='status':return
        if st.get('settled'):save(st);return
        if not live:
            save(st)
            return
        if outcome=='SCAN':
            # NetworkManager is expected to attempt saved autoconnections during grace.
            if st['scans'] and up-st['scans'][-1]<MIN_SCAN_GAP:return
            # Only proceed on disconnected wlan0 with no recovery transition.
            nm('-w','20','device','wifi','rescan','ifname',DEVICE,timeout=25)
            st['scans'].append(uptime());st['scans']=st['scans'][-2:]
            save(st)
            attempt_saved(st)
            print('EXECUTED_NETWORK_ACTION=REQUEST_SCAN')
            return
        if outcome=='HOTSPOT':
            # Recheck immediately; no active profile may be interrupted.
            if active() not in ('','--','unknown') or pending() or not device_state().startswith('30 '):
                print('EXECUTED_NETWORK_ACTION=ABORT_RECHECK');return
            # Refresh once at the deadline; early boot scans may miss late radios.
            nm('-w','10','device','wifi','rescan','ifname',DEVICE,timeout=15)
            if attempt_saved(st):
                print('EXECUTED_NETWORK_ACTION=SAVED_WIFI_ATTEMPT');return
            if active() not in ('','--','unknown') or pending() or not device_state().startswith('30 '):return
            if RECOVERY not in nm('-g','NAME','connection','show').splitlines():
                raise RuntimeError('recovery profile absent')
            nm('--wait','25','connection','up','id',RECOVERY,'ifname',DEVICE,timeout=35)
            print('EXECUTED_NETWORK_ACTION=ACTIVATE_PRIVATE_HOTSPOT')
            st['last_action']=uptime()
            st['settled']=activated(active(),device_state());save(st)
        else:save(st)

def main():
    ap=argparse.ArgumentParser(description=__doc__)
    ap.add_argument('action',choices=['status','tick'])
    a=ap.parse_args()
    try:go(a.action);return 0
    except (OSError,ValueError,PermissionError,RuntimeError,subprocess.TimeoutExpired) as e:
        print('N67_ERROR='+str(e),file=sys.stderr);return 1
if __name__=='__main__':sys.exit(main())
