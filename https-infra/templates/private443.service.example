# REVIEW ONLY: separately approved network stage, not an app/release installer.
[Unit]
Description=Private source-preserving InitiativeTracker browser 443 ingress
After=network-pre.target
Before=initiativetracker.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/initiativetracker-https/private443.nft
ExecStop=/usr/sbin/nft delete table inet initiativetracker_browser443
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
