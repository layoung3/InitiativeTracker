#!/bin/bash -p
set -Eeuo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
# Releases must remain traversable by the service user. Scope private umasks
# to backups below, never the entire extraction/installation process.
umask 022

CONFIG_FILE="/etc/initiativetracker/updater.conf"

APPLICATION_ROOT="/opt/initiativetracker"
RELEASES_ROOT="${APPLICATION_ROOT}/releases"
CURRENT_LINK="${APPLICATION_ROOT}/current"

DATA_DIRECTORY="/var/lib/initiativetracker"
BACKUP_ROOT="/var/backups/initiativetracker"
CACHE_ROOT="/var/cache/initiativetracker-updater"

PERSISTENT_APPSETTINGS="/etc/initiativetracker/appsettings.Production.json"
SERVICE_NAME="initiativetracker.service"

HEALTH_URL="http://127.0.0.1:5000/system/health"

log()
{
    printf '[InitiativeTracker installer] %s\n' "$*"
    logger \
        -t initiativetracker-updater \
        -- "$*" \
        2>/dev/null ||
    true
}

fail()
{
    log "ERROR: $*"
    exit 1
}

fetch_source()
{
    local source="$1"
    local destination="$2"

    if [[ "$source" == https://* ]]; then
        curl \
            --fail \
            --silent \
            --show-error \
            --location \
            --connect-timeout 10 \
            --max-time 120 \
            "$source" \
            --output "$destination"
        return
    fi

    if [[ "$source" == http://* ]]; then
        if [[ "${ALLOW_INSECURE_HTTP:-false}" != "true" ]]; then
            fail "Plain HTTP update sources are disabled."
        fi

        curl \
            --fail \
            --silent \
            --show-error \
            --location \
            --connect-timeout 10 \
            --max-time 120 \
            "$source" \
            --output "$destination"
        return
    fi

    if [[ "$source" == file://* ]]; then
        cp -- "${source#file://}" "$destination"
        return
    fi

    cp -- "$source" "$destination"
}

wait_for_health()
{
    local expected_version="${1:-}"
    local attempts="${2:-60}"

    local response_file
    response_file="$(mktemp)"

    for ((attempt = 1; attempt <= attempts; attempt++)); do
        if curl \
            --fail \
            --silent \
            --connect-timeout 2 \
            --max-time 4 \
            "$HEALTH_URL" \
            --output "$response_file" \
            2>/dev/null; then

            if /usr/bin/python3 -I - \
                "$response_file" \
                "$expected_version" <<'PY'
import json
import sys

path = sys.argv[1]
expected = sys.argv[2]

try:
    with open(path, "r", encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    sys.exit(1)

if data.get("status") != "healthy":
    sys.exit(1)

if expected and str(data.get("version", "")) != expected:
    sys.exit(1)

sys.exit(0)
PY
            then
                rm -f "$response_file"
                return 0
            fi
        fi

        sleep 2
    done

    rm -f "$response_file"
    return 1
}

if [[ "$EUID" -ne 0 ]]; then
    fail "This installer must run as root."
fi

if [[ $# -ne 0 ]]; then
    fail "Installer does not accept command-line update sources."
fi

/usr/bin/python3 -I - "$CONFIG_FILE" <<'PY'
from pathlib import Path
import os, stat, sys
path = Path(sys.argv[1])
for node in (path, *path.parents):
    info = node.lstat()
    if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit('Updater configuration ancestry is not root trusted.')
PY

if [[ ! -f "$CONFIG_FILE" || -L "$CONFIG_FILE" ||
      "$(stat -c '%u' "$CONFIG_FILE")" != "0" ||
      "$(stat -c '%a' "$CONFIG_FILE")" != "644" ]]; then
    fail "Updater configuration must be a root-owned regular file (0644)."
fi

# Root-controlled configuration, not user-provided sudo arguments.
# shellcheck disable=SC1090
source "$CONFIG_FILE"
MANIFEST_SOURCE="${MANIFEST_SOURCE:-}"
[[ -n "$MANIFEST_SOURCE" ]] || fail "MANIFEST_SOURCE is empty."

# The first test accepts only a root-owned local staging folder.
# Future HTTPS releases require a separate signed-manifest security pass.
STAGING_DIR="/var/cache/initiativetracker-updater/incoming"
/usr/bin/python3 -I - "$MANIFEST_SOURCE" "$STAGING_DIR" <<'PY'
from pathlib import Path
import stat, sys
path, staging = map(Path, sys.argv[1:])
if path.parent != staging or not path.name.endswith('.manifest.json'):
    raise SystemExit('Manifest must be directly inside incoming and end .manifest.json.')
for node in (path, *path.parents):
    info = node.lstat()
    if stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit('Staged manifest ancestry is not root trusted.')
PY
if [[ "$MANIFEST_SOURCE" != "$STAGING_DIR/"* ||
      "$MANIFEST_SOURCE" != *.manifest.json ]]; then
    fail "Only staged local manifests under $STAGING_DIR are permitted."
fi
if [[ -L "$MANIFEST_SOURCE" || ! -f "$MANIFEST_SOURCE" ||
      "$(stat -c '%u' "$MANIFEST_SOURCE")" != "0" ]]; then
    fail "Staged manifest must be a root-owned regular file."
fi
if [[ "$(stat -c '%u' "$STAGING_DIR")" != "0" ||
      "$(stat -c '%a' "$STAGING_DIR")" != "755" ]]; then
    fail "Staging directory must be root owned (0755)."
fi

ALLOW_INSECURE_HTTP="${ALLOW_INSECURE_HTTP:-false}"

if [[ "$(uname -m)" != "aarch64" ]]; then
    fail "This release installer currently supports ARM64 Linux only."
fi

command -v curl >/dev/null 2>&1 ||
    fail "curl is required."

command -v python3 >/dev/null 2>&1 ||
    fail "python3 is required."

command -v sha256sum >/dev/null 2>&1 ||
    fail "sha256sum is required."

command -v flock >/dev/null 2>&1 ||
    fail "flock is required."

install -d \
    -m 0755 \
    "$RELEASES_ROOT" \
    "$CACHE_ROOT"
install -d -o root -g root -m 0700 "$BACKUP_ROOT"

exec 9>"/run/lock/initiativetracker-updater.lock"

if ! flock -n 9; then
    fail "Another InitiativeTracker update is already running."
fi

work_directory="$(
    mktemp \
        -d \
        "${CACHE_ROOT}/update.XXXXXX"
)"

# Invoked indirectly by the EXIT trap, including rollback below.
# shellcheck disable=SC2317
cleanup()
{
    local result=$?
    trap - EXIT ERR INT TERM
    # Before activation the old release/data still agree. Restart it if any
    # backup/link operation failed after stop. After activation use rollback.
    if [[ "${transaction_done:-false}" != true && "${service_stopped:-false}" == true ]]; then
        if [[ "${activated:-false}" == true ]]; then
            rollback || log 'CRITICAL: recovery incomplete; service/data preserved for local inspection.'
        else
            systemctl start "$SERVICE_NAME" || log 'CRITICAL: previous service could not restart.'
        fi
    fi
    rm -rf "$work_directory"
    exit "$result"
}

trap cleanup EXIT

manifest_path="${work_directory}/release-manifest.json"

log "Downloading release manifest."

fetch_source \
    "$MANIFEST_SOURCE" \
    "$manifest_path"


mapfile -t manifest_values < <(
    /usr/bin/python3 -I - "$manifest_path" <<'PY'
import json
import os
import re
import sys

path = sys.argv[1]

try:
    with open(path, "r", encoding="utf-8-sig") as handle:
        data = json.load(handle)
except Exception as exc:
    print(f"Manifest could not be read: {exc}", file=sys.stderr)
    sys.exit(2)

errors = []

if data.get("formatVersion") != 1:
    errors.append("formatVersion must be 1")

if data.get("product") != "InitiativeTracker":
    errors.append("product must be InitiativeTracker")

if data.get("platform") != "linux-arm64":
    errors.append("platform must be linux-arm64")

if data.get("healthPath") != "/system/health":
    errors.append("healthPath must be /system/health")

version = str(data.get("version", "")).strip()

semver = re.compile(
    r"^(0|[1-9]\d*)\."
    r"(0|[1-9]\d*)\."
    r"(0|[1-9]\d*)"
    r"(?:-[0-9A-Za-z.-]+)?"
    r"(?:\+[0-9A-Za-z.-]+)?$"
)

if not semver.fullmatch(version):
    errors.append("version is not valid semantic version syntax")

package = data.get("package")

if not isinstance(package, dict):
    errors.append("package is missing")
    package = {}

file_name = str(package.get("fileName", "")).strip()
if not re.fullmatch(r"InitiativeTracker-[0-9A-Za-z.+-]+-linux-arm64\.tar\.gz", file_name):
    errors.append("unexpected package filename")

if (
    not file_name
    or file_name != os.path.basename(file_name)
    or ".." in file_name
    or "/" in file_name
    or "\\" in file_name
):
    errors.append("package fileName is unsafe")

try:
    size_bytes = int(package.get("sizeBytes", 0))
except Exception:
    size_bytes = 0

if size_bytes <= 0:
    errors.append("package sizeBytes must be greater than zero")

sha256 = str(package.get("sha256", "")).strip().lower()

if not re.fullmatch(r"[0-9a-f]{64}", sha256):
    errors.append("package sha256 must contain 64 hexadecimal characters")

if errors:
    for error in errors:
        print(error, file=sys.stderr)

    sys.exit(3)

print(version)
print(file_name)
print(size_bytes)
print(sha256)
PY
)

if [[ ${#manifest_values[@]} -ne 4 ]]; then
    fail "Release manifest validation failed."
fi

version="${manifest_values[0]}"
package_file_name="${manifest_values[1]}"
expected_size="${manifest_values[2]}"
expected_sha256="${manifest_values[3]}"

current_target="$(
    readlink -f \
        "$CURRENT_LINK" \
        2>/dev/null ||
    true
)"

if [[ -z "$current_target" ||
      ! -x "${current_target}/InitiativeTracker.Web" ]]; then
    fail "Current InitiativeTracker release could not be resolved."
fi

current_name="$(basename "$current_target")"
current_version="${current_name%-linux-arm64}"

if [[ "$version" == "$current_version" ]]; then
    log "Version $version is already installed."
    exit 0
fi

package_source="$(
    /usr/bin/python3 -I - \
        "$MANIFEST_SOURCE" \
        "$package_file_name" <<'PY'
from pathlib import Path
from urllib.parse import urljoin
import sys

source = sys.argv[1]
file_name = sys.argv[2]

if source.startswith(("https://", "http://")):
    print(urljoin(source, file_name))
elif source.startswith("file://"):
    path = Path(source[7:])
    print("file://" + str(path.parent / file_name))
else:
    path = Path(source)
    print(str(path.parent / file_name))
PY
)"

if [[ -L "${STAGING_DIR}/${package_file_name}" ||
      ! -f "${STAGING_DIR}/${package_file_name}" ||
      "$(stat -c '%u' "${STAGING_DIR}/${package_file_name}")" != "0" ||
      $(( 8#$(stat -c '%a' "${STAGING_DIR}/${package_file_name}") & 8#022 )) -ne 0 ]]; then
    fail "Staged package must be a root-owned regular file."
fi

package_path="${work_directory}/${package_file_name}"

log "Downloading release package ${package_file_name}."

fetch_source \
    "$package_source" \
    "$package_path"


actual_size="$(
    stat \
        -c '%s' \
        "$package_path"
)"

if [[ "$actual_size" != "$expected_size" ]]; then
    fail \
        "Package size mismatch. Expected ${expected_size}, got ${actual_size}."
fi

actual_sha256="$(
    sha256sum \
        "$package_path" |
    awk '{print tolower($1)}'
)"

if [[ "$actual_sha256" != "$expected_sha256" ]]; then
    fail "Package SHA-256 does not match the manifest."
fi


extracted_directory="${work_directory}/extracted"

mkdir -p \
    "$extracted_directory"

log "Inspecting and extracting release package."

/usr/bin/python3 -I - \
    "$package_path" \
    "$extracted_directory" <<'PY'
from pathlib import Path, PurePosixPath
import os
import sys
import tarfile

archive_path = Path(sys.argv[1])
destination = Path(sys.argv[2]).resolve()

with tarfile.open(archive_path, "r:gz") as archive:
    members = archive.getmembers()

    if not members:
        raise SystemExit("Release archive is empty.")

    found_executable = False

    for member in members:
        normalized = member.name.replace("\\", "/")

        while normalized.startswith("./"):
            normalized = normalized[2:]

        if not normalized:
            continue

        path = PurePosixPath(normalized)

        if path.is_absolute() or ".." in path.parts:
            raise SystemExit(
                f"Unsafe archive path: {member.name}"
            )

        if normalized == "InitiativeTracker.Web":
            if not member.isfile():
                raise SystemExit(
                    "InitiativeTracker.Web is not a regular file."
                )

            found_executable = True

    if not found_executable:
        raise SystemExit(
            "InitiativeTracker.Web was not found at the archive root."
        )

    # Python 3.12+ data filtering blocks extraction paths and link targets
    # that escape the destination and rejects dangerous special files.
    archive.extractall(
        destination,
        filter="data"
    )

executable = destination / "InitiativeTracker.Web"

if not executable.is_file():
    raise SystemExit(
        "InitiativeTracker.Web was not extracted."
    )
PY


release_directory="${RELEASES_ROOT}/${version}-linux-arm64"

if [[ "$release_directory" == "$current_target" ]]; then
    log "Version $version is already the active release."
    exit 0
fi

if [[ -e "$release_directory" ]]; then
    fail "Target release directory already exists; refusing to overwrite it."
fi

mv \
    "$extracted_directory" \
    "$release_directory"

# mktemp's private work directory must not become the release root at 0700.
chmod 0755 "$release_directory"

chown -R \
    root:root \
    "$release_directory"

chmod \
    0755 \
    "${release_directory}/InitiativeTracker.Web"

if [[ -f "$PERSISTENT_APPSETTINGS" ]]; then
    install \
        -o root \
        -g root \
        -m 0644 \
        "$PERSISTENT_APPSETTINGS" \
        "${release_directory}/appsettings.Production.json"
else
    fail \
        "Persistent production configuration was not found at ${PERSISTENT_APPSETTINGS}."
fi


timestamp="$(
    date -u \
        +'%Y%m%dT%H%M%SZ'
)"

backup_path="${BACKUP_ROOT}/pre-update-${current_version}-to-${version}-${timestamp}.tar.gz"
[[ ! -e "$backup_path" && ! -L "$backup_path" ]] || fail 'Backup already exists; refusing overwrite.'
transaction_done=false
service_stopped=false
activated=false

# Fence backup-era browser grants before any restored app can authenticate them.
# shellcheck disable=SC2317
fence_restored_secure_access()
{
    /usr/bin/python3 -I - "$1" <<'PY_SECURE_FENCE'
# BEGIN SECURE ROLLBACK FENCE
import os
from pathlib import Path
import secrets
import sys

root = Path(sys.argv[1])
if not root.is_absolute():
    raise SystemExit('Rollback data path must be absolute.')
flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
root_fd = os.open(root, flags)
try:
    owner = os.fstat(root_fd)
    try:
        os.mkdir('secure-access', 0o700, dir_fd=root_fd)
    except FileExistsError:
        pass
    secure_fd = os.open('secure-access', flags, dir_fd=root_fd)
    try:
        os.fchmod(secure_fd, 0o700)
        os.fchown(secure_fd, owner.st_uid, owner.st_gid)
        temporary = '.rollback-fence-' + secrets.token_hex(16)
        marker = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                         0o600, dir_fd=secure_fd)
        try:
            os.fchown(marker, owner.st_uid, owner.st_gid)
            os.write(marker, b'rollback-requires-fresh-physical-recovery\n')
            os.fsync(marker)
        finally:
            os.close(marker)
        # Replacement never follows a stale marker symlink or truncates a hardlink.
        os.replace(temporary, 'mutation.pending', src_dir_fd=secure_fd, dst_dir_fd=secure_fd)
        os.fsync(secure_fd)
    finally:
        os.close(secure_fd)
    os.fsync(root_fd)
finally:
    os.close(root_fd)
# Persist the restored directory entry, including any freshly created ancestors.
for parent in root.parents:
    descriptor = os.open(parent, flags)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
# END SECURE ROLLBACK FENCE
PY_SECURE_FENCE
}

# Invoked by cleanup through the EXIT trap after activation.
# shellcheck disable=SC2317
rollback()
{
    # Never move data while the app may still be writing it.
    systemctl stop "$SERVICE_NAME" || return 1
    local failed_data_directory="${DATA_DIRECTORY}.failed-${version}-${timestamp}"
    local restored="${DATA_DIRECTORY}.restore-${timestamp}"
    [[ ! -e "$failed_data_directory" && ! -e "$restored" ]] || return 1
    install -d -o initiativetracker -g initiativetracker -m 0750 "$restored" || return 1
    tar -xzf "$backup_path" -C "$restored" || return 1
    chown -R initiativetracker:initiativetracker "$restored" || return 1
    fence_restored_secure_access "$restored" || return 1
    # Prepare/verify the complete restored tree before moving the failed data.
    mv "$DATA_DIRECTORY" "$failed_data_directory" || return 1
    if ! mv "$restored" "$DATA_DIRECTORY"; then
        mv "$failed_data_directory" "$DATA_DIRECTORY" || true
        return 1
    fi
    local rollback_link="${APPLICATION_ROOT}/current.rollback"
    [[ ! -e "$rollback_link" && ! -L "$rollback_link" ]] || return 1
    ln -s "$current_target" "$rollback_link" || return 1
    mv -Tf "$rollback_link" "$CURRENT_LINK" || return 1
    systemctl start "$SERVICE_NAME" || return 1
    wait_for_health "$current_version" 60 || return 1
    transaction_done=true
    log "Rollback succeeded; failed migrated data retained at ${failed_data_directory}."
}

log \
    "Stopping InitiativeTracker before database backup."

systemctl stop \
    "$SERVICE_NAME"
service_stopped=true

if ! (umask 077; tar \
    --numeric-owner \
    -czf "$backup_path" \
    -C "$DATA_DIRECTORY" \
    .); then

    fail "Persistent data backup failed."
fi
chmod 0600 "$backup_path"

log \
    "Persistent data backup created: ${backup_path}"

new_link="${APPLICATION_ROOT}/current.new"
[[ ! -e "$new_link" && ! -L "$new_link" ]] || fail 'Pending activation link exists; inspect locally.'

ln -s \
    "$release_directory" \
    "$new_link"

mv -Tf \
    "$new_link" \
    "$CURRENT_LINK"
activated=true

log \
    "Activated InitiativeTracker ${version}."

systemctl start \
    "$SERVICE_NAME"


if wait_for_health \
        "$version" \
        60; then
    transaction_done=true

    log \
        "Update to InitiativeTracker ${version} passed the health check."

    log \
        "Previous release retained at ${current_target}."

    log \
        "Backup retained at ${backup_path}."

    exit 0
fi


log \
    "New release failed health validation. Starting rollback."
# EXIT performs the same recovery for health, service-start, and link failures.
exit 1
