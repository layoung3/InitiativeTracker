#!/bin/bash -p
set -u

# Fresh installs background this same resolved home launcher from Labwc. The
# optional supervisor dispatch preserves the original no-argument launch path
# used by existing hubs and by the supervisor's own child invocation.
if [[ "${1:-}" == --supervise && $# -eq 2 ]]; then
    exec /usr/bin/python3 -I "${HOME}/.local/lib/initiativetracker-hub/kiosk.py" "$2"
elif [[ $# -ne 0 ]]; then
    printf '%s\n' 'Usage: initiativetracker-hub-launch [--supervise /path/to/kiosk.json]' >&2
    exit 64
fi

BASE_URL="http://127.0.0.1:5000"
TARGET_URL="${BASE_URL}/setup"
PROFILE_DIR="${HOME}/.config/initiativetracker-hub/chromium"
UPDATE_CHECKER="/usr/local/bin/initiativetracker-check-update"

# A local dialog provides touch-friendly feedback before the web app is ready.
# It never owns the persistent Chromium profile, and is closed before the
# existing graphical checker gets control. Closing it does not cancel startup.
LOADING_PID=""
close_loading()
{
    if [[ -n "$LOADING_PID" ]]; then
        kill "$LOADING_PID" 2>/dev/null || true
        wait "$LOADING_PID" 2>/dev/null || true
        LOADING_PID=""
    fi
}
show_loading()
{
    local artwork="${HOME}/.local/lib/initiativetracker-hub/colophon.png"
    local icon_args=()
    [[ ! -f "$artwork" ]] || icon_args=(--icon-name="$artwork")
    zenity --info --no-wrap --width=440 --title='Colophon · Initiative Tracker' \
        --text="$1" "${icon_args[@]}" >/dev/null 2>&1 &
    LOADING_PID=$!
}
trap close_loading EXIT
trap 'close_loading; exit 130' HUP INT TERM

mkdir -p \
    "$PROFILE_DIR"

wait_for_hub()
{
    local attempt
    for ((attempt=1; attempt<=60; attempt++)); do
      if curl \
        --fail \
        --silent \
        --connect-timeout 2 \
        --max-time 4 \
        "${BASE_URL}/system/health" \
        >/dev/null 2>&1; then
        return 0
      fi
        sleep 2
    done
    close_loading
    zenity --error --timeout=15 --title='InitiativeTracker needs attention' \
      --text='Hub health did not become ready. Check the application service locally. The kiosk will retry.' 2>/dev/null || true
    return 1
}

show_loading 'Starting your table…\nWaiting for the local hub. No keyboard is needed.'
wait_for_hub || exit 75
close_loading

if [[ -x "$UPDATE_CHECKER" ]]; then
    "$UPDATE_CHECKER" ||
        true
fi

# The updater may have restarted the application.
show_loading 'Preparing your table…\nThe display opens automatically when the hub is ready.'
wait_for_hub || exit 75
close_loading

# Secure physical mode is opt-in only. A separate reviewed configuration names
# the exact HTTPS origin; kiosk.py verifies system trust, loopback-only DNS and
# healthy local app before selecting it. Fail back to legacy local Setup without
# granting any secure authorization over HTTP.
KIOSK_SETTINGS="${HOME}/.config/initiativetracker-hub/kiosk.json"
KIOSK_HELPER="${HOME}/.local/lib/initiativetracker-hub/kiosk.py"
if [[ -f "$KIOSK_SETTINGS" && -f "$KIOSK_HELPER" ]]; then
    CANDIDATE=$(/usr/bin/python3 -I "$KIOSK_HELPER" --hub-target "$KIOSK_SETTINGS") || CANDIDATE=""
    if [[ "$CANDIDATE" == "http://127.0.0.1:5000/setup" ||
          ( "$CANDIDATE" == https://* && "$CANDIDATE" == */setup ) ]]; then
        TARGET_URL="$CANDIDATE"
    fi
fi

exec /usr/bin/chromium \
    --kiosk \
    --start-maximized \
    --noerrdialogs \
    --disable-infobars \
    --no-first-run \
    --disable-session-crashed-bubble \
    --disable-features=TranslateUI \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    --password-store=basic \
    --user-data-dir="$PROFILE_DIR" \
    "$TARGET_URL"
