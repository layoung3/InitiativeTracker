#!/usr/bin/env bash
set -u

CONFIG_FILE="/etc/initiativetracker/updater.conf"
STATUS_URL="http://127.0.0.1:5000/system/status"
INSTALLER="/usr/local/sbin/initiativetracker-install-update"

log()
{
    printf '[InitiativeTracker updater] %s\n' "$*" >&2
}

fetch_source()
{
    local source="$1"
    local destination="$2"

    if [[ "$source" == https://* ]]; then
        curl \
            --fail \
            --silent \
            --show-error \
            --location \
            --connect-timeout 5 \
            --max-time 15 \
            "$source" \
            --output "$destination"
        return
    fi

    if [[ "$source" == http://* ]]; then
        if [[ "${ALLOW_INSECURE_HTTP:-false}" != "true" ]]; then
            return 1
        fi

        curl \
            --fail \
            --silent \
            --show-error \
            --location \
            --connect-timeout 5 \
            --max-time 15 \
            "$source" \
            --output "$destination"
        return
    fi

    if [[ "$source" == file://* ]]; then
        cp -- "${source#file://}" "$destination"
        return
    fi

    cp -- "$source" "$destination"
}

is_newer_version()
{
    local remote_version="$1"
    local current_version="$2"

    python3 - "$remote_version" "$current_version" <<'PY'
import re
import sys

SEMVER = re.compile(
    r"^(0|[1-9]\d*)\."
    r"(0|[1-9]\d*)\."
    r"(0|[1-9]\d*)"
    r"(?:-([0-9A-Za-z.-]+))?"
    r"(?:\+[0-9A-Za-z.-]+)?$"
)

def parse(value):
    match = SEMVER.match(value)
    if not match:
        raise ValueError(value)

    major, minor, patch = map(int, match.group(1, 2, 3))
    prerelease = match.group(4)

    if prerelease is None:
        pre = None
    else:
        pre = prerelease.split(".")

    return major, minor, patch, pre

def compare_identifier(left, right):
    left_numeric = left.isdigit()
    right_numeric = right.isdigit()

    if left_numeric and right_numeric:
        return (int(left) > int(right)) - (int(left) < int(right))

    if left_numeric != right_numeric:
        return -1 if left_numeric else 1

    return (left > right) - (left < right)

def compare(left, right):
    l = parse(left)
    r = parse(right)

    core_left = l[:3]
    core_right = r[:3]

    if core_left != core_right:
        return (core_left > core_right) - (core_left < core_right)

    lp = l[3]
    rp = r[3]

    if lp is None and rp is None:
        return 0

    if lp is None:
        return 1

    if rp is None:
        return -1

    for li, ri in zip(lp, rp):
        result = compare_identifier(li, ri)
        if result:
            return result

    return (len(lp) > len(rp)) - (len(lp) < len(rp))

try:
    sys.exit(0 if compare(sys.argv[1], sys.argv[2]) > 0 else 1)
except ValueError:
    sys.exit(2)
PY
}

if [[ ! -f "$CONFIG_FILE" ]]; then
    log "No updater configuration found. Continuing startup."
    exit 0
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"

MANIFEST_SOURCE="${MANIFEST_SOURCE:-}"

if [[ -z "$MANIFEST_SOURCE" ]]; then
    log "No update source configured. Continuing startup."
    exit 0
fi

work_directory="$(mktemp -d)"
trap 'rm -rf "$work_directory"' EXIT

manifest_path="$work_directory/release-manifest.json"

if ! fetch_source \
        "$MANIFEST_SOURCE" \
        "$manifest_path"; then
    log "Update source could not be reached. Continuing startup."
    exit 0
fi

mapfile -t manifest_values < <(
    python3 - "$manifest_path" <<'PY'
import json
import re
import sys

path = sys.argv[1]

try:
    with open(path, "r", encoding="utf-8-sig") as handle:
        data = json.load(handle)
except Exception:
    sys.exit(2)

version = str(data.get("version", "")).strip()
product = str(data.get("product", "")).strip()
platform = str(data.get("platform", "")).strip()
notes = data.get("releaseNotes", [])

semver = re.compile(
    r"^(0|[1-9]\d*)\."
    r"(0|[1-9]\d*)\."
    r"(0|[1-9]\d*)"
    r"(?:-[0-9A-Za-z.-]+)?"
    r"(?:\+[0-9A-Za-z.-]+)?$"
)

if (
    product != "InitiativeTracker"
    or platform != "linux-arm64"
    or not semver.fullmatch(version)
):
    sys.exit(3)

if not isinstance(notes, list):
    notes = []

safe_notes = []
for note in notes[:8]:
    text = str(note).replace("\r", " ").replace("\n", " ").strip()
    if text:
        safe_notes.append(text[:300])

print(version)
print("\n".join(f"• {note}" for note in safe_notes))
PY
)

if [[ ${#manifest_values[@]} -lt 1 ]]; then
    log "Remote manifest is invalid. Continuing startup."
    exit 0
fi

remote_version="${manifest_values[0]}"
release_notes="${manifest_values[1]:-}"

status_json="$(
    curl \
        --fail \
        --silent \
        --connect-timeout 2 \
        --max-time 5 \
        "$STATUS_URL" \
        2>/dev/null ||
    true
)"

current_version="$(
    printf '%s' "$status_json" |
        python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
    print(str(data.get("version", "")).strip())
except Exception:
    print("")
'
)"

if [[ -z "$current_version" ]]; then
    current_target="$(
        readlink -f \
            /opt/initiativetracker/current \
            2>/dev/null ||
        true
    )"

    current_name="$(basename "$current_target")"
    current_version="${current_name%-linux-arm64}"
fi

if ! is_newer_version \
        "$remote_version" \
        "$current_version"; then
    log "No newer release found. Current: $current_version."
    exit 0
fi

message="InitiativeTracker ${remote_version} is available.

Current version: ${current_version}"

if [[ -n "$release_notes" ]]; then
    message="${message}

${release_notes}"
fi

install_update=false

case "${INITIATIVETRACKER_UPDATE_MODE:-prompt}" in
    install)
        install_update=true
        ;;

    skip)
        install_update=false
        ;;

    *)
        if command -v zenity >/dev/null 2>&1; then
            if zenity \
                --question \
                --title="InitiativeTracker Update" \
                --width=520 \
                --ok-label="Install Update" \
                --cancel-label="Not Now" \
                --text="$message"; then

                install_update=true
            fi
        else
            log "Update $remote_version is available, but zenity is unavailable."
        fi
        ;;
esac

if [[ "$install_update" != "true" ]]; then
    log "Update deferred. Continuing startup."
    exit 0
fi

log_file="$work_directory/install.log"

if sudo -n \
    "$INSTALLER" \
    >"$log_file" 2>&1; then

    log "Update to $remote_version completed."

    if command -v zenity >/dev/null 2>&1; then
        zenity \
            --info \
            --title="InitiativeTracker Updated" \
            --width=420 \
            --text="InitiativeTracker was updated successfully to version ${remote_version}." \
            2>/dev/null ||
        true
    fi

    exit 0
fi

cat "$log_file" >&2

if command -v zenity >/dev/null 2>&1; then
    zenity \
        --error \
        --title="InitiativeTracker Update Failed" \
        --width=520 \
        --text="The update failed. InitiativeTracker attempted to restore the previous release and data backup. The normal hub screen will open next." \
        2>/dev/null ||
    true
fi

exit 0
